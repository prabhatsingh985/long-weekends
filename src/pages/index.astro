      transition: all 0.2s ease;
      cursor: pointer;
      background-color: #18181b;
      border: 1px solid #27272a;
      color: #d4d4d8;
      white-space: nowrap;
      user-select: none;
    }

    .month-tab-btn:hover {
      border-color: #3f3f46;
      color: #ffffff;
    }

    .month-tab-btn.active {
      background-color: #ffffff !important;
      border-color: #ffffff !important;
      color: #09090b !important;
      font-weight: 800 !important;
      border-radius: 12px !important;
      box-shadow: 0 4px 14px rgba(255, 255, 255, 0.25) !important;
    }

    .month-tab-btn.active * {
      color: #09090b !important;
      font-weight: 800 !important;
    }

    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

  <script>
    import { solveVacationPlans, CURRENT_DATE_REF } from "../data/vacation-solver";

    let state = {
      selectedRegion: "ALL",
      workWeek: 5,
      selectedLeaves: 0,
      selectedMonth: "ALL",
      currentPlans: [] as any[],
      sortBy: "efficiency"
    };

    
    function setupThemeToggle() {
      const toggleBtns = document.querySelectorAll('.theme-toggle-btn');
      toggleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          updateThemeIcons();
        });
      });

      function updateThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        document.querySelectorAll('.theme-icon-moon').forEach(el => {
          if (isDark) el.classList.add('hidden'); else el.classList.remove('hidden');
        });
        document.querySelectorAll('.theme-icon-sun').forEach(el => {
          if (isDark) el.classList.remove('hidden'); else el.classList.add('hidden');
        });
      }

      updateThemeIcons();
    }

    function init() {
      setupThemeToggle();

      // Read initial URL parameters (e.g. ?region=USA)
      const params = new URLSearchParams(window.location.search);
      if (params.has("region")) {
        const r = params.get("region");
        if (r && ["ALL", "USA", "SOUTH", "WEST", "NORTH", "EAST"].includes(r)) {
          state.selectedRegion = r;
          const regionSelect = document.getElementById("navRegionSelector") as HTMLSelectElement;
          if (regionSelect) {
            regionSelect.value = r;
          }
          const flag = document.getElementById("brandFlag");
          if (flag) {
            flag.textContent = r === "USA" ? "🇺🇸" : "🇮🇳";
          }
        }
      }
      if (params.has("leaves")) {
        const l = parseInt(params.get("leaves") || "0", 10);
        if (!isNaN(l)) state.selectedLeaves = l;
      }
      if (params.has("month")) {
        const m = params.get("month");
        if (m) state.selectedMonth = m;
      }

      bindEvents();
      render();
    }

    function formatDateRange(startStr: string, endStr: string) {
      const s = new Date(startStr + "T00:00:00");
      const e = new Date(endStr + "T00:00:00");
      return s.toLocaleDateString("en-IN", { day: "numeric", month: "short" }) + " – " + e.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
    }

    function renderMonthGrid(year: number, monthIndex: number, daysMap: Map<string, any>) {
      const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
      const firstDay = new Date(year, monthIndex, 1).getDay();
      const daysInMonth = new Date(year, monthIndex + 1, 0).getDate();
      const monOffset = (firstDay + 6) % 7;
      const monthTitle = `${monthNames[monthIndex]} ${year}`;

      let cellsHtml = "";
      for (let i = 0; i < monOffset; i++) {
        cellsHtml += `<div class="h-8"></div>`;
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const mm = String(monthIndex + 1).padStart(2, "0");
        const dd = String(d).padStart(2, "0");
        const iso = `${year}-${mm}-${dd}`;
        const dayOfWeek = new Date(year, monthIndex, d).getDay();
        const isNormalWeekend = dayOfWeek === 0 || dayOfWeek === 6;

        let cellStyle = "text-zinc-500 bg-transparent";
        let dotHtml = "";
        let tooltipText = "";

        if (daysMap.has(iso)) {
          const item = daysMap.get(iso);
          if (item.type === "holiday") {
            cellStyle = "bg-emerald-600/90 text-white font-extrabold border border-emerald-400/50 shadow-md ring-2 ring-emerald-500/30";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-200 inline-block mt-0.5"></span>';
            tooltipText = item.label || "Gazetted Public Holiday";
          } else if (item.type === "leave") {
            cellStyle = "bg-amber-600/90 text-white font-extrabold border border-amber-400/50 shadow-md ring-2 ring-amber-500/30";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-amber-200 inline-block mt-0.5"></span>';
            tooltipText = "Apply PTO Leave";
          } else if (item.type === "weekend") {
            cellStyle = "bg-indigo-600/90 text-white font-extrabold border border-indigo-400/50 shadow-md";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-indigo-200 inline-block mt-0.5"></span>';
            tooltipText = "Weekly Weekend Off";
          }
        } else if (isNormalWeekend) {
          cellStyle = "text-zinc-400 bg-zinc-900/60 border border-zinc-800/80 font-medium";
        }

        cellsHtml += `
          <div class="h-8 rounded-lg flex flex-col items-center justify-center text-xs transition-all relative group/calcell select-none ${cellStyle}">
            <span>${d}</span>
            ${dotHtml}
            ${tooltipText ? `
              <div class="hidden group-hover/calcell:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-zinc-900 text-white text-[10px] font-medium rounded-lg shadow-xl whitespace-nowrap z-30 pointer-events-none border border-zinc-700">
                ${tooltipText}
              </div>
            ` : ""}
          </div>
        `;
      }

      return `
        <div class="bg-zinc-900/90 border border-zinc-800 rounded-xl p-4 shadow-md">
          <div class="text-xs font-extrabold text-white text-center mb-3 tracking-tight pb-2 border-b border-zinc-800/80">
            ${monthTitle}
          </div>
          <div class="grid grid-cols-7 gap-1 text-center mb-1 text-[10px] font-mono font-bold text-zinc-500 uppercase">
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span class="text-rose-400">Sat</span><span class="text-rose-400">Sun</span>
          </div>
          <div class="grid grid-cols-7 gap-1">
            ${cellsHtml}
          </div>
        </div>
      `;
    }

    function bindEvents() {
      // Hero Region Popover Trigger
      const regionTrigger = document.getElementById("heroRegionTrigger");
      const regionPopover = document.getElementById("heroRegionPopover");
      const regionArrow = document.getElementById("heroRegionArrow");

      if (regionTrigger && regionPopover) {
        regionTrigger.addEventListener("click", (e) => {
          e.stopPropagation();
          const isHidden = regionPopover.classList.contains("hidden");
          budgetPopover?.classList.add("hidden"); // close other popover
          if (isHidden) {
            regionPopover.classList.remove("hidden");
            if (regionArrow) regionArrow.style.transform = "rotate(180deg)";
          } else {
            regionPopover.classList.add("hidden");
            if (regionArrow) regionArrow.style.transform = "rotate(0deg)";
          }
        });
      }

      // Hero Budget Popover Trigger
      const budgetTrigger = document.getElementById("heroBudgetTrigger");
      const budgetPopover = document.getElementById("heroBudgetPopover");
      const budgetArrow = document.getElementById("heroBudgetArrow");

      if (budgetTrigger && budgetPopover) {
        budgetTrigger.addEventListener("click", (e) => {
          e.stopPropagation();
          const isHidden = budgetPopover.classList.contains("hidden");
          regionPopover?.classList.add("hidden"); // close other popover
          if (isHidden) {
            budgetPopover.classList.remove("hidden");
            if (budgetArrow) budgetArrow.style.transform = "rotate(180deg)";
          } else {
            budgetPopover.classList.add("hidden");
            if (budgetArrow) budgetArrow.style.transform = "rotate(0deg)";
          }
        });
      }

      // Sort Dropdown Toggle & Binding
      const sortBtn = document.getElementById("sortDropdownBtn");
      const sortMenu = document.getElementById("sortDropdownMenu");
      const sortArrow = document.getElementById("sortDropdownArrow");
      const sortLabel = document.getElementById("sortDropdownLabel");

      if (sortBtn && sortMenu) {
        sortBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const isOpen = !sortMenu.classList.contains("opacity-0");
          if (isOpen) {
            sortMenu.classList.add("opacity-0", "scale-95", "pointer-events-none");
            if (sortArrow) sortArrow.style.transform = "rotate(0deg)";
          } else {
            sortMenu.classList.remove("opacity-0", "scale-95", "pointer-events-none");
            if (sortArrow) sortArrow.style.transform = "rotate(180deg)";
          }
        });

        document.querySelectorAll(".sort-option").forEach((opt) => {
          opt.addEventListener("click", (e) => {
            e.stopPropagation();
            const val = (opt as HTMLElement).dataset.value || "efficiency";
            state.sortBy = val;
            
            if (sortLabel) {
              sortLabel.textContent = val === "efficiency" ? "Sort: Highest Efficiency" : "Sort: Chronological (Dates)";
            }

            document.querySelectorAll(".sort-option").forEach((o) => {
              const icon = o.querySelector(".check-icon");
              if ((o as HTMLElement).dataset.value === val) {
                icon?.classList.remove("hidden");
              } else {
                icon?.classList.add("hidden");
              }
            });

            sortMenu.classList.add("opacity-0", "scale-95", "pointer-events-none");
            if (sortArrow) sortArrow.style.transform = "rotate(0deg)";
            render();
          });
        });
      }

      // Close popovers on click outside
      document.addEventListener("click", () => {
        regionPopover?.classList.add("hidden");
        budgetPopover?.classList.add("hidden");
        sortMenu?.classList.add("opacity-0", "scale-95", "pointer-events-none");
        if (regionArrow) regionArrow.style.transform = "rotate(0deg)";
        if (budgetArrow) budgetArrow.style.transform = "rotate(0deg)";
        if (sortArrow) sortArrow.style.transform = "rotate(0deg)";
      });

      // Dismiss popovers on scroll
      window.addEventListener("scroll", () => {
        if (!regionPopover?.classList.contains("hidden")) {
          regionPopover?.classList.add("hidden");
          if (regionArrow) regionArrow.style.transform = "rotate(0deg)";
        }
        if (!budgetPopover?.classList.contains("hidden")) {
          budgetPopover?.classList.add("hidden");
          if (budgetArrow) budgetArrow.style.transform = "rotate(0deg)";
        }
        if (!sortMenu?.classList.contains("opacity-0")) {
          sortMenu?.classList.add("opacity-0", "scale-95", "pointer-events-none");
          if (sortArrow) sortArrow.style.transform = "rotate(0deg)";
        }
      });

      // Region Popover Options
      document.querySelectorAll(".hero-popover-option").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const reg = (btn as HTMLElement).dataset.region || "ALL";
          state.selectedRegion = reg;
          regionPopover?.classList.add("hidden");
          if (regionArrow) regionArrow.style.transform = "rotate(0deg)";
          
          const navSelect = document.getElementById("navRegionSelector") as HTMLSelectElement;
          if (navSelect) navSelect.value = reg;
          const flag = document.getElementById("brandFlag");
          if (flag) flag.textContent = reg === "USA" ? "🇺🇸" : "🇮🇳";
          const disp = document.getElementById("heroRegionDisplay");
          if (disp) disp.textContent = reg === "USA" ? "United States (US Federal)" : "India (Public & IT)";
          render();
        });
      });

      // Budget Popover Options
      document.querySelectorAll(".hero-budget-option").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const leaves = parseInt((btn as HTMLElement).dataset.leaves || "0", 10);
          state.selectedLeaves = leaves;
          budgetPopover?.classList.add("hidden");
          if (budgetArrow) budgetArrow.style.transform = "rotate(0deg)";
          
          const disp = document.getElementById("heroBudgetDisplay");
          if (disp) {
            const labels = ["0 Leaves (Free)", "1 Leave", "2 Leaves", "3+ Leaves"];
            disp.textContent = labels[leaves] || `${leaves} Leaves`;
          }
          updateActiveUI();
        });
      });

      // Scroll Action Search Button
      const searchActionBtn = document.getElementById("heroSearchActionBtn");
      const quickSearchBtn = document.getElementById("quickSearchBtn");
      const scrollToGrid = () => {
        document.getElementById("vacationGrid")?.scrollIntoView({ behavior: "smooth", block: "start" });
      };
      if (searchActionBtn) searchActionBtn.addEventListener("click", scrollToGrid);
      if (quickSearchBtn) quickSearchBtn.addEventListener("click", scrollToGrid);

      // Nav Region select handler
      const regionSelect = document.getElementById("navRegionSelector") as HTMLSelectElement;
      const btn5Day = document.getElementById("btnWorkweek5");
      const btn6Day = document.getElementById("btnWorkweek6");

      if (regionSelect) {
        regionSelect.addEventListener("change", (e) => {
          const val = (e.target as HTMLSelectElement).value;
          state.selectedRegion = val;
          const flag = document.getElementById("brandFlag");
          if (flag) flag.textContent = val === "USA" ? "🇺🇸" : "🇮🇳";
          const disp = document.getElementById("heroRegionDisplay");
          if (disp) disp.textContent = val === "USA" ? "United States (US Federal)" : "India (Public & IT)";
          render();
        });
      }

      if (btn5Day && btn6Day) {
        btn5Day.addEventListener("click", () => {
          btn5Day.className = "px-2.5 py-0.5 text-[11px] font-bold rounded-full transition-all bg-white text-zinc-950 shadow-xs cursor-pointer";
          btn6Day.className = "px-2.5 py-0.5 text-[11px] font-medium rounded-full transition-all text-zinc-400 hover:text-white cursor-pointer";
          state.workWeek = 5;
          render();
        });
        btn6Day.addEventListener("click", () => {
          btn6Day.className = "px-2.5 py-0.5 text-[11px] font-bold rounded-full transition-all bg-white text-zinc-950 shadow-xs cursor-pointer";
          btn5Day.className = "px-2.5 py-0.5 text-[11px] font-medium rounded-full transition-all text-zinc-400 hover:text-white cursor-pointer";
          state.workWeek = 6;
          render();
        });
      }

      document.querySelectorAll(".chip-btn").forEach((chip) => {
        chip.addEventListener("click", () => {
          const leaves = parseInt((chip as HTMLElement).dataset.leaves || "0", 10);
          state.selectedLeaves = leaves;
          updateActiveUI();
        });
      });

      document.querySelectorAll(".month-tab-btn").forEach((tab) => {
        tab.addEventListener("click", () => {
          state.selectedMonth = (tab as HTMLElement).dataset.month || "ALL";
          updateActiveUI();
        });
      });

      // Calendar Modal bindings
      const calModal = document.getElementById("calendarModal");
      const btnCloseCal = document.getElementById("btnCloseCalendarModal");
      if (calModal && btnCloseCal) {
        btnCloseCal.addEventListener("click", () => calModal.classList.add("hidden"));
        calModal.addEventListener("click", (e) => {
          if (e.target === calModal) calModal.classList.add("hidden");
        });
      }

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          if (calModal) calModal.classList.add("hidden");
          regionPopover?.classList.add("hidden");
          budgetPopover?.classList.add("hidden");
          sortMenu?.classList.add("opacity-0", "scale-95", "pointer-events-none");
        }
      });
    }

    function updateActiveUI() {
      document.querySelectorAll(".chip-btn").forEach((c) => c.classList.remove("active"));
      
      const budgetVal = Math.min(state.selectedLeaves, 3);
      const matchingChip = document.querySelector(`.chip-btn[data-leaves="${budgetVal}"]`);
      if (matchingChip) matchingChip.classList.add("active");

      // Sync Hero Budget Display text & selected popover item
      const heroBudgetDisp = document.getElementById("heroBudgetDisplay");
      if (heroBudgetDisp) {
        const labels = ["0 Leaves (Free)", "1 Leave", "2 Leaves", "3+ Leaves"];
        heroBudgetDisp.textContent = labels[budgetVal] || `${budgetVal} Leaves`;
      }
      document.querySelectorAll(".hero-budget-option").forEach((opt) => {
        const l = parseInt((opt as HTMLElement).dataset.leaves || "0", 10);
        if (l === budgetVal) {
          opt.className = "w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-[#ff2b63]/15 border border-[#ff2b63]/40 text-white font-bold transition-all cursor-pointer hero-budget-option";
        } else {
          opt.className = "w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl border border-transparent hover:border-zinc-700 hover:bg-zinc-800/80 transition-all group cursor-pointer hero-budget-option";
        }
      });

      // Sync Hero Region Display text & selected popover item
      const heroRegionDisp = document.getElementById("heroRegionDisplay");
      if (heroRegionDisp) {
        heroRegionDisp.textContent = state.selectedRegion === "USA" ? "United States (US Federal)" : "India (Public & IT)";
      }
      document.querySelectorAll(".hero-popover-option").forEach((opt) => {
        const r = (opt as HTMLElement).dataset.region || "ALL";
        if (r === state.selectedRegion) {
          opt.className = "w-full text-left flex items-center gap-3 px-3.5 py-3 rounded-xl bg-[#ff2b63]/15 border border-[#ff2b63]/40 text-white font-bold transition-all cursor-pointer hero-popover-option";
        } else {
          opt.className = "w-full text-left flex items-center gap-3 px-3.5 py-3 rounded-xl border border-transparent hover:border-zinc-700 hover:bg-zinc-800/80 transition-all group cursor-pointer hero-popover-option";
        }
      });

      document.querySelectorAll(".month-tab-btn").forEach((m) => m.classList.remove("active"));
      const matchingMonth = document.querySelector(`.month-tab-btn[data-month="${state.selectedMonth}"]`);
      if (matchingMonth) matchingMonth.classList.add("active");

      render();
    }

    function openCalendarModal(plan: any) {
      const modal = document.getElementById("calendarModal");
      const mTitle = document.getElementById("calModalTitle");
      const mDates = document.getElementById("calModalDates");
      const mContent = document.getElementById("calModalContent");

      if (!modal || !mTitle || !mDates || !mContent) return;

      mTitle.textContent = plan.title;
      mDates.textContent = `🗓️ ${formatDateRange(plan.startDate, plan.endDate)} · ${plan.totalDaysOff} Consecutive Days Off`;

      const daysMap = new Map();
      plan.days.forEach((d: any) => daysMap.set(d.date, d));

      const startD = new Date(plan.startDate + "T00:00:00");
      const endD = new Date(plan.endDate + "T00:00:00");

      const startY = startD.getFullYear();
      const startM = startD.getMonth();
      const endY = endD.getFullYear();
      const endM = endD.getMonth();

      let calendarsHtml = "";
      if (startY === endY && startM === endM) {
        mContent.className = "grid grid-cols-1 max-w-sm mx-auto w-full gap-4 mb-6";
        calendarsHtml = renderMonthGrid(startY, startM, daysMap);
      } else {
        mContent.className = "grid grid-cols-1 md:grid-cols-2 gap-4 mb-6";
        calendarsHtml = renderMonthGrid(startY, startM, daysMap) + renderMonthGrid(endY, endM, daysMap);
      }

      mContent.innerHTML = calendarsHtml;
      modal.classList.remove("hidden");
    }

    function render() {
      const grid = document.getElementById("vacationGrid");
      const empty = document.getElementById("emptyState");
      const badge = document.getElementById("resultsBadge");
      const subtext = document.getElementById("resultsSubtext");

      const plans = solveVacationPlans({
        leaves: state.selectedLeaves,
        workWeek: state.workWeek,
        region: state.selectedRegion as any,
        month: state.selectedMonth,
        fromDate: CURRENT_DATE_REF
      });

      if (state.sortBy === "efficiency") {
        plans.sort((a, b) => {
          if (b.totalDaysOff !== a.totalDaysOff) return b.totalDaysOff - a.totalDaysOff;
          return a.startDate.localeCompare(b.startDate);
        });
      } else {
        plans.sort((a, b) => a.startDate.localeCompare(b.startDate));
      }
      state.currentPlans = plans;

      if (badge) badge.textContent = plans.length + (plans.length === 1 ? " Plan" : " Plans");
      if (subtext) subtext.textContent = "Showing options with " + state.selectedLeaves + (state.selectedLeaves === 1 ? " leave" : " leaves") + " (Min 3 days continuous off)";

      if (!grid || !empty) return;

      if (plans.length === 0) {
        grid.innerHTML = "";
        empty.classList.remove("hidden");
        return;
      }

      empty.classList.add("hidden");

      grid.innerHTML = plans.map((plan, planIdx) => {
        const pillsHtml = plan.days.map((d) => {
          if (d.type === "holiday") {
            return `
              <div class="flex-1 min-w-[54px] rounded-xl py-2 px-2 flex flex-col items-center justify-center text-center transition-all bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/30 group/day relative cursor-default select-none">
                <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-emerald-400">${d.dayName}</span>
                <span class="text-xs font-extrabold font-mono text-white mt-0.5">${d.dayNum}</span>
                <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 mt-1 truncate max-w-full">Holiday</span>
                <div class="hidden group-hover/day:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-zinc-900 text-white text-[10px] font-medium rounded-lg shadow-xl whitespace-nowrap z-30 pointer-events-none border border-zinc-700">
                  ${d.label || "Gazetted Public Holiday"}
                </div>
              </div>
            `;
          } else if (d.type === "weekend") {
            return `
              <div class="flex-1 min-w-[54px] rounded-xl py-2 px-2 flex flex-col items-center justify-center text-center transition-all bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-300 border border-indigo-500/30 group/day relative cursor-default select-none">
                <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-indigo-400">${d.dayName}</span>
                <span class="text-xs font-extrabold font-mono text-white mt-0.5">${d.dayNum}</span>
                <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 mt-1">Weekend</span>
                <div class="hidden group-hover/day:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-zinc-900 text-white text-[10px] font-medium rounded-lg shadow-xl whitespace-nowrap z-30 pointer-events-none border border-zinc-700">
                  Weekly Weekend Off
                </div>
              </div>
            `;
          } else {
            return `
              <div class="flex-1 min-w-[54px] rounded-xl py-2 px-2 flex flex-col items-center justify-center text-center transition-all bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/30 group/day relative cursor-default select-none">
                <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-amber-400">${d.dayName}</span>
                <span class="text-xs font-extrabold font-mono text-white mt-0.5">${d.dayNum}</span>
                <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full bg-amber-500/30 text-amber-200 mt-1 font-bold">Take PTO</span>
                <div class="hidden group-hover/day:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-zinc-900 text-white text-[10px] font-medium rounded-lg shadow-xl whitespace-nowrap z-30 pointer-events-none border border-zinc-700">
                  Apply 1 Day Leave (PTO)
                </div>
              </div>
            `;
          }
        }).join("");

        const topBadge = plan.leavesRequired === 0
          ? `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">⚡ 0 Leaves Needed</span>`
          : `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-amber-500/15 text-amber-400 border border-amber-500/30">🎯 ${plan.leavesRequired} ${plan.leavesRequired === 1 ? "Leave" : "Leaves"} Needed (${plan.efficiencyMultiplier})</span>`;

        let bottomBarHtml = "";
        if (plan.leavesRequired === 0) {
          bottomBarHtml = `
            <div class="bg-emerald-950/40 border border-emerald-500/30 rounded-xl p-3 flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-emerald-500 text-zinc-950 flex items-center justify-center text-[10px] font-extrabold shrink-0">✓</span>
              <div class="text-xs font-medium text-emerald-200">
                <span class="font-bold text-white">Direct Weekend Bridge</span> · No PTO required
              </div>
            </div>
          `;
        } else {
          const leaveDays = plan.days.filter(d => d.type === "leave").map(d => `${d.dayName} ${d.dayNum}`).join(", ");
          bottomBarHtml = `
            <div class="bg-amber-950/40 border border-amber-500/30 rounded-xl p-3 flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-amber-500 text-zinc-950 flex items-center justify-center text-[10px] font-extrabold shrink-0">🎯</span>
              <div class="text-xs font-medium text-amber-200">
                <span class="font-bold text-white">Apply PTO:</span> <span class="underline decoration-amber-400 font-bold">${leaveDays}</span>
              </div>
            </div>
          `;
        }

        return `
          <div class="bg-gradient-to-b from-[#141417] to-[#0f0f12] border border-zinc-800/90 hover:border-[#ff2b63]/50 rounded-2xl p-5 shadow-xl hover:shadow-2xl hover:shadow-rose-950/20 transition-all duration-300 flex flex-col justify-between gap-4 group relative">
            <div>
              <!-- Top Bar -->
              <div class="flex items-center justify-between gap-2 mb-3">
                ${topBadge}
                
                <div class="flex items-center gap-2">
                  <span class="days-off-badge inline-flex items-center gap-1.5 text-xs font-extrabold text-[#ff2b63] bg-rose-500/10 border border-rose-500/30 px-3 py-1 rounded-full shadow-sm">
                    🔥 ${plan.totalDaysOff} Days Off
                  </span>
                  <button 
                    type="button" 
                    class="btn-open-cal w-8 h-8 rounded-full text-xs font-bold text-zinc-300 bg-zinc-800/80 hover:bg-[#ff2b63] hover:text-white border border-zinc-700/60 hover:border-[#ff2b63] transition-all flex items-center justify-center cursor-pointer hover:scale-105 active:scale-95 shadow-sm" 
                    title="View Month Calendar Grid"
                    data-idx="${planIdx}"
                  >
                    🗓️
                  </button>
                </div>
              </div>

              <!-- Main Details -->
              <h3 class="font-extrabold text-base sm:text-lg text-white tracking-tight mb-1 group-hover:text-[#ff2b63] transition-colors leading-snug">
                ${plan.title}
              </h3>
              <div class="text-xs font-semibold text-zinc-400 flex items-center gap-1.5 mb-3">
                <span>🗓️</span>
                <span class="font-bold text-zinc-200">${formatDateRange(plan.startDate, plan.endDate)}</span>
              </div>

              <!-- Interactive Day-by-Day Ribbon -->
              <div class="flex w-full gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden py-1">
                ${pillsHtml}
              </div>
            </div>

            <!-- Actionable Bottom Bar -->
            <div>
              ${bottomBarHtml}
            </div>
          </div>
        `;
      }).join("");

      // Bind calendar view modal triggers
      document.querySelectorAll(".btn-open-cal").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const idx = parseInt((btn as HTMLElement).dataset.idx || "0", 10);
          const selectedPlan = state.currentPlans[idx];
          if (selectedPlan) {
            openCalendarModal(selectedPlan);
          }
        });
      });
    }

    document.addEventListener("DOMContentLoaded", init);
  </script>
</body>
</html>
