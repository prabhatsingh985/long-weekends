---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Next Long Weekend 2026 – Leave Calculator India | The Long Weekends</title>
  <meta name="description" content="Find the next long weekend in 2026 and calculate exact leaves needed to turn holidays into vacations. Plan smarter PTO for every upcoming long weekend." />
  
  <!-- SEO & Open Graph Tags -->
  <link rel="canonical" href="https://thelongweekends.com/" />
  <meta property="og:title" content="Next Long Weekend 2026 – Leave Calculator India | The Long Weekends" />
  <meta property="og:description" content="Find the next long weekend in 2026 and calculate exact leaves needed to turn holidays into vacations. Plan smarter PTO for every upcoming long weekend." />
  <meta property="og:url" content="https://thelongweekends.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Long Weekends" />
  <meta property="og:image" content="https://thelongweekends.com/og-image.png" />
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Next Long Weekend 2026 – Leave Calculator India | The Long Weekends" />
  <meta name="twitter:description" content="Find the next long weekend in 2026 and calculate exact leaves needed to turn holidays into vacations. Plan smarter PTO for every upcoming long weekend." />
  <meta name="twitter:image" content="https://thelongweekends.com/og-image.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />

  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>


  <!-- FAQ Schema (JSON-LD for rich snippets) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "When is the next long weekend in 2026?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The next long weekend depends on today's date. Our tool automatically identifies the nearest upcoming long weekend based on India's gazetted holidays and your weekend schedule. Visit thelongweekends.com to see the exact dates and how many leaves you need."
        }
      },
      {
        "@type": "Question",
        "name": "How many long weekends are there in 2026?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "India has approximately 10–15 long weekend opportunities in 2026 for a standard 5-day work week, depending on your region. With just 1–3 PTO days, many of these can be extended into 4–9 day breaks."
        }
      },
      {
        "@type": "Question",
        "name": "How does the long weekend calculator work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Select your leave budget (0, 1, 2, or 3+ days), your region, and work-week type. The calculator cross-references gazetted public holidays with your weekends to find every possible bridge opportunity, ranked by efficiency — so you get the most days off for the fewest leaves used."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use this tool for my company's holiday list?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Visit the Company Holiday Optimizer page and upload your office holiday PDF, image, or paste the text directly. The tool extracts your company-specific holidays and generates a fully personalized long weekend plan."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need to create an account to use this tool?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. The Long Weekends is completely free and requires no sign-up. All calculations happen instantly in your browser — no data is stored or sent to any server."
        }
      }
    ]
  }
  </script>

</head>
<body class="bg-[#fafafa] text-[#171717] font-sans antialiased min-h-screen flex flex-col">

  <Navbar />
  <Hero />

  <!-- Interactive Filter Bar (Exact Favorite Layout) -->
  <section class="py-3 px-4 sm:px-6 bg-white border-b border-[#ebebeb] shadow-xs">
    <div class="max-w-[1200px] mx-auto">
      
            <!-- Filter Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-2">
        <div class="flex items-center gap-2">
          <span class="text-base">🎯</span>
          <span class="font-bold text-sm text-[#171717]">Select Your Leave Budget</span>
        </div>
        
        <!-- Month Tabs (Moved to Header Row) -->
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar" id="monthTabsContainer">
          <button type="button" class="month-tab-btn active" data-month="ALL">All</button>
          <button type="button" class="month-tab-btn" data-month="08">Aug</button>
          <button type="button" class="month-tab-btn" data-month="09">Sep</button>
          <button type="button" class="month-tab-btn" data-month="10">Oct</button>
          <button type="button" class="month-tab-btn" data-month="11">Nov</button>
          <button type="button" class="month-tab-btn" data-month="12">Dec</button>
        </div>
      </div>

      <!-- 5 Leave Budget Chips -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-4" id="budgetChipsContainer">
        <button type="button" class="chip-btn active" data-leaves="0">
          <span class="chip-title">0 Leaves</span>
          <span class="chip-desc">Free 3-Day Breaks</span>
        </button>
        <button type="button" class="chip-btn" data-leaves="1">
          <span class="chip-title">1 Leave</span>
          <span class="chip-desc">Smart 4-Day Bridge</span>
        </button>
        <button type="button" class="chip-btn" data-leaves="2">
          <span class="chip-title">2 Leaves</span>
          <span class="chip-desc">5-6 Day Vacations</span>
        </button>
        <button type="button" class="chip-btn" data-leaves="3">
          <span class="chip-title">3 Leaves</span>
          <span class="chip-desc">6+ Day Festival</span>
        </button>
        
        <!-- Custom Stepper Chip -->
        <div class="chip-btn custom-chip" id="customChipWrapper">
          <div class="flex items-center justify-between w-full">
            <span class="chip-title">Custom</span>
            <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-700 border border-amber-500/20">4+ PTO</span>
          </div>
          <div class="stepper-box flex items-center justify-between w-full mt-1 bg-slate-100/90 border border-slate-200/80 rounded-lg px-2 py-0.5 transition-colors">
            <button type="button" id="btnDecLeave" class="stepper-btn font-bold text-xs hover:text-slate-900 cursor-pointer select-none text-slate-600">−</button>
            <span class="stepper-val text-xs font-mono font-bold text-slate-800 select-none"><span id="customLeavesDisplay">4</span> Leaves</span>
            <input type="hidden" id="customLeavesInput" value="4" />
            <button type="button" id="btnIncLeave" class="stepper-btn font-bold text-xs hover:text-slate-900 cursor-pointer select-none text-slate-600">+</button>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Vacation Grid Results -->
  <main class="flex-1 py-8 sm:py-10 px-4 sm:px-6 max-w-[1200px] mx-auto w-full">
    
    <div class="flex items-center justify-between gap-4 mb-6 flex-wrap">
      <div class="flex items-center gap-3">
        <span class="font-mono text-xs font-bold px-3 py-1 bg-slate-900 text-white rounded-full" id="resultsBadge">0 Plans</span>
        <span class="text-xs text-slate-600 font-medium" id="resultsSubtext">Showing options with 0 leaves</span>
        
        <!-- Custom Premium Dropdown -->
        <div class="relative w-full sm:w-[240px]" id="customSortDropdown">
          <button type="button" id="sortDropdownBtn" class="flex items-center justify-between w-full bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 hover:text-slate-900 text-[11px] sm:text-xs font-bold rounded-full px-4 py-2 outline-none focus:border-slate-400 focus:ring-4 focus:ring-slate-100 transition-all shadow-sm">
            <span id="sortDropdownLabel">Sort: Highest Efficiency</span>
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <!-- Menu (Hidden by default) -->
          <div id="sortDropdownMenu" class="absolute right-0 mt-2 w-full bg-white border border-slate-200 rounded-xl shadow-xl overflow-hidden z-50 transition-all duration-200 opacity-0 scale-95 origin-top-right pointer-events-none hidden">
            <div class="py-1 flex flex-col">
              <button type="button" class="sort-option w-full text-left px-4 py-3 text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition-colors flex items-center justify-between" data-value="efficiency">
                Highest Efficiency
                <svg class="w-4 h-4 text-emerald-500 check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              </button>
              <button type="button" class="sort-option w-full text-left px-4 py-3 text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition-colors flex items-center justify-between" data-value="date">
                Chronological (Dates)
                <svg class="w-4 h-4 text-emerald-500 hidden check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div class="results-legend-bar flex items-center gap-4 text-xs text-slate-600 font-medium">
        <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-blue-500"></span><span>Weekend</span></div>
        <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-emerald-500"></span><span>Public Holiday</span></div>
        <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-amber-500"></span><span>Apply Leave (PTO)</span></div>
      </div>
    </div>

    <!-- Live Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="vacationGrid"></div>

    <!-- Empty State -->
    <div class="hidden text-center py-20 px-4 sm:px-6 bg-white border border-slate-200 rounded-2xl shadow-xs" id="emptyState">
      <div class="w-16 h-16 rounded-full bg-slate-50 text-3xl flex items-center justify-center mx-auto mb-4 border border-slate-200">🏖️</div>
      <h3 class="font-bold text-lg text-slate-900 mb-2">No Long Weekend Found for this Budget</h3>
      <p class="text-xs text-slate-500 max-w-md mx-auto">Try selecting another leave budget (e.g. 1, 2, or 3 leaves) or check "All Upcoming" to view all available bridges.</p>
    </div>

  </main>

  <!-- Interactive Calendar View Modal / Popover -->
  <div id="calendarModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-2xl max-w-2xl w-full p-4 sm:p-6 shadow-2xl relative animate-in fade-in zoom-in-95 max-h-[85vh] sm:max-h-[90vh] overflow-y-auto">
      <button type="button" id="btnCloseCalendarModal" class="absolute top-3 right-3 sm:top-4 sm:right-4 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold flex items-center justify-center text-sm cursor-pointer transition-all">✕</button>
      
      <!-- Modal Header -->
      <div class="mb-3 sm:mb-5 pr-6">
        <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-blue-50 text-blue-800 text-[10px] sm:text-[11px] font-bold border border-blue-200 mb-1 sm:mb-1.5">
          <span>🗓️ Month Calendar View</span>
        </div>
        <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-tight" id="calModalTitle">Vacation Calendar</h3>
        <p class="text-[10px] sm:text-xs text-slate-500 mt-0.5 leading-tight" id="calModalDates">Dates</p>
      </div>

      <!-- Calendar Container (Single or Dual Month) -->
      <div id="calModalContent" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-4 sm:mb-6"></div>

      <!-- Compact One-Line Legend -->
      <div class="flex items-center justify-center gap-2 sm:gap-4 py-2 sm:py-2.5 px-2 sm:px-4 bg-slate-50 rounded-xl border border-slate-200 text-[10px] sm:text-xs font-semibold text-slate-700 flex-wrap leading-none">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-emerald-500"></span>
          <span>Public Holiday</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-amber-500"></span>
          <span>Apply PTO</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-blue-500"></span>
          <span>Weekend Off</span>
        </div>
      </div>
    </div>
  </div>

  
  <!-- SEO Content Section — placed below the interactive tool -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 bg-white dark:bg-[#0b0f19] border-t border-slate-200/80 dark:border-slate-800/80 transition-colors">
    <div class="max-w-[850px] mx-auto">

      <!-- Section Intro -->
      <div class="mb-12">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 text-xs font-bold border border-blue-200/60 dark:border-blue-800/60 mb-3">
          🗓️ 2026 Vacation Planner
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
          When Is the Next Long Weekend?
        </h2>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
          If you're wondering <strong>when is the next long weekend</strong>, you're not alone — it's one of the most searched questions by working professionals in India every single month. The answer changes constantly as holidays pass and new ones approach. That's exactly why we built this tool: so you never have to manually check calendars or count days again.
        </p>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          Our calculator automatically identifies the <strong>next long weekend</strong> based on today's date, your selected country (India or United States), and official gazetted public holidays. Whether it's a 3-day break over a regular Saturday–Sunday–Monday or a 9-day mega-vacation that bridges Diwali into a full week off, you'll see every option ranked by efficiency — most days off for the fewest leaves used.
        </p>
      </div>

      <hr class="border-slate-200 dark:border-slate-800/80 my-10" />

      <!-- Upcoming Long Weekends -->
      <div class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
          Upcoming Long Weekends in 2026
        </h2>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
          Both India and the United States offer incredible public holiday calendars in 2026. Whether you're working in India or the US, there are <strong class="text-slate-900 dark:text-white">10–15 long weekend opportunities</strong> on a standard 5-day work week — with even more options when you bridge 1–2 PTO days. Key highlights include:
        </p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 my-6">
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#151f32] border border-slate-200/70 dark:border-slate-800">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">January 2026</span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-200/60 dark:bg-slate-800 text-slate-700 dark:text-slate-300">🇮🇳 & 🇺🇸</span>
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1">Republic Day & MLK Day</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400">Guaranteed 3-day long weekends with 0 leaves required.</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#151f32] border border-slate-200/70 dark:border-slate-800">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-bold uppercase tracking-wider text-pink-600 dark:text-pink-400">Spring 2026</span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-200/60 dark:bg-slate-800 text-slate-700 dark:text-slate-300">🇮🇳 & 🇺🇸</span>
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1">Holi & Good Friday Breaks</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400">3 to 5 day spring getaways with minimal PTO usage.</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#151f32] border border-slate-200/70 dark:border-slate-800">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">May & July 2026</span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-200/60 dark:bg-slate-800 text-slate-700 dark:text-slate-300">🇺🇸 USA</span>
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1">Memorial Day & 4th of July</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400">Classic US summer long weekends over Friday/Monday holidays.</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#151f32] border border-slate-200/70 dark:border-slate-800">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">August & Sept 2026</span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-200/60 dark:bg-slate-800 text-slate-700 dark:text-slate-300">🇮🇳 & 🇺🇸</span>
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1">Independence Day & Labor Day</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400">Late summer 3-day and mid-week bridge opportunities.</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#151f32] border border-slate-200/70 dark:border-slate-800">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">Nov 2026</span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-200/60 dark:bg-slate-800 text-slate-700 dark:text-slate-300">🇺🇸 USA</span>
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1">Thanksgiving & Black Friday</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400">4-day long weekend taking just 1 day PTO on Black Friday.</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#151f32] border border-slate-200/70 dark:border-slate-800">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-bold uppercase tracking-wider text-red-600 dark:text-red-400">Oct – Dec 2026</span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-200/60 dark:bg-slate-800 text-slate-700 dark:text-slate-300">🇮🇳 & 🇺🇸</span>
            </div>
            <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1">Diwali & Christmas Getaways</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400">The grand year-end holiday sweeps to recharge for 2027.</p>
          </div>
        </div>

        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          Use the country selector and leave-budget options above to filter by your location and available PTO, and instantly see every <strong>upcoming long weekend</strong> customized for you.
        </p>
      </div>

      <hr class="border-slate-200 dark:border-slate-800/80 my-10" />

      <!-- How It Works -->
      <div class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
          How the Long Weekend Calculator Works
        </h2>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          The Long Weekends is a free, no-sign-up tool designed specifically for Indian corporate professionals. Here's how to maximize your leave balance:
        </p>
        <div class="space-y-3">
          <div class="flex items-start gap-3.5 p-4 rounded-xl bg-slate-50 dark:bg-[#151f32] border border-slate-200/70 dark:border-slate-800">
            <span class="w-7 h-7 rounded-lg bg-blue-600 text-white font-mono font-extrabold text-xs flex items-center justify-center shrink-0 mt-0.5">1</span>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm">Select your leave budget</h4>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Choose 0, 1, 2, 3, or a custom number of PTO days you're willing to use per trip.</p>
            </div>
          </div>
          <div class="flex items-start gap-3.5 p-4 rounded-xl bg-slate-50 dark:bg-[#151f32] border border-slate-200/70 dark:border-slate-800">
            <span class="w-7 h-7 rounded-lg bg-blue-600 text-white font-mono font-extrabold text-xs flex items-center justify-center shrink-0 mt-0.5">2</span>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm">Pick your region & work week</h4>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Select India (Pan-India IT) or United States (US Federal), and toggle 5-day or 6-day work weeks.</p>
            </div>
          </div>
          <div class="flex items-start gap-3.5 p-4 rounded-xl bg-slate-50 dark:bg-[#151f32] border border-slate-200/70 dark:border-slate-800">
            <span class="w-7 h-7 rounded-lg bg-blue-600 text-white font-mono font-extrabold text-xs flex items-center justify-center shrink-0 mt-0.5">3</span>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-sm">Browse your visual results</h4>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Every option shows exact dates, public holidays, and weekend bridges ranked by efficiency.</p>
            </div>
          </div>
        </div>
      </div>

      <hr class="border-slate-200 dark:border-slate-800/80 my-10" />

      <!-- Why Long Weekends Matter -->
      <div class="mb-16">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
          Why Long Weekends Matter for Indian Professionals
