---
/**
 * Homepage: hero search, filter rail, results grid, calendar dialog, SEO prose.
 *
 * Rewritten onto Layout.astro. This page used to carry its own <html>, its own
 * copy of the font links and theme-init script, a second theme-toggle binding
 * that cancelled out the navbar's one, and ~125 lines of `!important` chip CSS
 * that duplicated (and contradicted) rules already in global.css.
 */
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import { getUpcomingCutoffIso, solveVacationPlans } from "../data/vacation-solver";
import { escapeHtml, formatDateRange, getBannerTheme, nextBreaks, pluralLeaves } from "../scripts/plan-view";

const TITLE =
  "Next Long Weekend 2026 – Leave Calculator India | The Long Weekends";
const DESCRIPTION =
  "Find the next long weekend in 2026 and calculate exact leaves needed to turn holidays into vacations. Plan smarter PTO for every upcoming long weekend.";

/**
 * Server-rendered highlights.
 *
 * This section used to be six hand-written cards naming January 2026 as
 * "upcoming" — copy that went stale the moment January passed and that a
 * crawler read as the page's only real content, since the results grid is
 * rendered on the client. Deriving it from the solver makes it both accurate
 * and crawlable.
 *
 * What is rendered here is the India list as of build time, which is what a
 * crawler should see. It is not what a visitor should see: `buildCutoff` is
 * frozen at build, and the region is a guess. renderHighlights() in the client
 * script re-solves both from the visitor's own clock and region and replaces
 * these rows — see the note there.
 */
const buildCutoff = getUpcomingCutoffIso();
const highlights = nextBreaks((leaves) =>
  solveVacationPlans({ leaves, workWeek: 5, region: "ALL", fromDate: buildCutoff })
);

/**
 * The next break, named once.
 *
 * `highlights[0]` is deliberately reused rather than re-derived: nextBreaks()
 * already answers "what is coming up", and the hero badge reads the same array.
 * A second heuristic here is exactly how the badge and the FAQ came to name two
 * different festivals on the same page before.
 */
const nextUp = highlights[0];

/**
 * Q1's answer is generated, not written.
 *
 * "When is the next long weekend?" is the highest-volume query this page can
 * answer, and it is the one answer that cannot be hardcoded: a fixed string is
 * wrong the day after the break it names. Composing it from the solver means the
 * visible answer and the JSON-LD both move with the calendar.
 *
 * The build-time value is what a crawler sees. A visitor's own clock and region
 * are applied by renderHighlights() in the client script, which is why the copy
 * points at the badge rather than repeating the date as gospel.
 */
const nextUpAnswer = nextUp
  ? `The next long weekend is <strong>${escapeHtml(nextUp.title)}, ${formatDateRange(
      nextUp.startDate,
      nextUp.endDate
    )}</strong> — ${nextUp.totalDaysOff} days off ${
      nextUp.leavesRequired === 0
        ? "with no leave needed at all"
        : `for ${pluralLeaves(nextUp.leavesRequired)}`
    }. The badge at the top of this page names the same break, recalculated from your own date and region the moment the page loads.`
  : "Every long weekend on the bundled calendar has already passed. The planner keeps working for the year ahead as soon as the holiday data is extended.";

/**
 * One FAQ source feeding both the visible accordion and the JSON-LD.
 *
 * The two must render the same string — Google treats a FAQPage whose markup
 * disagrees with the visible answer as spam — so both read `item.a` and neither
 * gets its own copy of the prose.
 *
 * On the question list: the brief asked for thirteen, five of which were
 * keyword variants of the same question ("when is long weekend", "when is next
 * long weekend", "when is the next long weekend 2026"). Shipping those as
 * separate nodes is counterproductive: near-identical Question entries are
 * treated as duplicate content and can cost the whole FAQPage its rich result.
 * They are consolidated into Q1 (undated, generated) and Q3 (the dated one that
 * enumerates the year), which is what those searches actually want.
 *
 * Every number below is recomputed from the shipped solver by
 * outputs/faq.test.ts. The previous version claimed "roughly 10 to 15 long
 * weekend opportunities" where the real figure is nine, which is the kind of
 * confident wrongness a crawler will happily quote back at people.
 */
const FAQ = [
  {
    q: "When is the next long weekend?",
    a: nextUpAnswer,
  },
  {
    q: "Is this weekend a long weekend?",
    a: "Most weekends are just two days. A weekend becomes a long weekend when a gazetted holiday lands on the Friday or the Monday beside it, or when one leave day bridges the gap to a holiday sitting midweek. The badge at the top of this page names the nearest one and counts the days, so you can tell at a glance whether the weekend in front of you is one of them.",
  },
  {
    q: "When is the next long weekend in 2026?",
    a: "There are nine long weekends in 2026 that cost no leave at all, spread right across the year: 24–26 Jan, 14–16 Feb, 3–5 Apr, 1–3 May, 26–28 Jun, 28–30 Aug, 4–6 Sep, 2–4 Oct and 25–27 Dec. Each is a three-day weekend created by a gazetted holiday falling on a Friday or a Monday. Which one is next depends on today, so the badge at the top of the page names it rather than this answer.",
  },
  {
    q: "Is there any long weekend in December in 2026?",
    a: "Yes, one — and it is well placed. Christmas Day 2026 falls on a Friday, so <strong>Friday 25 to Sunday 27 December</strong> is three days off that cost nothing. December offers no second free long weekend, but a single leave on Thursday 31 December bridges New Year into a four-day run through to Sunday 3 January 2027.",
  },
  {
    q: "Are there any 4-day long weekends in 2026?",
    a: "Not for free: <strong>all nine of the year's no-leave long weekends are exactly three days</strong>. Spend one leave day, though, and 2026 hands you a four-day break 22 times over, across 13 different festivals. The earliest is Republic Day — take Friday 23 January off and you are away until Monday 26 January.",
  },
  {
    q: "Should I book travel early for these long weekends?",
    a: "Every date here is fixed and public, which means everyone else can see it too. Fares and room rates on the popular ones — Republic Day, the spring cluster around Mahavir Jayanti and Good Friday, Diwali — start climbing weeks out. The advantage of knowing the dates months ahead is being able to commit while there is still slack in the pricing, rather than discovering the break a fortnight before it arrives.",
  },
  {
    q: "How many long weekends are there in 2026 in India?",
    a: "<strong>Nine</strong>, if they have to be free — nine three-day weekends on the national calendar that need no leave at all. Widen the budget and the count climbs fast: one leave day unlocks 22 four-day breaks, and two or three days stretch several of them into six- and nine-day runs. State holidays and your own office list add more on top.",
  },
  {
    q: "Which months have the longest weekends in 2026?",
    a: "Spring wins outright. Mahavir Jayanti and Good Friday fall close enough together that two leave days buy a six-day break from 31 March to 5 April, while every other month tops out at five days on the same budget. The irony is that March, July and November contain no long weekend that is free at all — March is the most generous month of the year and the least generous if you refuse to spend a leave.",
  },
  {
    q: "How many government holidays fall near weekends in 2026?",
    a: "<strong>Twelve of the 17 gazetted national holidays</strong> touch a weekend in 2026. Nine land on a Friday or a Monday, which makes a three-day break on its own. Three more are swallowed whole — Id-ul-Fitr, Independence Day and Diwali all fall on a Saturday or a Sunday, so they hand you nothing you did not already have. The other five fall midweek, where one well-placed leave day is what turns them into a break.",
  },
  {
    q: "Which is the most extended possible weekend in 2026?",
    a: "The longest one worth taking is an <strong>18-day stretch from Thursday 19 March to Sunday 5 April</strong>, chaining Id-ul-Fitr, Mahavir Jayanti and Good Friday together — though it costs 10 leave days, which is most of an annual balance. Keep spending and the calendar keeps giving: 11 leaves buys 19 days in February, 13 buys 21. None of those are good value. The same spring cluster is far better in smaller bites: nine days off for three leaves, or six for two.",
  },
  {
    q: "How many holidays will India have in 2026?",
    a: "There are <strong>17 gazetted national holidays</strong> in 2026, and this planner adds your state list on top of them: seven more for Karnataka, four for Maharashtra, three each for Delhi and West Bengal, and two for Tamil Nadu. Your own office calendar will differ again, which is what the Company Holiday Optimizer is for.",
  },
  {
    q: "Does this cover 2027 as well?",
    a: "Yes. The planner carries the full gazetted list for <strong>2027</strong> alongside 2026, so the results keep going rather than thinning out as the year closes. 2027 is a leaner year for free breaks — five that cost no leave at all, against nine in 2026, because more holidays land on a weekend — but Good Friday on 26 March, Mahavir Jayanti on 19 April, Id-ul-Zuha on 17 May and Diwali on 29 October each give a three-day weekend outright. Dates for 2027 follow the DoPT list published in July 2026; the moon-sighting festivals can still shift by a day.",
  },
  {
    q: "How does the long weekend calculator work?",
    a: "Pick your leave budget, your region and your work week. The calculator cross-references gazetted public holidays against your weekends to find every bridging opportunity, then ranks them by value — the most days off for the fewest leaves spent.",
  },
  {
    q: "Can I use this tool for my company's holiday list?",
    a: "Yes. Open the Company Holiday Optimizer and upload your office holiday PDF or image, or paste the text straight in. It reads your company's dates and plans around those instead of the national list, so you only see breaks your office actually observes.",
  },
  {
    q: "Do I need to create an account to use this tool?",
    a: "No. The Long Weekends is free and needs no sign-up. Every calculation runs in your browser — nothing is uploaded and nothing is stored.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

/**
 * The answers contain real markup, which schema.org permits inside Answer.text
 * and which the accordion renders — so the same string is inlined into a
 * script element and into the page body.
 *
 * Inside a script element the parser is not looking for tags, it is looking for
 * the character sequence that ends the element. An answer containing one would
 * terminate the script early and dump the rest of the JSON into the document as
 * text, which breaks both the page and the structured data. Escaping every
 * less-than to its JSON unicode form makes that impossible while still decoding
 * back to real markup for anything that parses the JSON. JSON.stringify does not
 * do this on its own.
 */
const faqJsonLd = JSON.stringify(faqSchema).replace(/</g, "\\u003c");
---

<Layout title={TITLE} description={DESCRIPTION} path="/">
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={faqJsonLd}
  />

  <Navbar />
  <Hero />

  <!-- ===================================================================
       Filter bar
       Sticky under the navbar. Both rows are real button groups with
       aria-pressed, so the current filter is announced rather than only
       painted. The old version used divs with click handlers.
       =================================================================== -->
  <section
    aria-label="Filter long weekends"
    class="sticky top-[4.25rem] z-40 border-b border-hairline bg-page/90 backdrop-blur-lg"
  >
    {/* Tighter vertically on phones. This bar and the navbar are both pinned,
         and at py-3 they took ~160px of a 667px screen before a single result
         showed. The eyebrow labels below are `sm:block` for the same reason. */}
    <div
      class="mx-auto flex max-w-[1280px] flex-col gap-1.5 px-4 py-2.5 sm:gap-2 sm:px-6 sm:py-3"
    >
      <div class="flex items-center gap-3">
        <span
          class="hidden shrink-0 font-mono text-[0.625rem] font-bold uppercase tracking-widest text-muted sm:block"
          aria-hidden="true">Budget</span
        >
        <div
          id="budgetRail"
          role="group"
          aria-label="Leave budget"
          class="rail min-w-0 py-0.5"
        >
          <button type="button" class="pill" data-leaves="0" aria-pressed="true">
            <span class="pill-glyph" aria-hidden="true">🎁</span>No leaves
          </button>
          <button type="button" class="pill" data-leaves="1" aria-pressed="false">
            <span class="pill-glyph" aria-hidden="true">🌴</span>1 leave
          </button>
          <button type="button" class="pill" data-leaves="2" aria-pressed="false">
            <span class="pill-glyph" aria-hidden="true">✈️</span>2 leaves
          </button>

          <!-- A <div role="group">, not a button: the +/- controls are buttons
               and nesting buttons is invalid HTML. Its selected look comes from
               `.is-on` rather than aria-pressed. -->
          <div
            id="customChipWrapper"
            role="group"
            aria-label="Custom number of leaves"
            class="pill pill-compound"
          >
            <button
              type="button"
              id="btnDecLeave"
              class="stepper-btn"
              aria-label="One leave fewer"><span aria-hidden="true">−</span></button
            >
            <button
              type="button"
              data-leaves="custom"
              class="flex items-baseline gap-1 px-0.5"
            >
              <span id="customLeavesDisplay" class="font-mono font-bold tabular">3</span>
              <span class="text-[0.6875rem] font-semibold opacity-80">leaves</span>
            </button>
            <button
              type="button"
              id="btnIncLeave"
              class="stepper-btn"
              aria-label="One leave more"><span aria-hidden="true">+</span></button
            >
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <span
          class="hidden shrink-0 font-mono text-[0.625rem] font-bold uppercase tracking-widest text-muted sm:block"
          aria-hidden="true">Month</span
        >
        <div class="relative min-w-0 grow">
          <span id="monthFadeL" class="rail-fade rail-fade-l" aria-hidden="true"></span>
          <span id="monthFadeR" class="rail-fade rail-fade-r" aria-hidden="true"></span>
          <div
            id="monthRail"
            role="group"
            aria-label="Filter by month"
            class="rail py-0.5"
          >
            {/* Built by mountResults() on the client. It was generated here
                from the build date, which meant the rail listed months that had
                already passed and could not list months added to the data after
                the build. See `monthRange` in scripts/results.ts. */}
          </div>
        </div>
        <div class="hidden shrink-0 items-center gap-1 sm:flex">
          <button
            type="button"
            id="monthRailPrev"
            class="btn-icon"
            hidden
            aria-label="Show earlier months"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg
            >
          </button>
          <button
            type="button"
            id="monthRailNext"
            class="btn-icon"
            aria-label="Show later months"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
            >
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       Results
       =================================================================== -->
  <main
    id="main"
    class="mx-auto w-full max-w-[1280px] grow px-4 py-8 sm:px-6 sm:py-10"
  >
    {/* scroll-mt clears whatever is pinned above this anchor when the hero's
        "Next up" link jumps here. Two sticky bars stack on the way down —
        navbar (4.25rem) + filter bar — and the filter bar is one row taller on
        phones than it looks, because the eyebrow labels drop out and the rails
        keep their padding. 12rem covers it at every width. */}
    <div
      id="results"
      class="mb-5 flex flex-wrap items-end justify-between gap-3 scroll-mt-[12rem] sm:gap-4"
    >
      <div aria-live="polite" class="min-w-0">
        <h2 class="text-xl font-extrabold sm:text-2xl">
          <span id="resultsBadge">Counting</span>
        </h2>
        <p id="resultsSubtext" class="mt-0.5 text-sm text-body"></p>
      </div>

      <div class="relative">
        <button
          type="button"
          id="sortTrigger"
          class="btn btn-ghost btn-sm"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="sortMenu"
        >
          <svg
            class="h-3.5 w-3.5 text-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 6h18M6 12h12M10 18h4"></path>
          </svg>
          <span class="text-muted">Sort</span>
          <span id="sortLabel">Soonest first</span>
          <svg
            class="seg-caret h-3 w-3 text-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>

        <div
          id="sortMenu"
          role="menu"
          aria-labelledby="sortTrigger"
          hidden
          class="popover popover-below absolute right-0 z-40 w-[15rem] p-2"
        >
          {
            /* Order matters: the first entry is marked checked below, so it
               has to be DEFAULT_SORT in plan-view.ts. */
            [
              { v: "date", label: "Soonest first", hint: "Whatever is next" },
              { v: "days", label: "Longest break", hint: "Biggest total time off" },
            ].map((o, i) => (
              <button
                type="button"
                role="menuitemradio"
                aria-checked={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="menu-item"
                data-sort={o.v}
                data-label={o.label}
              >
                <span class="min-w-0 grow">
                  <span class="block text-[0.8125rem] font-bold text-ink">{o.label}</span>
                  <span class="block text-xs text-muted">{o.hint}</span>
                </span>
                <svg
                  data-check
                  class:list={["h-4 w-4 shrink-0 text-brand-text", { hidden: i !== 0 }]}
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 13 4 4L19 7" />
                </svg>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Legend. The day ribbon on every card is the densest thing on the page,
         so it gets an explicit key rather than expecting colour to explain
         itself. Each entry names its state in words as well. -->
    <div
      class="mb-6 flex flex-wrap items-center gap-x-5 gap-y-2 rounded-control border border-hairline bg-surface-soft px-3.5 py-2.5"
    >
      <span class="font-mono text-[0.625rem] font-bold uppercase tracking-widest text-muted">
        Each strip reads
      </span>
      <span class="flex items-center gap-2 text-xs font-bold text-body">
        <span class="dot dot-holiday" aria-hidden="true"></span>Public holiday
      </span>
      <span class="flex items-center gap-2 text-xs font-bold text-body">
        <span class="dot dot-weekend" aria-hidden="true"></span>Weekend
      </span>
      <span class="flex items-center gap-2 text-xs font-bold text-body">
        <span class="dot dot-pto" aria-hidden="true"></span>Your leave (dashed)
      </span>
    </div>

    <div id="vacationGrid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>

    <!-- An empty result is a dead end unless it offers a way out, so the button
         is wired to whichever fix actually applies. -->
    <div id="emptyState" hidden class="card mx-auto max-w-lg p-8 text-center">
      <span class="mb-3 inline-block text-4xl" aria-hidden="true">🗓️</span>
      <h3 id="emptyStateTitle" class="text-lg font-extrabold">Nothing here yet</h3>
      <p id="emptyStateSub" class="mx-auto mt-1.5 max-w-sm text-sm text-body"></p>
      <button type="button" id="emptyStateAction" class="btn btn-brand btn-sm mt-5">
        Show every month
      </button>
    </div>
  </main>

  <!-- ===================================================================
       Calendar dialog
       =================================================================== -->
  <div id="calendarModal" class="dialog-backdrop" hidden>
    <div
      id="calendarDialog"
      class="dialog-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="calModalTitle"
      aria-describedby="calModalDates"
      tabindex="-1"
    >
      <header
        class="flex shrink-0 items-start justify-between gap-4 border-b border-hairline p-4 sm:p-5"
      >
        <div class="min-w-0">
          <h2 id="calModalTitle" class="text-base font-extrabold sm:text-lg">
            Calendar
          </h2>
          <p
            id="calModalDates"
            class="mt-0.5 font-mono text-xs font-semibold text-muted"
          >
          </p>
        </div>
        <button
          type="button"
          id="btnCloseCalendarModal"
          class="btn-icon shrink-0"
          aria-label="Close calendar"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
          >
        </button>
      </header>
      <div id="calModalContent" class="overflow-y-auto p-4 sm:p-5"></div>
    </div>
  </div>

  <!-- ===================================================================
       Reference content
       =================================================================== -->
  <section
    class="border-t border-hairline bg-surface px-4 py-16 sm:px-6 sm:py-20"
    aria-labelledby="reference-heading"
  >
    <div class="mx-auto max-w-[52rem]">
      <span class="tag tag-brand mb-4">🗓️ 2026 &amp; 2027 vacation planner</span>
      <h2
        id="reference-heading"
        class="mb-4 text-2xl font-extrabold sm:text-3xl lg:text-4xl"
      >
        When is the next long weekend?
      </h2>
      <div class="prose-body flex flex-col gap-4">
        <p>
          If you're wondering <strong>when the next long weekend is</strong>,
          you're in good company — it's among the most-searched questions by
          working professionals in India every month. The answer keeps moving as
          holidays pass and new ones approach, which is exactly why this page
          recalculates it instead of listing it.
        </p>
        <p>
          The calculator identifies the <strong>next long weekend</strong> from
          today's date, your country (India or the United States) and the
          official gazetted holiday list, which now runs through
          <strong>2027</strong> so the answer does not thin out as the year
          closes. Whether that's a three-day
          Saturday–Sunday–Monday or a nine-day stretch that bridges Diwali into
          a full week, every option is ranked by value: the most days off for the
          fewest leaves spent.
        </p>
      </div>

      <!-- The leading rule lives inside this block so that hiding a fully
           stale list does not leave two rules stacked on top of each other. -->
      <div id="highlightBlock">
        <hr class="my-10 border-hairline" />

        <h2 class="mb-4 text-2xl font-extrabold sm:text-3xl">
          Long weekends still ahead
        </h2>
        <!-- Rewritten by the client script once it knows the visitor's region
             and clock; this wording is what a crawler sees. -->
        <p id="highlightNote" class="prose-body mb-6">
          Generated from the gazetted list when this page was built, for a
          five-day work week, cheapest option first. Change the budget above to
          see the rest.
        </p>

        <ul
          id="highlightList"
          class="flex flex-col divide-y divide-hairline border-y border-hairline"
        >
          {
            highlights.map((plan) => {
              const theme = getBannerTheme(plan);
              return (
                <li class="flex items-center gap-4 py-3.5">
                  <span class="text-xl shrink-0" aria-hidden="true">{theme.motif}</span>
                  <span class="min-w-0 grow">
                    <span class="block truncate text-sm font-bold text-ink">
                      {plan.title}
                    </span>
                    <span class="block font-mono text-xs font-semibold text-muted tabular">
                      {formatDateRange(plan.startDate, plan.endDate)}
                    </span>
                  </span>
                  <span class="shrink-0 text-right">
                    <span class="block font-mono text-base font-bold text-ink tabular">
                      {plan.totalDaysOff}
                    </span>
                    <span class="block text-[0.625rem] font-bold uppercase tracking-wider text-muted">
                      days off
                    </span>
                  </span>
                  <span class="hidden shrink-0 sm:block">
                    {plan.leavesRequired === 0 ? (
                      <span class="tag tag-holiday">Free</span>
                    ) : (
                      <span class="tag tag-pto">{pluralLeaves(plan.leavesRequired)}</span>
                    )}
                  </span>
                </li>
              );
            })
          }
        </ul>
      </div>

      <hr class="my-10 border-hairline" />

      <h2 class="mb-4 text-2xl font-extrabold sm:text-3xl">
        How the calculator works
      </h2>
      <p class="prose-body mb-6">
        Three steps, in order — this one really is a sequence.
      </p>
      <ol class="flex flex-col gap-3">
        {
          [
            {
              t: "Set your leave budget",
              d: "Zero, one, two, or a custom number of days you're willing to spend on a single trip.",
            },
            {
              t: "Pick your region and work week",
              d: "India (pan-India IT) or the United States (federal), on a five- or six-day week.",
            },
            {
              t: "Read the strips",
              d: "Every card shows the exact dates, which days are free, and which ones cost you leave.",
            },
          ].map((step, i) => (
            <li class="flex items-start gap-3.5 rounded-card border border-hairline bg-surface-soft p-4">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-ink font-mono text-xs font-extrabold text-surface">
                {i + 1}
              </span>
              <span>
                <span class="block text-sm font-bold text-ink">{step.t}</span>
                <span class="mt-0.5 block text-xs text-body">{step.d}</span>
              </span>
            </li>
          ))
        }
      </ol>

      <hr class="my-10 border-hairline" />

      <h2 class="mb-4 text-2xl font-extrabold sm:text-3xl">
        Why this math is worth doing
      </h2>
      <div class="prose-body flex flex-col gap-4">
        <p>
          Most companies in India and the United States offer 15 to 24 paid
          leaves a year. That sounds generous until it has to cover sick days,
          emergencies and family obligations. What's left over is often barely a
          week of actual holiday.
        </p>
        <p>
          <strong>Long weekends change the arithmetic.</strong> Placing one to
          three leave days around holidays and weekends you already have unlocks
          four- to nine-day breaks without draining the balance. It isn't about
          working less — it's about where the days land.
        </p>
      </div>

      {/* `id="faq"` is a real destination, not decoration: 404.astro offers
           "Frequently asked questions" as one of its four recovery links and
           points it at /#faq, which landed at the top of the homepage because no
           such anchor existed.

           scroll-mt clears the two sticky bars that stack above it — the same
           12rem `#results` uses, and for the same reason. Without it the browser
           aligns the heading to y=0, where the navbar and filter bar are already
           sitting, and the reader arrives looking at the first answer with no
           question above it. */}
      <div id="faq" class="mt-14 scroll-mt-[12rem] border-t border-hairline pt-10">
        <span
          class="mb-1 block font-mono text-[0.625rem] font-bold uppercase tracking-widest text-brand-text"
          >Got questions?</span
        >
        <h2 class="mb-6 text-2xl font-extrabold sm:text-3xl">
          Frequently asked questions
        </h2>

        <div class="flex flex-col gap-3">
          {
            FAQ.map((item) => (
              <details class="group card p-5">
                <summary
                  class="flex cursor-pointer list-none items-center justify-between gap-4 text-[0.9375rem] font-bold text-ink"
                >
                  <span>{item.q}</span>
                  <svg
                    class="h-5 w-5 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                {/* set:html, not an interpolation: the answers carry <strong>
                     emphasis that has to render as markup here and reach the
                     JSON-LD as the same string. Interpolating would escape it
                     on the page while the schema kept the tags, and a FAQPage
                     whose markup disagrees with the visible answer is exactly
                     what Google's spam guidance is aimed at. */}
                <p
                  class="mt-4 border-t border-hairline pt-3 text-sm leading-relaxed text-body"
                  set:html={item.a}
                />
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import {
    CALENDAR_END,
    getTodayIso,
    getUpcomingCutoffIso,
    buildCalendarMap,
    solveVacationPlans,
    type RegionCode,
  } from "../data/vacation-solver";
  import { mountResults } from "../scripts/results";
  import { formatDateRange, getBannerTheme, nextBreaks, pluralLeaves } from "../scripts/plan-view";

  // Region and work week live in the navbar; the results grid listens rather
  // than reaching into the navbar's DOM the way the old code did.
  let region: RegionCode = "ALL";
  let workWeek = 5;
  // Two different dates, deliberately. `today` marks the current day in the
  // calendar modal; `cutoff` is what a plan has to start after to be offered.
  // Both are read when this module loads in the browser, so a visitor arriving
  // days after the site was built gets their own current date, not the build's.
  const today = getTodayIso();
  const cutoff = getUpcomingCutoffIso();

  const results = mountResults({
    solve: (leaves) =>
      solveVacationPlans({ leaves, workWeek, region, month: "ALL", fromDate: cutoff }),
    // Shades weekends and holidays outside the plan in the modal grid.
    calendar: () => buildCalendarMap(region, workWeek),
    todayIso: today,
    // From the visitor's own clock to the last month the data covers, so the
    // rail never offers a month that has passed and never hides one that was
    // added after the build.
    monthRange: { from: cutoff.slice(0, 7), to: CALENDAR_END.slice(0, 7) },
  });

  /**
   * The highlight list is baked into the HTML at build time, which makes it
   * crawlable but leaves it wrong in two ways for a real visitor: it rots (a
   * break it calls "still ahead" may already be over), and it is always the
   * Indian list, so someone who switched to the US read about Raksha Bandhan
   * under a heading that claimed to be about their year.
   *
   * Re-solving on the client fixes both at once, because the solver is given
   * the visitor's own region, work week and clock. The block is hidden rather
   * than removed so switching region can bring it back.
   */
  function renderHighlights() {
    const block = document.getElementById("highlightBlock");
    const list = document.getElementById("highlightList");
    if (!block || !list) return;

    const rows = nextBreaks((leaves) =>
      solveVacationPlans({ leaves, workWeek, region, month: "ALL", fromDate: cutoff })
    );

    if (!rows.length) {
      // Better to say nothing than to promise a break that is already over.
      block.hidden = true;
      return;
    }
    block.hidden = false;

    const note = document.getElementById("highlightNote");
    if (note) {
      // The leave budget is described from what the rows actually cost rather
      // than asserted, because nextBreaks() widens the budget when the cheap
      // band is empty — late in the year "at most one leave day" would be a
      // claim about the rows above that they no longer satisfy.
      const dearest = Math.max(...rows.map((p) => p.leavesRequired));
      note.textContent =
        `The next ${rows.length === 1 ? "break" : `${rows.length} breaks`} starting after today` +
        `${region === "USA" ? " on the US federal calendar" : ""}, for a ` +
        `${workWeek}-day work week, ` +
        `${dearest === 0 ? "none of which cost a leave day" : `spending at most ${pluralLeaves(dearest)}`}. ` +
        `Change the budget above to see the rest.`;
    }

    // Built node by node rather than with innerHTML: plan titles are assembled
    // from holiday names in the data file, and this list is not worth an
    // escaping bug.
    const span = (cls: string, text?: string) => {
      const s = document.createElement("span");
      s.className = cls;
      if (text !== undefined) s.textContent = text;
      return s;
    };

    list.replaceChildren(
      ...rows.map((plan) => {
        const li = document.createElement("li");
        li.className = "flex items-center gap-4 py-3.5";

        const motif = span("text-xl shrink-0", getBannerTheme(plan).motif);
        motif.setAttribute("aria-hidden", "true");

        const name = span("min-w-0 grow");
        name.append(
          span("block truncate text-sm font-bold text-ink", plan.title),
          span(
            "block font-mono text-xs font-semibold text-muted tabular",
            formatDateRange(plan.startDate, plan.endDate)
          )
        );

        const count = span("shrink-0 text-right");
        count.append(
          span("block font-mono text-base font-bold text-ink tabular", String(plan.totalDaysOff)),
          span("block text-[0.625rem] font-bold uppercase tracking-wider text-muted", "days off")
        );

        const cost = span("hidden shrink-0 sm:block");
        cost.append(
          plan.leavesRequired === 0
            ? span("tag tag-holiday", "Free")
            : span("tag tag-pto", pluralLeaves(plan.leavesRequired))
        );

        li.append(motif, name, count, cost);
        return li;
      })
    );
  }

  function scrollToResults() {
    document.getElementById("results")?.scrollIntoView({
      behavior: "smooth",
      block: "start",
    });
  }

  document.addEventListener("lw:region", (e) => {
    region = (e as CustomEvent).detail.region as RegionCode;
    results?.refresh();
    renderHighlights();
  });

  document.addEventListener("lw:workweek", (e) => {
    workWeek = (e as CustomEvent).detail.workWeek as number;
    results?.refresh();
    renderHighlights();
  });

  // The hero capsule carries its own region and budget; pressing its button
  // pushes both here, and echoes the region back so the navbar agrees.
  document.addEventListener("lw:search", (e) => {
    const detail = (e as CustomEvent).detail as { region: RegionCode; leaves: number };
    region = detail.region;
    document.dispatchEvent(
      new CustomEvent("lw:setregion", { detail: { region } })
    );
    results?.setLeaves(detail.leaves);
    renderHighlights();
    scrollToResults();
  });

  /** Applies ?region=/?leaves=/?month= — the shape the footer links use. */
  function applyParams(params: URLSearchParams) {
    const r = params.get("region");
    if (r === "ALL" || r === "USA") {
      region = r;
      document.dispatchEvent(new CustomEvent("lw:setregion", { detail: { region } }));
      results?.refresh();
      renderHighlights();
    }

    const leaves = params.get("leaves");
    if (leaves !== null) results?.setLeaves(Number(leaves) || 0);

    /* Driven by clicking the pill so there is exactly one code path for
       changing month — and so a month with nothing in it stays inert.

       The footer links carry a bare month ("?month=11") on purpose: a link
       hardcoded to "2026-11" would quietly point into the past a year later.
       A bare number is resolved to the SOONEST pill for that month, which is
       what "show me November" means to someone reading a footer. A full
       "YYYY-MM" is still honoured for anyone sharing a specific month. */
    const month = params.get("month");
    if (month) {
      const rail = document.getElementById("monthRail");
      const selector = /^\d{4}-\d{2}$/.test(month)
        ? `[data-month="${month}"]`
        : `[data-month$="-${month.padStart(2, "0")}"]`;
      rail?.querySelector<HTMLButtonElement>(selector)?.click();
    }
  }

  renderHighlights();
  applyParams(new URLSearchParams(window.location.search));

  // Footer links point at "/?leaves=2" and friends. On this page that is a
  // filter change, not a navigation, so handle it in place.
  document.querySelectorAll<HTMLAnchorElement>(".footer-filter-link").forEach((a) => {
    a.addEventListener("click", (e) => {
      const url = new URL(a.href, window.location.href);
      if (url.pathname !== window.location.pathname) return;
      e.preventDefault();
      window.history.replaceState(null, "", url.search || url.pathname);
      applyParams(url.searchParams);
      scrollToResults();
    });
  });
</script>
