  <script>
    import { solveVacationPlans, CURRENT_DATE_REF } from "../data/vacation-solver";

    let state = {
      selectedRegion: "ALL",
      workWeek: 5,
      selectedLeaves: 0,
      selectedMonth: "ALL",
      currentPlans: [] as any[],
      sortBy: "efficiency"
    };

    
    function setupThemeToggle() {
      const toggleBtns = document.querySelectorAll('.theme-toggle-btn');
      toggleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          updateThemeIcons();
        });
      });

      function updateThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        document.querySelectorAll('.theme-icon-moon').forEach(el => {
          if (isDark) el.classList.add('hidden'); else el.classList.remove('hidden');
        });
        document.querySelectorAll('.theme-icon-sun').forEach(el => {
          if (isDark) el.classList.remove('hidden'); else el.classList.add('hidden');
        });
      }

      updateThemeIcons();
    }

    function init() {
      setupThemeToggle();

      // Read initial URL parameters (e.g. ?region=USA)
      const params = new URLSearchParams(window.location.search);
      if (params.has("region")) {
        const r = params.get("region");
        if (r && ["ALL", "USA", "SOUTH", "WEST", "NORTH", "EAST"].includes(r)) {
          state.selectedRegion = r;
          const regionSelect = document.getElementById("navRegionSelector") as HTMLSelectElement;
          if (regionSelect) {
            regionSelect.value = r;
          }
          const flag = document.getElementById("brandFlag");
          if (flag) {
            flag.textContent = r === "USA" ? "🇺🇸" : "🇮🇳";
          }
        }
      }
      if (params.has("leaves")) {
        const l = parseInt(params.get("leaves") || "0", 10);
        if (!isNaN(l)) state.selectedLeaves = l;
      }
      if (params.has("month")) {
        const m = params.get("month");
        if (m) state.selectedMonth = m;
      }

      bindEvents();
      render();
    }

    function bindEvents() {
      // Intercept Footer links for smooth transition without reload on homepage
      document.querySelectorAll(".footer-filter-link").forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const url = new URL((link as HTMLAnchorElement).href);
          const params = new URLSearchParams(url.search);
          
          let changed = false;
          if (params.has("region")) {
            const r = params.get("region");
            if (["ALL", "USA", "SOUTH", "WEST", "NORTH", "EAST"].includes(r)) {
              state.selectedRegion = r;
              const regionSelect = document.getElementById("navRegionSelector") as HTMLSelectElement;
              if (regionSelect) {
                regionSelect.value = r;
                const flag = document.getElementById("brandFlag");
                if (flag) {
                  flag.textContent = r === "USA" ? "🇺🇸" : "🇮🇳";
                }
                regionSelect.dispatchEvent(new Event("change"));
              }
              changed = true;
            }
          }
          if (params.has("leaves")) {
            const l = parseInt(params.get("leaves") || "0", 10);
            if (!isNaN(l)) {
              state.selectedLeaves = l;
              changed = true;
            }
          }
          if (params.has("month")) {
            const m = params.get("month");
            if (m) {
              state.selectedMonth = m;
              changed = true;
            }
          }

          if (changed) {
            updateActiveUI();
            render();
            // Scroll to the main UI area so user sees the change
            document.getElementById("main-content-area")?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            // Let's scroll to top if main-content-area is not there
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      });
  
      // Custom Dropdown Logic
      const dropdownBtn = document.getElementById("sortDropdownBtn");
      const dropdownMenu = document.getElementById("sortDropdownMenu");
      const dropdownLabel = document.getElementById("sortDropdownLabel");
      const sortOptions = document.querySelectorAll(".sort-option");

      if (dropdownBtn && dropdownMenu) {
        dropdownBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const isHidden = dropdownMenu.classList.contains("hidden");
          if (isHidden) {
            dropdownMenu.classList.remove("hidden", "pointer-events-none");
            setTimeout(() => dropdownMenu.classList.remove("opacity-0", "scale-95"), 10);
          } else {
            dropdownMenu.classList.add("opacity-0", "scale-95");
            setTimeout(() => dropdownMenu.classList.add("hidden", "pointer-events-none"), 200);
          }
        });

        document.addEventListener("click", (e) => {
          if (!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
            dropdownMenu.classList.add("opacity-0", "scale-95");
            setTimeout(() => dropdownMenu.classList.add("hidden", "pointer-events-none"), 200);
          }
        });

        sortOptions.forEach(option => {
          option.addEventListener("click", () => {
            const value = option.dataset.value;
            if (!value) return;

            const text = value === "efficiency" ? "Sort: Highest Efficiency" : "Sort: Chronological (Dates)";
            if (dropdownLabel) dropdownLabel.textContent = text;

            sortOptions.forEach(opt => {
              const icon = opt.querySelector(".check-icon");
              if (icon) {
                if (opt === option) icon.classList.remove("hidden");
                else icon.classList.add("hidden");
              }
            });

            state.sortBy = value;
            dropdownMenu.classList.add("opacity-0", "scale-95");
            setTimeout(() => dropdownMenu.classList.add("hidden", "pointer-events-none"), 200);
            
            render();
          });
        });
      }
      const regionSelect = document.getElementById("navRegionSelector") as HTMLSelectElement;
      const btn5Day = document.getElementById("btnWorkweek5");
      const btn6Day = document.getElementById("btnWorkweek6");

      if (regionSelect) {
        regionSelect.addEventListener("change", (e) => {
          const val = (e.target as HTMLSelectElement).value;
          state.selectedRegion = val;
          const flag = document.getElementById("brandFlag");
          if (flag) {
            flag.textContent = val === "USA" ? "🇺🇸" : "🇮🇳";
          }
          render();
        });
      }

      if (btn5Day && btn6Day) {
        btn5Day.addEventListener("click", () => {
          btn5Day.className = "px-2.5 py-1 text-xs font-medium rounded-sm transition-all bg-[#171717] text-white";
          btn6Day.className = "px-2.5 py-1 text-xs font-medium rounded-sm transition-all text-[#666666] hover:text-[#171717]";
          state.workWeek = 5;
          render();
        });
        btn6Day.addEventListener("click", () => {
          btn6Day.className = "px-2.5 py-1 text-xs font-medium rounded-sm transition-all bg-[#171717] text-white";
          btn5Day.className = "px-2.5 py-1 text-xs font-medium rounded-sm transition-all text-[#666666] hover:text-[#171717]";
          state.workWeek = 6;
          render();
        });
      }

      document.querySelectorAll(".chip-btn").forEach((chip) => {
        if (chip.id === "customChipWrapper") return;
        chip.addEventListener("click", () => {
          const leaves = parseInt((chip as HTMLElement).dataset.leaves || "0", 10);
          state.selectedLeaves = leaves;
          updateActiveUI();
        });
      });

      const customWrapper = document.getElementById("customChipWrapper");
      const customInput = document.getElementById("customLeavesInput") as HTMLInputElement;
      const customDisplay = document.getElementById("customLeavesDisplay");
      const btnInc = document.getElementById("btnIncLeave");
      const btnDec = document.getElementById("btnDecLeave");

      if (customWrapper && customInput && customDisplay) {
        customWrapper.addEventListener("click", () => {
          const val = Math.max(parseInt(customInput.value || "4", 10), 4);
          state.selectedLeaves = val;
          updateActiveUI();
        });
        if (btnInc) {
          btnInc.addEventListener("click", (e) => {
            e.stopPropagation();
            let val = parseInt(customInput.value || "4", 10);
            if (val < 15) val += 1;
            customInput.value = String(val);
            customDisplay.textContent = String(val);
            state.selectedLeaves = val;
            updateActiveUI();
          });
        }
        if (btnDec) {
          btnDec.addEventListener("click", (e) => {
            e.stopPropagation();
            let val = parseInt(customInput.value || "4", 10);
            if (val > 4) val -= 1;
            customInput.value = String(val);
            customDisplay.textContent = String(val);
            state.selectedLeaves = val;
            updateActiveUI();
          });
        }
      }

      document.querySelectorAll(".month-tab-btn").forEach((tab) => {
        tab.addEventListener("click", () => {
          state.selectedMonth = (tab as HTMLElement).dataset.month || "ALL";
          updateActiveUI();
        });
      });

      // Calendar Modal bindings
      const calModal = document.getElementById("calendarModal");
      const btnCloseCal = document.getElementById("btnCloseCalendarModal");
      if (calModal && btnCloseCal) {
        btnCloseCal.addEventListener("click", () => calModal.classList.add("hidden"));
        calModal.addEventListener("click", (e) => {
          if (e.target === calModal) calModal.classList.add("hidden");
        });
      }

      

      // Escape key to dismiss modals
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          if (calModal) calModal.classList.add("hidden");
          
        }
      });
    }

    function updateActiveUI() {
      document.querySelectorAll(".chip-btn").forEach((c) => c.classList.remove("active"));
      const customChip = document.getElementById("customChipWrapper");
      const customInput = document.getElementById("customLeavesInput") as HTMLInputElement;
      const customDisplay = document.getElementById("customLeavesDisplay");

      if (state.selectedLeaves <= 3) {
        const matchingChip = document.querySelector(`.chip-btn[data-leaves="${state.selectedLeaves}"]`);
        if (matchingChip) matchingChip.classList.add("active");
      } else {
        if (customChip && customInput && customDisplay) {
          customChip.classList.add("active");
          customInput.value = String(state.selectedLeaves);
          customDisplay.textContent = String(state.selectedLeaves);
        }
      }

      document.querySelectorAll(".month-tab-btn").forEach((t) => {
        if (((t as HTMLElement).dataset.month || "ALL") === state.selectedMonth) t.classList.add("active");
        else t.classList.remove("active");
      });

      render();
    }

    function formatDateRange(startStr: string, endStr: string) {
      const s = new Date(startStr + "T00:00:00");
      const e = new Date(endStr + "T00:00:00");
      return s.toLocaleDateString("en-IN", { day: "numeric", month: "short" }) + " – " + e.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
    }

    function renderMonthGrid(year: number, monthIndex: number, daysMap: Map<string, any>) {
      const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
      const firstDay = new Date(year, monthIndex, 1).getDay();
      const daysInMonth = new Date(year, monthIndex + 1, 0).getDate();
      const monOffset = (firstDay + 6) % 7;
      const monthTitle = `${monthNames[monthIndex]} ${year}`;

      let cellsHtml = "";
      for (let i = 0; i < monOffset; i++) {
        cellsHtml += `<div class="h-8"></div>`;
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const mm = String(monthIndex + 1).padStart(2, "0");
        const dd = String(d).padStart(2, "0");
        const iso = `${year}-${mm}-${dd}`;
        const dayOfWeek = new Date(year, monthIndex, d).getDay();
        const isNormalWeekend = dayOfWeek === 0 || dayOfWeek === 6;

        let cellStyle = "text-slate-400 bg-transparent";
        let dotHtml = "";
        let tooltipText = "";

        if (daysMap.has(iso)) {
          const item = daysMap.get(iso);
          if (item.type === "holiday") {
            cellStyle = "bg-emerald-100 text-emerald-950 font-bold border border-emerald-300 ring-2 ring-emerald-400/30";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-600 inline-block mt-0.5"></span>';
            tooltipText = item.label || "Gazetted Holiday";
          } else if (item.type === "leave") {
            cellStyle = "bg-amber-100 text-amber-950 font-bold border border-amber-300 ring-2 ring-amber-400/30";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-amber-600 inline-block mt-0.5"></span>';
            tooltipText = "Apply PTO Leave";
          } else if (item.type === "weekend") {
            cellStyle = "bg-blue-100/80 text-blue-950 font-bold border border-blue-300";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-blue-500 inline-block mt-0.5"></span>';
            tooltipText = "Weekend Off";
          }
        } else if (isNormalWeekend) {
          cellStyle = "text-slate-600 bg-slate-100/60 font-medium";
        }

        cellsHtml += `
          <div class="h-8 rounded-lg flex flex-col items-center justify-center text-xs transition-all relative group/calcell select-none ${cellStyle}">
            <span>${d}</span>
            ${dotHtml}
            ${tooltipText ? `
              <div class="hidden group-hover/calcell:block absolute bottom-full mb-1 left-1/2 -translate-x-1/2 px-2 py-0.5 bg-slate-900 text-white text-[10px] font-medium rounded shadow-lg whitespace-nowrap z-30 pointer-events-none">
                ${tooltipText}
              </div>
            ` : ""}
          </div>
        `;
      }

      return `
        <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
          <div class="text-xs font-bold text-slate-800 text-center mb-3 tracking-tight pb-2 border-b border-slate-100">
            ${monthTitle}
          </div>
          <div class="grid grid-cols-7 gap-1 text-center mb-1 text-[10px] font-bold text-slate-400">
            <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
          </div>
          <div class="grid grid-cols-7 gap-1">
            ${cellsHtml}
          </div>
        </div>
      `;
    }

    function openCalendarModal(plan: any) {
      const modal = document.getElementById("calendarModal");
      const mTitle = document.getElementById("calModalTitle");
      const mDates = document.getElementById("calModalDates");
      const mContent = document.getElementById("calModalContent");

      if (!modal || !mTitle || !mDates || !mContent) return;

      mTitle.textContent = plan.title;
      mDates.textContent = `🗓️ ${formatDateRange(plan.startDate, plan.endDate)} · ${plan.totalDaysOff} Consecutive Days Off`;

      const daysMap = new Map();
      plan.days.forEach((d: any) => daysMap.set(d.date, d));

      const startD = new Date(plan.startDate + "T00:00:00");
      const endD = new Date(plan.endDate + "T00:00:00");

      const startY = startD.getFullYear();
      const startM = startD.getMonth();
      const endY = endD.getFullYear();
      const endM = endD.getMonth();

      let calendarsHtml = "";
      if (startY === endY && startM === endM) {
        mContent.className = "grid grid-cols-1 max-w-sm mx-auto w-full gap-4 mb-6";
        calendarsHtml = renderMonthGrid(startY, startM, daysMap);
      } else {
        mContent.className = "grid grid-cols-1 md:grid-cols-2 gap-4 mb-6";
        calendarsHtml = renderMonthGrid(startY, startM, daysMap) + renderMonthGrid(endY, endM, daysMap);
      }

      mContent.innerHTML = calendarsHtml;
      modal.classList.remove("hidden");
    }

    function render() {
      const grid = document.getElementById("vacationGrid");
      const empty = document.getElementById("emptyState");
      const badge = document.getElementById("resultsBadge");
      const subtext = document.getElementById("resultsSubtext");

      const plans = solveVacationPlans({
        leaves: state.selectedLeaves,
        workWeek: state.workWeek,
        region: state.selectedRegion as any,
        month: state.selectedMonth,
        fromDate: CURRENT_DATE_REF
      });

      
      if (state.sortBy === "efficiency") {
        plans.sort((a, b) => {
          if (b.totalDaysOff !== a.totalDaysOff) return b.totalDaysOff - a.totalDaysOff;
          return a.startDate.localeCompare(b.startDate);
        });
      } else {
        plans.sort((a, b) => a.startDate.localeCompare(b.startDate));
      }
      state.currentPlans = plans;

      if (badge) badge.textContent = plans.length + (plans.length === 1 ? " Plan" : " Plans");
      if (subtext) subtext.textContent = "Showing options with " + state.selectedLeaves + (state.selectedLeaves === 1 ? " leave" : " leaves") + " (Min 3 days continuous off)";

      if (!grid || !empty) return;

      if (plans.length === 0) {
        grid.innerHTML = "";
        empty.classList.remove("hidden");
        return;
      }

      empty.classList.add("hidden");

      grid.innerHTML = plans.map((plan, planIdx) => {
        const pillsHtml = plan.days.map((d) => {
          if (d.type === "holiday") {
            return `
              <div class="flex-1 min-w-[50px] rounded-xl py-1.5 px-2 flex flex-col items-center justify-center text-center transition-colors bg-emerald-50 hover:bg-emerald-100/70 text-emerald-900 border border-emerald-200 hover:border-emerald-300 group/day relative cursor-default select-none">
                <span class="text-[9px] font-bold uppercase tracking-wider text-emerald-700">${d.dayName}</span>
                <span class="text-xs font-bold font-mono mt-0">${d.dayNum}</span>
                <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-emerald-100/90 text-emerald-800 mt-1 truncate max-w-full">Holiday</span>
                <div class="hidden group-hover/day:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-slate-900 text-white text-[10px] font-medium rounded-lg shadow-lg whitespace-nowrap z-30 pointer-events-none">
                  ${d.label || "Gazetted Public Holiday"}
                </div>
              </div>
            `;
          } else if (d.type === "weekend") {
            return `
              <div class="flex-1 min-w-[50px] rounded-xl py-1.5 px-2 flex flex-col items-center justify-center text-center transition-colors bg-blue-50/70 hover:bg-blue-100/60 text-blue-900 border border-blue-200/80 hover:border-blue-300 group/day relative cursor-default select-none">
                <span class="text-[9px] font-bold uppercase tracking-wider text-blue-700">${d.dayName}</span>
                <span class="text-xs font-bold font-mono mt-0">${d.dayNum}</span>
                <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-blue-100/80 text-blue-800 mt-1">Weekend</span>
                <div class="hidden group-hover/day:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-slate-900 text-white text-[10px] font-medium rounded-lg shadow-lg whitespace-nowrap z-30 pointer-events-none">
                  Weekly Weekend Off
                </div>
              </div>
            `;
          } else {
            return `
              <div class="flex-1 min-w-[50px] rounded-xl py-1.5 px-2 flex flex-col items-center justify-center text-center transition-colors bg-amber-50 hover:bg-amber-100/70 text-amber-900 border border-amber-300 hover:border-amber-400 group/day relative cursor-default select-none">
                <span class="text-[9px] font-bold uppercase tracking-wider text-amber-700">${d.dayName}</span>
                <span class="text-xs font-bold font-mono mt-0">${d.dayNum}</span>
                <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-amber-200/90 text-amber-950 mt-1 font-bold">Take PTO</span>
                <div class="hidden group-hover/day:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-slate-900 text-white text-[10px] font-medium rounded-lg shadow-lg whitespace-nowrap z-30 pointer-events-none">
                  Apply 1 Day Leave (PTO)
                </div>
              </div>
            `;
          }
        }).join("");

        const topBadge = plan.leavesRequired === 0
          ? `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">⚡ 0 Leaves Needed</span>`
          : `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-200">🎯 ${plan.leavesRequired} ${plan.leavesRequired === 1 ? "Leave" : "Leaves"} Needed (${plan.efficiencyMultiplier})</span>`;

        let bottomBarHtml = "";
        if (plan.leavesRequired === 0) {
          bottomBarHtml = `
            <div class="bg-emerald-50/70 border border-emerald-200 rounded-lg p-2.5 flex items-center gap-2 mt-0.5">
              <span class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
              <div class="text-xs font-medium text-emerald-950">
                <span class="font-bold">Direct Weekend Bridge</span> · No PTO required
              </div>
            </div>
          `;
        } else {
          const leaveDays = plan.days.filter(d => d.type === "leave").map(d => `${d.dayName} ${d.dayNum}`).join(", ");
          bottomBarHtml = `
            <div class="bg-amber-50/70 border border-amber-200 rounded-lg p-2.5 flex items-center gap-2 mt-0.5">
              <span class="w-5 h-5 rounded-full bg-amber-600 text-white flex items-center justify-center text-[10px] font-bold shrink-0">🎯</span>
              <div class="text-xs font-medium text-amber-950">
                <span class="font-bold">Apply PTO:</span> <span class="underline decoration-amber-500">${leaveDays}</span>
              </div>
            </div>
          `;
        }

        return `
          <div class="bg-white border border-slate-200 hover:border-slate-300 rounded-xl p-4 shadow-xs hover:shadow-md transition-all flex flex-col justify-between gap-3 group relative">
            <div>
              <!-- Top Bar -->
              <div class="flex items-center justify-between gap-2 mb-2">
                ${topBadge}
                
                <div class="flex items-center gap-1.5">
                  <span class="days-off-badge inline-flex items-center gap-1 text-[11px] font-bold text-indigo-700 bg-indigo-50 border border-indigo-200/80 px-2.5 py-0.5 rounded-full shadow-2xs">
                    🔥 ${plan.totalDaysOff} Days Off
                  </span>
                  <button 
                    type="button" 
                    class="btn-open-cal p-1.5 px-2 rounded-full text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200/80 hover:border-slate-300 transition-all flex items-center justify-center cursor-pointer hover:scale-105 active:scale-95 shadow-2xs" 
                    title="View Month Calendar Grid"
                    data-idx="${planIdx}"
                  >
                    <span class="text-xs">🗓️</span>
                  </button>
                </div>
              </div>

              <!-- Main Details -->
              <h3 class="font-bold text-base text-slate-900 tracking-tight mb-1 group-hover:text-blue-600 transition-colors">
                ${plan.title}
              </h3>
              <div class="text-xs font-semibold text-slate-500 flex items-center gap-1.5 mb-2.5">
                <span>🗓️</span>
                <span class="font-bold text-slate-800">${formatDateRange(plan.startDate, plan.endDate)}</span>
                
              </div>

              <!-- Interactive Day-by-Day Ribbon -->
              <div class="flex w-full gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden py-1">
                ${pillsHtml}
              </div>
            </div>

            <!-- Actionable Bottom Bar -->
            <div>
              ${bottomBarHtml}
            </div>
          </div>
        `;
      }).join("");

      // Bind calendar view modal triggers
      document.querySelectorAll(".btn-open-cal").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const idx = parseInt((btn as HTMLElement).dataset.idx || "0", 10);
          const selectedPlan = state.currentPlans[idx];
          if (selectedPlan) {
            openCalendarModal(selectedPlan);
          }
        });
      });

      
    }

    document.addEventListener("DOMContentLoaded", init);
  </script>
</body>
</html>
