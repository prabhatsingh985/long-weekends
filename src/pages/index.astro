---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Long Weekends — 2026 Indian Long Weekend & Leave Optimizer</title>
  <meta name="description" content="AI-powered dynamic long weekend optimizer for India. Turn 3 PTO leaves into 9 days off in 2026." />
  <link rel="canonical" href="https://thelongweekends.com/" />
  <meta property="og:title" content="The Long Weekends — 2026 Indian Long Weekend & Leave Optimizer" />
  <meta property="og:description" content="AI-powered dynamic long weekend optimizer for India. Turn 3 PTO leaves into 9 days off in 2026." />
  <meta property="og:url" content="https://thelongweekends.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://thelongweekends.com/og-image.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="The Long Weekends — 2026 Indian Long Weekend & Leave Optimizer" />
  <meta name="twitter:description" content="AI-powered dynamic long weekend optimizer for India. Turn 3 PTO leaves into 9 days off in 2026." />
  <meta name="twitter:image" content="https://thelongweekends.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>
</head>
<body class="bg-[#F7F7F7] text-[#222222] antialiased min-h-screen flex flex-col">

  <Navbar />
  <Hero />

  <!-- Filters Section -->
  <section id="filtersSection" class="sticky top-[80px] z-40 bg-white border-b border-[#EBEBEB]">
    <div class="max-w-[1760px] mx-auto px-4 sm:px-6 lg:px-10">
      <div class="flex items-center gap-2 py-3 overflow-x-auto hide-scrollbar">
        <button class="category-pill active" data-leaves="0">
          <span class="pill-icon">🆓</span><span class="pill-label">0 Leaves</span>
        </button>
        <button class="category-pill" data-leaves="1">
          <span class="pill-icon">🌴</span><span class="pill-label">1 Leave</span>
        </button>
        <button class="category-pill" data-leaves="2">
          <span class="pill-icon">✈️</span><span class="pill-label">2 Leaves</span>
        </button>
        <button class="category-pill" data-leaves="3">
          <span class="pill-icon">🏖️</span><span class="pill-label">3+ Leaves</span>
        </button>
        <div class="w-px h-6 bg-[#DDDDDD] mx-1 shrink-0"></div>
        <button class="category-pill active" data-month="ALL">
          <span class="pill-icon">📅</span><span class="pill-label">All Months</span>
        </button>
        <button class="category-pill" data-month="08">
          <span class="pill-icon">☀️</span><span class="pill-label">August</span>
        </button>
        <button class="category-pill" data-month="09">
          <span class="pill-icon">🌧️</span><span class="pill-label">September</span>
        </button>
        <button class="category-pill" data-month="10">
          <span class="pill-icon">🍂</span><span class="pill-label">October</span>
        </button>
        <button class="category-pill" data-month="11">
          <span class="pill-icon">🪔</span><span class="pill-label">November</span>
        </button>
        <button class="category-pill" data-month="12">
          <span class="pill-icon">🎄</span><span class="pill-label">December</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <main class="flex-1">
    <div class="max-w-[1760px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-8">
      <div class="flex items-center justify-between mb-5">
        <p class="text-[14px] text-[#717171] font-medium" id="resultsCount">Loading vacation plans...</p>
        <div class="hidden sm:flex items-center gap-3 text-[11px] text-[#717171] font-semibold">
          <div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-[#008A05]"></span>Holiday</div>
          <div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-[#FF385C]"></span>PTO</div>
          <div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-[#00A699]"></span>Weekend</div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-8" id="vacationGrid"></div>
      <div class="hidden text-center py-20" id="emptyState">
        <div class="w-16 h-16 rounded-full bg-white border border-[#EBEBEB] flex items-center justify-center mx-auto mb-4">
          <span class="text-3xl">🏖️</span>
        </div>
        <h3 class="text-[17px] font-semibold text-[#222222] mb-1">No plans found</h3>
        <p class="text-[14px] text-[#717171]">Try adjusting your filters</p>
      </div>
    </div>
  </main>

  <!-- Calendar Modal -->
  <div id="calendarModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="modal-content bg-white rounded-3xl max-w-[680px] w-full shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <button type="button" id="btnCloseCalendarModal" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-[#F7F7F7] hover:bg-[#EBEBEB] flex items-center justify-center transition-colors z-10 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#222222]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <div class="px-6 sm:px-8 pt-6 sm:pt-8 pb-4">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#F7F7F7] border border-[#EBEBEB] text-[11px] font-bold text-[#717171] mb-3">
          <span>🗓️</span><span>Calendar View</span>
        </div>
        <h3 class="text-[20px] sm:text-[22px] font-bold text-[#222222] mb-1" id="calModalTitle">Calendar</h3>
        <p class="text-[13px] text-[#717171]" id="calModalDates">Dates</p>
      </div>
      <div id="calModalContent" class="grid grid-cols-1 md:grid-cols-2 gap-4 px-6 sm:px-8 mb-4"></div>
      <div class="mx-6 sm:mx-8 mb-6 sm:mb-8 py-3 px-4 bg-[#F7F7F7] rounded-2xl flex items-center justify-center gap-4 sm:gap-6 flex-wrap">
        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#008A05]"></span><span class="text-[12px] font-semibold text-[#222222]">Holiday</span></div>
        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#FF385C]"></span><span class="text-[12px] font-semibold text-[#222222]">PTO</span></div>
        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#00A699]"></span><span class="text-[12px] font-semibold text-[#222222]">Weekend</span></div>
      </div>
    </div>
  </div>

  <Footer />

  <style>
    .category-pill {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 16px; border: 1px solid #DDDDDD; border-radius: 12px;
      background: white; font-size: 12px; font-weight: 600; color: #717171;
      white-space: nowrap; cursor: pointer; transition: all 0.2s ease; flex-shrink: 0;
    }
    .category-pill:hover { border-color: #222222; color: #222222; }
    .category-pill.active { background: #222222; border-color: #222222; color: white; }
    .pill-icon { font-size: 16px; }
    .pill-label { font-size: 12px; font-weight: 600; }

    .listing-card {
      cursor: pointer; transition: all 0.25s ease;
      background: white; border-radius: 16px; overflow: hidden;
      border: 1px solid #EBEBEB;
    }
    .listing-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(0,0,0,0.12); }

    html.dark .listing-card { background: #1a1a1a; border-color: #333; }
    html.dark .listing-card:hover { box-shadow: 0 12px 28px rgba(0,0,0,0.4); }

    .card-visual {
      position: relative; padding: 20px 16px 16px;
      background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
    }
    html.dark .card-visual { background: linear-gradient(135deg, #2a2a2a 0%, #333 100%); }

    .card-heart {
      position: absolute; top: 12px; right: 12px; width: 30px; height: 30px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; z-index: 5; transition: transform 0.2s ease;
      background: rgba(0,0,0,0.04); border-radius: 50%;
    }
    html.dark .card-heart { background: rgba(255,255,255,0.1); }
    .card-heart:hover { transform: scale(1.15); background: rgba(0,0,0,0.08); }
    .card-heart svg { filter: drop-shadow(0 1px 3px rgba(0,0,0,0.15)); }

    .mini-calendar { display: flex !important; gap: 10px !important; width: 100% !important; flex-direction: row !important; }

    .mini-day {
      flex: 1 1 0% !important; min-width: 0 !important; border-radius: 14px; display: flex !important; flex-direction: column;
      align-items: center; justify-content: center; background: white;
      border: none; transition: all 0.15s ease;
      padding: 14px 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .mini-day .day-name { font-size: 10px; font-weight: 700; color: #717171; text-transform: uppercase; letter-spacing: 0.05em; }
    .mini-day .day-num { font-size: 20px; font-weight: 800; color: #222222; margin: 2px 0 0; }

    .card-info { padding: 14px 16px 16px; }

    .card-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
    .card-title { font-size: 15px; font-weight: 700; color: #222222; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
    .card-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; flex-shrink: 0; letter-spacing: 0.02em; }
    .card-badge.free { background: rgba(0, 138, 5, 0.1); color: #008A05; }
    .card-badge.paid { background: rgba(255, 56, 92, 0.1); color: #E31C5F; }
    .card-dates { font-size: 13px; color: #717171; margin-bottom: 6px; }
    .card-efficiency { font-size: 13px; color: #222222; font-weight: 600; }

    html.dark .card-title { color: #fafafa; }
    html.dark .card-dates { color: #999; }
    html.dark .card-efficiency { color: #e0e0e0; }
    html.dark .card-badge.free { background: rgba(0,138,5,0.2); color: #4ade80; }
    html.dark .card-badge.paid { background: rgba(255,56,92,0.2); color: #fb7185; }

    .mini-day-modal { aspect-ratio: 1; border-radius: 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: white; border: 1.5px solid #EBEBEB; }
    .mini-day-modal .day-name { font-size: 9px; font-weight: 700; color: #717171; text-transform: uppercase; }
    .mini-day-modal .day-num { font-size: 15px; font-weight: 800; color: #222222; margin: 1px 0; }
    .mini-day-modal.holiday { background: #008A05; border-color: #008A05; }
    .mini-day-modal.holiday .day-name, .mini-day-modal.holiday .day-num { color: white; }
    .mini-day-modal.weekend { background: #00A699; border-color: #00A699; }
    .mini-day-modal.weekend .day-name, .mini-day-modal.weekend .day-num { color: white; }
    .mini-day-modal.pto { background: #FF385C; border-color: #FF385C; }
    .mini-day-modal.pto .day-name, .mini-day-modal.pto .day-num { color: white; }
  </style>

  <script>
    import { solveVacationPlans, getTodayIso, type VacationPlan } from "../data/vacation-solver";

    interface State {
      selectedLeaves: number;
      selectedMonth: string;
      selectedRegion: string;
      workWeek: number;
    }

    const state: State = {
      selectedLeaves: 0,
      selectedMonth: "ALL",
      selectedRegion: "ALL",
      workWeek: 5,
    };

    function renderMonthGrid(year: number, monthIndex: number, daysMap: Map<string, any>) {
      const monthNames = ["January","February","March","April","May","June","July","August","September","October","November","December"];
      const firstDay = new Date(year, monthIndex, 1).getDay();
      const daysInMonth = new Date(year, monthIndex + 1, 0).getDate();
      const monOffset = (firstDay + 6) % 7;

      let cellsHtml = "";
      for (let i = 0; i < monOffset; i++) cellsHtml += `<div class="h-9"></div>`;

      for (let d = 1; d <= daysInMonth; d++) {
        const mm = String(monthIndex + 1).padStart(2, "0");
        const dd = String(d).padStart(2, "0");
        const iso = `${year}-${mm}-${dd}`;
        const dayOfWeek = new Date(year, monthIndex, d).getDay();
        const isNormalWeekend = dayOfWeek === 0 || dayOfWeek === 6;
        let cellClass = "text-[#B0B0B0] bg-transparent";
        let dotHtml = "";
        let tooltipText = "";

        if (daysMap.has(iso)) {
          const item = daysMap.get(iso);
          if (item.type === "holiday") {
            cellClass = "bg-[#008A05] text-white font-bold border-none";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-white/60 inline-block mt-0.5"></span>';
            tooltipText = item.label || "Holiday";
          } else if (item.type === "leave") {
            cellClass = "bg-[#FF385C] text-white font-bold border-none";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-white/60 inline-block mt-0.5"></span>';
            tooltipText = "Take PTO";
          } else if (item.type === "weekend") {
            cellClass = "bg-[#00A699] text-white font-bold border-none";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-white/60 inline-block mt-0.5"></span>';
            tooltipText = "Weekend";
          }
        } else if (isNormalWeekend) {
          cellClass = "text-[#717171] bg-[#F7F7F7] font-medium";
        }

        cellsHtml += `<div class="h-9 rounded-xl flex flex-col items-center justify-center text-xs transition-all relative group/calcell select-none ${cellClass}"><span>${d}</span>${dotHtml}${tooltipText ? `<div class="hidden group-hover/calcell:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-[#222222] text-white text-[10px] font-semibold rounded-lg shadow-lg whitespace-nowrap z-30 pointer-events-none">${tooltipText}</div>` : ""}</div>`;
      }

      return `<div class="bg-white border border-[#EBEBEB] rounded-2xl p-4"><div class="text-[12px] font-bold text-[#222222] text-center mb-3 pb-2 border-b border-[#EBEBEB]">${monthNames[monthIndex]} ${year}</div><div class="grid grid-cols-7 gap-1.5 text-center mb-2 text-[10px] font-bold text-[#B0B0B0] uppercase tracking-wider"><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span></div><div class="grid grid-cols-7 gap-1.5">${cellsHtml}</div></div>`;
    }

    function render() {
      const plans = solveVacationPlans({
        leaves: state.selectedLeaves,
        workWeek: state.workWeek,
        region: state.selectedRegion,
        month: state.selectedMonth,
        fromDate: getTodayIso(),
      });

      const grid = document.getElementById("vacationGrid");
      const emptyState = document.getElementById("emptyState");
      const resultsCount = document.getElementById("resultsCount");
      if (!grid || !emptyState || !resultsCount) return;

      if (plans.length === 0) {
        grid.classList.add("hidden");
        emptyState.classList.remove("hidden");
        resultsCount.textContent = "No plans found";
        return;
      }

      grid.classList.remove("hidden");
      emptyState.classList.add("hidden");
      resultsCount.textContent = `${plans.length} long weekend${plans.length > 1 ? "s" : ""} available`;

      grid.innerHTML = plans.map((plan, idx) => {
        let title = plan.title.split(":")[0].replace(/\(.*?\)/g, "").trim();
        if (!title && plan.days && plan.days.length > 0) {
          const hol = plan.days.find(d => d.type === "holiday");
          if (hol) title = hol.label;
        }

        const startDate = new Date(plan.startDate);
        const endDate = new Date(plan.endDate);
        const dateRange = `${startDate.toLocaleDateString("en-IN", { month: "short", day: "numeric" })} - ${endDate.toLocaleDateString("en-IN", { month: "short", day: "numeric" })}`;

        const miniDays = plan.days.map(d => {
          let bgColor = "#ffffff";
          let borderColor = "#EBEBEB";
          let textColor = "#222222";
          if (d.type === "holiday") { bgColor = "#008A05"; borderColor = "#008A05"; textColor = "#ffffff"; }
          else if (d.type === "weekend") { bgColor = "#00A699"; borderColor = "#00A699"; textColor = "#ffffff"; }
          else if (d.type === "leave") { bgColor = "#FF385C"; borderColor = "#FF385C"; textColor = "#ffffff"; }
          const date = new Date(d.date);
          const dayName = date.toLocaleDateString("en-US", { weekday: "short" });
          const dayNum = date.getDate();
          return `<div style="flex:1 1 0%;min-width:0;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:${bgColor};border:1.5px solid ${borderColor};padding:12px 4px;"><span style="font-size:9px;font-weight:700;color:${textColor};text-transform:uppercase;letter-spacing:0.02em;">${dayName}</span><span style="font-size:16px;font-weight:800;color:${textColor};margin:1px 0;">${dayNum}</span></div>`;
        }).join("");

        const dayCount = plan.days.length;

        const isFree = (plan.leavesRequired || 0) === 0;
        const badgeClass = isFree ? "free" : "paid";
        const badgeText = isFree ? "FREE" : `${plan.leavesRequired} PTO`;

        return `
          <div class="listing-card" data-plan-index="${idx}">
            <div class="card-visual">
              <div class="card-heart">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
              <div style="display:flex;gap:10px;width:100%;flex-direction:row;">${miniDays}</div>
            </div>
            <div class="card-info">
              <div class="card-header">
                <div class="card-title">${title || "Long Weekend"}</div>
                <span class="card-badge ${badgeClass}">${badgeText}</span>
              </div>
              <div class="card-dates">${dateRange}</div>
              <div class="card-efficiency"><strong>${plan.totalDaysOff} days off</strong> · ${plan.efficiencyMultiplier}</div>
            </div>
          </div>
        `;
      }).join("");

      document.querySelectorAll(".listing-card").forEach(card => {
        card.addEventListener("click", (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).dataset.planIndex || "0");
          openCalendarModal(plans[idx]);
        });
      });
    }

    function openCalendarModal(plan: VacationPlan) {
      const modal = document.getElementById("calendarModal");
      const title = document.getElementById("calModalTitle");
      const dates = document.getElementById("calModalDates");
      const content = document.getElementById("calModalContent");
      if (!modal || !title || !dates || !content) return;

      let planTitle = plan.title.split(":")[0].replace(/\(.*?\)/g, "").trim();
      if (!planTitle && plan.days && plan.days.length > 0) {
        const hol = plan.days.find(d => d.type === "holiday");
        if (hol) planTitle = hol.label;
      }

      title.textContent = planTitle || "Long Weekend";
      const startDate = new Date(plan.startDate);
      const endDate = new Date(plan.endDate);
      dates.textContent = `${startDate.toLocaleDateString("en-IN", { month: "long", day: "numeric", year: "numeric" })} - ${endDate.toLocaleDateString("en-IN", { month: "long", day: "numeric", year: "numeric" })}`;

      const daysMap = new Map();
      plan.days.forEach((d: any) => daysMap.set(d.date, d));

      const startYear = startDate.getFullYear();
      const startMonth = startDate.getMonth();
      const endYear = endDate.getFullYear();
      const endMonth = endDate.getMonth();

      let calendarHtml = "";
      if (startYear === endYear && startMonth === endMonth) {
        calendarHtml = renderMonthGrid(startYear, startMonth, daysMap);
      } else {
        calendarHtml = renderMonthGrid(startYear, startMonth, daysMap);
        calendarHtml += renderMonthGrid(endYear, endMonth, daysMap);
      }

      content.innerHTML = calendarHtml;
      modal.classList.remove("hidden");
    }

    function bindEvents() {
      document.querySelectorAll(".category-pill[data-leaves]").forEach(btn => {
        btn.addEventListener("click", () => {
          const leaves = parseInt((btn as HTMLElement).dataset.leaves || "0");
          state.selectedLeaves = leaves;
          document.querySelectorAll(".category-pill[data-leaves]").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          render();
        });
      });

      document.querySelectorAll(".category-pill[data-month]").forEach(btn => {
        btn.addEventListener("click", () => {
          const month = (btn as HTMLElement).dataset.month || "ALL";
          state.selectedMonth = month;
          document.querySelectorAll(".category-pill[data-month]").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          render();
        });
      });

      const regionSelect = document.getElementById("navRegionSelector") as HTMLSelectElement;
      if (regionSelect) {
        regionSelect.addEventListener("change", (e) => {
          state.selectedRegion = (e.target as HTMLSelectElement).value;
          render();
        });
      }

      const regionMobile = document.getElementById("navRegionSelectorMobile") as HTMLSelectElement;
      if (regionMobile) {
        regionMobile.addEventListener("change", (e) => {
          state.selectedRegion = (e.target as HTMLSelectElement).value;
          render();
        });
      }

      const btnWorkweek5 = document.getElementById("btnWorkweek5");
      const btnWorkweek6 = document.getElementById("btnWorkweek6");
      if (btnWorkweek5) {
        btnWorkweek5.addEventListener("click", () => { state.workWeek = 5; render(); });
      }
      if (btnWorkweek6) {
        btnWorkweek6.addEventListener("click", () => { state.workWeek = 6; render(); });
      }

      const calModal = document.getElementById("calendarModal");
      const btnClose = document.getElementById("btnCloseCalendarModal");
      if (calModal && btnClose) {
        btnClose.addEventListener("click", () => calModal.classList.add("hidden"));
        calModal.addEventListener("click", (e) => {
          if (e.target === calModal) calModal.classList.add("hidden");
        });
      }

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && calModal) calModal.classList.add("hidden");
      });
    }

    function init() {
      bindEvents();
      render();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  </script>

</body>
</html>
