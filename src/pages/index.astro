---
/**
 * Homepage: hero search, filter rail, results grid, calendar dialog, SEO prose.
 *
 * Rewritten onto Layout.astro. This page used to carry its own <html>, its own
 * copy of the font links and theme-init script, a second theme-toggle binding
 * that cancelled out the navbar's one, and ~125 lines of `!important` chip CSS
 * that duplicated (and contradicted) rules already in global.css.
 */
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import { getTodayIso, solveVacationPlans } from "../data/vacation-solver";
import { formatDateRange, getBannerTheme, pluralLeaves } from "../scripts/plan-view";

const TITLE =
  "Next Long Weekend 2026 – Leave Calculator India | The Long Weekends";
const DESCRIPTION =
  "Find the next long weekend in 2026 and calculate exact leaves needed to turn holidays into vacations. Plan smarter PTO for every upcoming long weekend.";

const MONTH_NAMES = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];

const today = getTodayIso();
const curYear = Number(today.slice(0, 4));
const curMonth = Number(today.slice(5, 7));

/**
 * The month rail used to be hardcoded to Aug–Dec, so it was wrong for seven
 * months of the year and would have been wrong for all of 2027. It is now
 * generated from today: this month to December, then January of next year,
 * which is as far as the bundled holiday data reaches.
 */
const monthTabs: { value: string; label: string; short: string }[] = [
  { value: "ALL", label: "All months", short: "All" },
];
for (let m = curMonth; m <= 12; m++) {
  monthTabs.push({
    value: String(m).padStart(2, "0"),
    label: MONTH_NAMES[m - 1],
    short: MONTH_NAMES[m - 1].slice(0, 3),
  });
}
if (curMonth > 1) {
  monthTabs.push({
    value: "01",
    label: `January ${curYear + 1}`,
    short: `Jan ${String(curYear + 1).slice(2)}`,
  });
}

/**
 * Server-rendered highlights.
 *
 * This section used to be six hand-written cards naming January 2026 as
 * "upcoming" — copy that went stale the moment January passed and that a
 * crawler read as the page's only real content, since the results grid is
 * rendered on the client. Deriving it from the solver makes it both accurate
 * and crawlable.
 */
const highlightPool = [
  ...solveVacationPlans({ leaves: 0, workWeek: 5, region: "ALL", fromDate: today }),
  ...solveVacationPlans({ leaves: 1, workWeek: 5, region: "ALL", fromDate: today }),
];
const seenFestival = new Set<string>();
const highlights = highlightPool
  .sort((a, b) => a.startDate.localeCompare(b.startDate))
  .filter((p) => {
    if (seenFestival.has(p.title)) return false;
    seenFestival.add(p.title);
    return true;
  })
  .slice(0, 6);

/**
 * One FAQ source feeding both the visible accordion and the JSON-LD. They had
 * drifted apart — Q1's schema answer ended with "Visit thelongweekends.com to
 * see the exact dates" while the visible answer said something else — and
 * Google requires the rendered answer to match the markup.
 */
const FAQ = [
  {
    q: "When is the next long weekend in 2026?",
    a: "The next long weekend depends on today's date. This tool automatically identifies the nearest upcoming long weekend from India's gazetted holidays and your weekend schedule, and names it in the badge at the top of the page along with how many leaves it costs.",
  },
  {
    q: "How many long weekends are there in 2026?",
    a: "For a standard 5-day work week, India has roughly 10 to 15 long weekend opportunities in 2026, depending on your region and which optional holidays your company observes. With 1 to 3 leave days per trip, many of them stretch into 4 to 9 day breaks.",
  },
  {
    q: "How does the long weekend calculator work?",
    a: "Pick your leave budget, your region, and your work week. The calculator cross-references gazetted public holidays against your weekends to find every bridge opportunity, then ranks them by value — the most days off for the fewest leaves used.",
  },
  {
    q: "Can I use this tool for my company's holiday list?",
    a: "Yes. Open the Company Holiday Optimizer and upload your office holiday PDF or image, or paste the text. It extracts your company's holidays and plans around those instead of the national list, so you only see breaks your office actually observes.",
  },
  {
    q: "Do I need to create an account to use this tool?",
    a: "No. The Long Weekends is free and needs no sign-up. Every calculation runs in your browser — nothing is uploaded and nothing is stored.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout title={TITLE} description={DESCRIPTION} path="/">
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />

  <Navbar />
  <Hero />

  <!-- ===================================================================
       Filter bar
       Sticky under the navbar. Both rows are real button groups with
       aria-pressed, so the current filter is announced rather than only
       painted. The old version used divs with click handlers.
       =================================================================== -->
  <section
    aria-label="Filter long weekends"
    class="sticky top-[4.25rem] z-40 border-b border-hairline bg-page/90 backdrop-blur-lg"
  >
    <div class="mx-auto flex max-w-[1280px] flex-col gap-2 px-4 py-3 sm:px-6">
      <div class="flex items-center gap-3">
        <span
          class="hidden shrink-0 font-mono text-[0.625rem] font-bold uppercase tracking-widest text-muted sm:block"
          aria-hidden="true">Budget</span
        >
        <div
          id="budgetRail"
          role="group"
          aria-label="Leave budget"
          class="rail min-w-0 py-0.5"
        >
          <button type="button" class="pill" data-leaves="0" aria-pressed="true">
            <span class="pill-glyph" aria-hidden="true">🆓</span>No leaves
          </button>
          <button type="button" class="pill" data-leaves="1" aria-pressed="false">
            <span class="pill-glyph" aria-hidden="true">🌴</span>1 leave
          </button>
          <button type="button" class="pill" data-leaves="2" aria-pressed="false">
            <span class="pill-glyph" aria-hidden="true">✈️</span>2 leaves
          </button>

          <!-- A <div role="group">, not a button: the +/- controls are buttons
               and nesting buttons is invalid HTML. Its selected look comes from
               `.is-on` rather than aria-pressed. -->
          <div
            id="customChipWrapper"
            role="group"
            aria-label="Custom number of leaves"
            class="pill pill-compound"
          >
            <button
              type="button"
              id="btnDecLeave"
              class="stepper-btn"
              aria-label="One leave fewer"><span aria-hidden="true">−</span></button
            >
            <button
              type="button"
              data-leaves="custom"
              class="flex items-baseline gap-1 px-0.5"
            >
              <span id="customLeavesDisplay" class="font-mono font-bold tabular">3</span>
              <span class="text-[0.6875rem] font-semibold opacity-80">leaves</span>
            </button>
            <button
              type="button"
              id="btnIncLeave"
              class="stepper-btn"
              aria-label="One leave more"><span aria-hidden="true">+</span></button
            >
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <span
          class="hidden shrink-0 font-mono text-[0.625rem] font-bold uppercase tracking-widest text-muted sm:block"
          aria-hidden="true">Month</span
        >
        <div class="relative min-w-0 grow">
          <span id="monthFadeL" class="rail-fade rail-fade-l" aria-hidden="true"></span>
          <span id="monthFadeR" class="rail-fade rail-fade-r" aria-hidden="true"></span>
          <div
            id="monthRail"
            role="group"
            aria-label="Filter by month"
            class="rail py-0.5"
          >
            {
              monthTabs.map((m) => (
                <button
                  type="button"
                  class="pill"
                  data-month={m.value}
                  aria-pressed={m.value === "ALL" ? "true" : "false"}
                >
                  <span class="sm:hidden">{m.short}</span>
                  <span class="hidden sm:inline">{m.label}</span>
                </button>
              ))
            }
          </div>
        </div>
        <div class="hidden shrink-0 items-center gap-1 sm:flex">
          <button
            type="button"
            id="monthRailPrev"
            class="btn-icon"
            hidden
            aria-label="Show earlier months"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg
            >
          </button>
          <button
            type="button"
            id="monthRailNext"
            class="btn-icon"
            aria-label="Show later months"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
            >
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       Results
       =================================================================== -->
  <main
    id="main"
    class="mx-auto w-full max-w-[1280px] grow px-4 py-8 sm:px-6 sm:py-10"
  >
    <div
      id="results"
      class="mb-5 flex flex-wrap items-end justify-between gap-4 scroll-mt-[12rem]"
    >
      <div aria-live="polite">
        <h2 class="text-xl font-extrabold sm:text-2xl">
          <span id="resultsBadge">Counting</span>
        </h2>
        <p id="resultsSubtext" class="mt-0.5 text-sm text-body"></p>
      </div>

      <div class="relative">
        <button
          type="button"
          id="sortTrigger"
          class="btn btn-ghost btn-sm"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="sortMenu"
        >
          <svg
            class="h-3.5 w-3.5 text-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 6h18M6 12h12M10 18h4"></path>
          </svg>
          <span class="text-muted">Sort</span>
          <span id="sortLabel">Best value</span>
          <svg
            class="seg-caret h-3 w-3 text-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>

        <div
          id="sortMenu"
          role="menu"
          aria-labelledby="sortTrigger"
          hidden
          class="popover absolute right-0 top-[calc(100%+0.5rem)] z-40 w-[15rem] p-2"
        >
          {
            [
              { v: "efficiency", label: "Best value", hint: "Most days off per leave" },
              { v: "days", label: "Longest break", hint: "Biggest total time off" },
              { v: "date", label: "Soonest first", hint: "Whatever is next" },
              { v: "cheapest", label: "Fewest leaves", hint: "Guard your balance" },
            ].map((o, i) => (
              <button
                type="button"
                role="menuitemradio"
                aria-checked={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="menu-item"
                data-sort={o.v}
                data-label={o.label}
              >
                <span class="min-w-0 grow">
                  <span class="block text-[0.8125rem] font-bold text-ink">{o.label}</span>
                  <span class="block text-xs text-muted">{o.hint}</span>
                </span>
                <svg
                  data-check
                  class:list={["h-4 w-4 shrink-0 text-brand-text", { hidden: i !== 0 }]}
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 13 4 4L19 7" />
                </svg>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Legend. The day ribbon on every card is the densest thing on the page,
         so it gets an explicit key rather than expecting colour to explain
         itself. Each entry names its state in words as well. -->
    <div
      class="mb-6 flex flex-wrap items-center gap-x-5 gap-y-2 rounded-control border border-hairline bg-surface-soft px-3.5 py-2.5"
    >
      <span class="font-mono text-[0.625rem] font-bold uppercase tracking-widest text-muted">
        Each strip reads
      </span>
      <span class="flex items-center gap-2 text-xs font-bold text-body">
        <span class="dot dot-holiday" aria-hidden="true"></span>Public holiday
      </span>
      <span class="flex items-center gap-2 text-xs font-bold text-body">
        <span class="dot dot-weekend" aria-hidden="true"></span>Weekend
      </span>
      <span class="flex items-center gap-2 text-xs font-bold text-body">
        <span class="dot dot-pto" aria-hidden="true"></span>Your leave (dashed)
      </span>
    </div>

    <div id="vacationGrid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>

    <!-- An empty result is a dead end unless it offers a way out, so the button
         is wired to whichever fix actually applies. -->
    <div id="emptyState" hidden class="card mx-auto max-w-lg p-8 text-center">
      <span class="mb-3 inline-block text-4xl" aria-hidden="true">🗓️</span>
      <h3 id="emptyStateTitle" class="text-lg font-extrabold">Nothing here yet</h3>
      <p id="emptyStateSub" class="mx-auto mt-1.5 max-w-sm text-sm text-body"></p>
      <button type="button" id="emptyStateAction" class="btn btn-brand btn-sm mt-5">
        Show every month
      </button>
    </div>
  </main>

  <!-- ===================================================================
       Calendar dialog
       =================================================================== -->
  <div id="calendarModal" class="dialog-backdrop" hidden>
    <div
      id="calendarDialog"
      class="dialog-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="calModalTitle"
      aria-describedby="calModalDates"
      tabindex="-1"
    >
      <header
        class="flex shrink-0 items-start justify-between gap-4 border-b border-hairline p-4 sm:p-5"
      >
        <div class="min-w-0">
          <h2 id="calModalTitle" class="text-base font-extrabold sm:text-lg">
            Calendar
          </h2>
          <p
            id="calModalDates"
            class="mt-0.5 font-mono text-xs font-semibold text-muted"
          >
          </p>
        </div>
        <button
          type="button"
          id="btnCloseCalendarModal"
          class="btn-icon shrink-0"
          aria-label="Close calendar"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
          >
        </button>
      </header>
      <div id="calModalContent" class="overflow-y-auto p-4 sm:p-5"></div>
    </div>
  </div>

  <!-- ===================================================================
       Reference content
       =================================================================== -->
  <section
    class="border-t border-hairline bg-surface px-4 py-16 sm:px-6 sm:py-20"
    aria-labelledby="reference-heading"
  >
    <div class="mx-auto max-w-[52rem]">
      <span class="tag tag-brand mb-4">🗓️ 2026 vacation planner</span>
      <h2
        id="reference-heading"
        class="mb-4 text-2xl font-extrabold sm:text-3xl lg:text-4xl"
      >
        When is the next long weekend?
      </h2>
      <div class="prose-body flex flex-col gap-4">
        <p>
          If you're wondering <strong>when the next long weekend is</strong>,
          you're in good company — it's among the most-searched questions by
          working professionals in India every month. The answer keeps moving as
          holidays pass and new ones approach, which is exactly why this page
          recalculates it instead of listing it.
        </p>
        <p>
          The calculator identifies the <strong>next long weekend</strong> from
          today's date, your country (India or the United States) and the
          official gazetted holiday list. Whether that's a three-day
          Saturday–Sunday–Monday or a nine-day stretch that bridges Diwali into
          a full week, every option is ranked by value: the most days off for the
          fewest leaves spent.
        </p>
      </div>

      <hr class="my-10 border-hairline" />

      <h2 class="mb-4 text-2xl font-extrabold sm:text-3xl">
        Long weekends still ahead
      </h2>
      <p class="prose-body mb-6">
        Generated from the gazetted list when this page was built, for a
        five-day work week with at most one leave day spent. Change the budget
        above to see the rest.
      </p>

      <ul class="flex flex-col divide-y divide-hairline border-y border-hairline">
        {
          highlights.map((plan) => {
            const theme = getBannerTheme(plan);
            return (
              <li class="flex items-center gap-4 py-3.5">
                <span class="text-xl shrink-0" aria-hidden="true">{theme.motif}</span>
                <span class="min-w-0 grow">
                  <span class="block truncate text-sm font-bold text-ink">
                    {plan.title}
                  </span>
                  <span class="block font-mono text-xs font-semibold text-muted tabular">
                    {formatDateRange(plan.startDate, plan.endDate)}
                  </span>
                </span>
                <span class="shrink-0 text-right">
                  <span class="block font-mono text-base font-bold text-ink tabular">
                    {plan.totalDaysOff}
                  </span>
                  <span class="block text-[0.625rem] font-bold uppercase tracking-wider text-muted">
                    days off
                  </span>
                </span>
                <span class="hidden shrink-0 sm:block">
                  {plan.leavesRequired === 0 ? (
                    <span class="tag tag-holiday">Free</span>
                  ) : (
                    <span class="tag tag-pto">{pluralLeaves(plan.leavesRequired)}</span>
                  )}
                </span>
              </li>
            );
          })
        }
      </ul>

      <hr class="my-10 border-hairline" />

      <h2 class="mb-4 text-2xl font-extrabold sm:text-3xl">
        How the calculator works
      </h2>
      <p class="prose-body mb-6">
        Three steps, in order — this one really is a sequence.
      </p>
      <ol class="flex flex-col gap-3">
        {
          [
            {
              t: "Set your leave budget",
              d: "Zero, one, two, or a custom number of days you're willing to spend on a single trip.",
            },
            {
              t: "Pick your region and work week",
              d: "India (pan-India IT) or the United States (federal), on a five- or six-day week.",
            },
            {
              t: "Read the strips",
              d: "Every card shows the exact dates, which days are free, and which ones cost you leave.",
            },
          ].map((step, i) => (
            <li class="flex items-start gap-3.5 rounded-card border border-hairline bg-surface-soft p-4">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-ink font-mono text-xs font-extrabold text-surface">
                {i + 1}
              </span>
              <span>
                <span class="block text-sm font-bold text-ink">{step.t}</span>
                <span class="mt-0.5 block text-xs text-body">{step.d}</span>
              </span>
            </li>
          ))
        }
      </ol>

      <hr class="my-10 border-hairline" />

      <h2 class="mb-4 text-2xl font-extrabold sm:text-3xl">
        Why this math is worth doing
      </h2>
      <div class="prose-body flex flex-col gap-4">
        <p>
          Most companies in India and the United States offer 15 to 24 paid
          leaves a year. That sounds generous until it has to cover sick days,
          emergencies and family obligations. What's left over is often barely a
          week of actual holiday.
        </p>
        <p>
          <strong>Long weekends change the arithmetic.</strong> Placing one to
          three leave days around holidays and weekends you already have unlocks
          four- to nine-day breaks without draining the balance. It isn't about
          working less — it's about where the days land.
        </p>
      </div>

      <div class="mt-14 border-t border-hairline pt-10">
        <span
          class="mb-1 block font-mono text-[0.625rem] font-bold uppercase tracking-widest text-brand-text"
          >Got questions?</span
        >
        <h2 class="mb-6 text-2xl font-extrabold sm:text-3xl">
          Frequently asked questions
        </h2>

        <div class="flex flex-col gap-3">
          {
            FAQ.map((item) => (
              <details class="group card p-5">
                <summary
                  class="flex cursor-pointer list-none items-center justify-between gap-4 text-[0.9375rem] font-bold text-ink"
                >
                  <span>{item.q}</span>
                  <svg
                    class="h-5 w-5 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="mt-4 border-t border-hairline pt-3 text-sm leading-relaxed text-body">
                  {item.a}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import {
    getTodayIso,
    buildCalendarMap,
    solveVacationPlans,
    type RegionCode,
  } from "../data/vacation-solver";
  import { mountResults } from "../scripts/results";

  // Region and work week live in the navbar; the results grid listens rather
  // than reaching into the navbar's DOM the way the old code did.
  let region: RegionCode = "ALL";
  let workWeek = 5;
  const today = getTodayIso();

  const results = mountResults({
    solve: (leaves) =>
      solveVacationPlans({ leaves, workWeek, region, month: "ALL", fromDate: today }),
    // Shades weekends and holidays outside the plan in the modal grid.
    calendar: () => buildCalendarMap(region, workWeek),
    todayIso: today,
  });

  function scrollToResults() {
    document.getElementById("results")?.scrollIntoView({
      behavior: "smooth",
      block: "start",
    });
  }

  document.addEventListener("lw:region", (e) => {
    region = (e as CustomEvent).detail.region as RegionCode;
    results?.refresh();
  });

  document.addEventListener("lw:workweek", (e) => {
    workWeek = (e as CustomEvent).detail.workWeek as number;
    results?.refresh();
  });

  // The hero capsule carries its own region and budget; pressing its button
  // pushes both here, and echoes the region back so the navbar agrees.
  document.addEventListener("lw:search", (e) => {
    const detail = (e as CustomEvent).detail as { region: RegionCode; leaves: number };
    region = detail.region;
    document.dispatchEvent(
      new CustomEvent("lw:setregion", { detail: { region } })
    );
    results?.setLeaves(detail.leaves);
    scrollToResults();
  });

  /** Applies ?region=/?leaves=/?month= — the shape the footer links use. */
  function applyParams(params: URLSearchParams) {
    const r = params.get("region");
    if (r === "ALL" || r === "USA") {
      region = r;
      document.dispatchEvent(new CustomEvent("lw:setregion", { detail: { region } }));
      results?.refresh();
    }

    const leaves = params.get("leaves");
    if (leaves !== null) results?.setLeaves(Number(leaves) || 0);

    // Driven by clicking the pill so there is exactly one code path for
    // changing month — and so a month with nothing in it stays inert.
    const month = params.get("month");
    if (month) {
      document
        .querySelector<HTMLButtonElement>(`#monthRail [data-month="${month}"]`)
        ?.click();
    }
  }

  applyParams(new URLSearchParams(window.location.search));

  // Footer links point at "/?leaves=2" and friends. On this page that is a
  // filter change, not a navigation, so handle it in place.
  document.querySelectorAll<HTMLAnchorElement>(".footer-filter-link").forEach((a) => {
    a.addEventListener("click", (e) => {
      const url = new URL(a.href, window.location.href);
      if (url.pathname !== window.location.pathname) return;
      e.preventDefault();
      window.history.replaceState(null, "", url.search || url.pathname);
      applyParams(url.searchParams);
      scrollToResults();
    });
  });
</script>
