---
/**
 * Company Holiday Optimizer.
 *
 * Rewritten onto Layout.astro + Navbar + the shared results controller. The old
 * version carried its own <html>, its own header (so this page had no theme
 * toggle at all), a second copy of the card and calendar markup that had
 * already drifted from the homepage's, and ~110 lines of hardcoded slate/
 * emerald/amber CSS that ignored the dark theme entirely.
 *
 * The page has two states. Until an office holiday list exists there is nothing
 * to plan around, so the filters and grid stay out of the DOM flow and a prompt
 * explains what to do. Once dates are detected the same filter rail and cards as
 * the homepage appear.
 */
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getTodayIso, CALENDAR_START, CALENDAR_END } from "../data/vacation-solver";

/* 75 characters before, so "Office Long Weekend Planner" was being cut off
   mid-phrase in results. Shortened to fit the ~60 a SERP actually shows, with
   both years in the part that survives. */
const TITLE = "Company Holiday Optimizer 2026 & 2027 – Office Leave Planner";
const DESCRIPTION =
  "Upload your company holiday list to find every long weekend your office actually observes in 2026 and 2027. Plan 0–3+ PTO days. Nothing leaves your browser.";

/**
 * pdf.js and tesseract.js, read by the page script as globals.
 *
 * Both are pinned to an exact version and carry an SRI hash; Layout renders
 * them with `crossorigin="anonymous"` so the hash is actually checked, and
 * `defer` so they no longer block first paint. See Layout's VendorScript.
 *
 * tesseract.js was previously requested as `@5` — a floating major, on the page
 * that reads people's uploaded holiday lists. jsDelivr resolves that to
 * whatever 5.x exists today, so the code running here could change without a
 * commit. 5.1.1 is what it resolved to when this was pinned.
 *
 * To change a version: fetch the new file and regenerate the hash with
 *   openssl dgst -sha384 -binary FILE | openssl base64 -A
 * A stale hash does not degrade — the browser refuses to run the script.
 *
 * Worth being precise about what this does and does not buy, because
 * privacy.astro documents it: SRI guarantees the *code* is the code we pinned.
 * It does not remove the third-party origin. The browser still contacts cdnjs
 * and jsDelivr on this page, and tesseract.js fetches its WASM core and English
 * model from a CDN at recognition time. Self-hosting all of that would mean
 * committing several megabytes of binaries, which is a repository decision
 * rather than a fix.
 */
/* Default for the manual date field. */
const today = getTodayIso();

const VENDOR_SCRIPTS = [
  {
    src: "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js",
    integrity: "sha384-/1qUCSGwTur9vjf/z9lmu/eCUYbpOTgSjmpbMQZ1/CtX2v/WcAIKqRv+U1DUCG6e",
  },
  {
    src: "https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js",
    integrity: "sha384-GJqSu7vueQ9qN0E9yLPb3Wtpd7OrgK8KmYzC8T1IysG1bcvxvIO4qtYR/D3A991F",
  },
];


---

<Layout
  title={TITLE}
  description={DESCRIPTION}
  path="/company-optimizer"
  vendorScripts={VENDOR_SCRIPTS}
>
  <Navbar />

  <!-- ===================================================================
       Upload
       =================================================================== -->
  <section class="relative overflow-hidden border-b border-hairline px-4 pb-12 pt-10 sm:px-6 sm:pb-14 sm:pt-12">
    <div
      class="pointer-events-none absolute -left-32 -top-40 h-[26rem] w-[26rem] rounded-full bg-brand/8 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto flex max-w-[52rem] flex-col items-center text-center">
      <span class="tag tag-brand mb-5">
        <span class="dot dot-holiday" aria-hidden="true"></span>
        Plans built from your own office list
      </span>

      <h1 class="mb-4 max-w-[40rem] text-[2rem] font-extrabold leading-[1.1] sm:text-[2.75rem]">
        Plan around <span class="text-brand-text">your office</span> holidays
      </h1>

      <p class="mb-9 max-w-[36rem] text-base leading-relaxed text-body sm:text-lg">
        Most companies observe their own list, not the full gazetted one. Upload
        it, paste it, or add dates by hand and we'll rebuild every long weekend
        around the days you actually get. Nothing leaves your browser.
      </p>

      <div class="panel w-full p-4 text-left sm:p-6">
        <!-- Two ways in. Real tabs: aria-selected carries the state and the
             panels are wired with aria-controls, so this is navigable by
             keyboard and announced correctly. -->
        <div
          id="inputTabs"
          role="tablist"
          aria-label="How to add your office holidays"
          class="tabs mx-auto mb-5 w-full sm:w-fit"
        >
          <button
            type="button"
            role="tab"
            id="tabUploadBtn"
            class="tab-btn"
            data-tab="tab-upload"
            aria-selected="true"
            aria-controls="tab-upload"
          >
            <span aria-hidden="true">📄</span> Upload a file
          </button>
          <button
            type="button"
            role="tab"
            id="tabTextBtn"
            class="tab-btn"
            data-tab="tab-text"
            aria-selected="false"
            tabindex="-1"
            aria-controls="tab-text"
          >
            <span aria-hidden="true">📝</span> Paste the list
          </button>
        </div>
        <div id="tab-upload" role="tabpanel" aria-labelledby="tabUploadBtn">
          <!-- A real <label> wrapping a real <input type="file">: the old
               version was a div with a click handler, so it could not be
               reached by Tab or activated from the keyboard at all. The input is
               nested rather than linked with `for`, because doing both makes
               some browsers open the file picker twice. -->
          <label id="dropZone" class="dropzone">
            <input
              type="file"
              id="fileUploadInput"
              accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.csv"
              class="sr-only"
            />
            <span class="mb-2 block text-3xl" aria-hidden="true">📥</span>
            <span id="dropZoneTitle" class="block text-sm font-bold text-ink">
              Choose a file, or drop one here
            </span>
            <span id="dropZoneSub" class="mt-1 block text-xs text-muted">
              PDF, screenshot, photo, or a plain text list — read on your device
            </span>

            <span
              id="uploadSpinner"
              hidden
              class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-2 rounded-card bg-surface/95 p-6 backdrop-blur-sm"
            >
              <span class="spinner" aria-hidden="true"></span>
              <span id="spinnerText" class="text-xs font-bold text-ink">
                Reading your holiday list…
              </span>
              <span id="spinnerSub" class="text-[0.6875rem] text-muted">
                This runs on your device, so it can take a moment
              </span>
            </span>
          </label>

          <p
            id="fileUploadStatus"
            hidden
            class="note note-ok mt-3"
            role="status"
            aria-live="polite"
          >
            <span aria-hidden="true">✓</span>
            <span id="fileUploadStatusText">Added your holidays</span>
          </p>
        </div>

        <div id="tab-text" role="tabpanel" aria-labelledby="tabTextBtn" hidden>
          <label for="companyTextPaste" class="mb-2 block text-xs font-bold text-ink">
            Paste your holiday list, or the email it came in
          </label>
          <textarea
            id="companyTextPaste"
            rows="6"
            placeholder={"1 Jan — New Year\n26 Jan 2026 — Republic Day\n4 March 2026 — Holi\n8–9 Nov — Diwali\n25 Dec 2026 — Christmas"}
            class="field font-mono text-xs leading-relaxed"></textarea>
          <p class="mt-2 text-xs text-muted">
            Dates are picked up as you type. Most formats work — 8 Nov, Nov 8th,
            08/11/2026, or a range like 8–9 Nov.
          </p>
        </div>

        <!-- Detected dates. Editable, because OCR gets things wrong and a plan
             built on a date the user never gets is worse than no plan. -->
        <div id="detectedDatesBox" hidden class="mt-5 border-t border-hairline pt-4">
          <div class="mb-2.5 flex flex-wrap items-center justify-between gap-2">
            <div class="min-w-0">
              <h2 class="flex items-center gap-2 text-sm font-bold text-ink">
                Your office holidays
                <span class="tag tag-holiday">
                  <span id="detectedCount">0</span> found
                </span>
              </h2>
              <p
                id="activeStatusPill"
                role="status"
                aria-live="polite"
                class="mt-0.5 text-xs text-muted"
              >
              </p>
            </div>
            <button type="button" id="btnClearDates" class="btn btn-ghost btn-sm">
              Clear all
            </button>
          </div>

          <p class="mb-2 text-xs text-muted">
            Remove anything that was read wrong — the plans below are built only
            from these days.
          </p>

          <div
            id="detectedPills"
            class="mb-3 flex max-h-36 flex-wrap gap-1.5 overflow-y-auto rounded-control border border-hairline bg-surface-soft p-2.5"
          >
          </div>

          <div class="flex flex-wrap items-end gap-2 border-t border-hairline pt-3">
            <div class="min-w-0">
              <label
                for="manualDateInput"
                class="mb-1 block font-mono text-[0.625rem] font-bold uppercase tracking-widest text-muted"
              >
                Missing one?
              </label>
              <input
                type="date"
                id="manualDateInput"
                min={CALENDAR_START}
                max={CALENDAR_END}
                value={today}
                class="field font-mono text-xs sm:w-[11rem]"
              />
            </div>
            <button type="button" id="btnAddManualDate" class="btn btn-ghost btn-sm">
              Add this date
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       Filter bar — mirrors the homepage exactly, including the ids the
       shared controller in scripts/results.ts binds to.
       =================================================================== -->
  <section
    id="budgetSection"
    hidden
    aria-label="Filter your office long weekends"
    class="sticky top-[4.25rem] z-40 border-b border-hairline bg-page/90 backdrop-blur-lg"
  >
    <div
      class="mx-auto flex max-w-[1280px] flex-col gap-1.5 px-4 py-2.5 sm:gap-2 sm:px-6 sm:py-3"
    >
      <div class="flex items-center gap-3">
        <span
          class="hidden shrink-0 font-mono text-[0.625rem] font-bold uppercase tracking-widest text-muted sm:block"
          aria-hidden="true">Budget</span
        >
        <div id="budgetRail" role="group" aria-label="Leave budget" class="rail min-w-0 py-0.5">
          <button type="button" class="pill" data-leaves="0" aria-pressed="true">
            <span class="pill-glyph" aria-hidden="true">🎁</span>No leaves
          </button>
          <button type="button" class="pill" data-leaves="1" aria-pressed="false">
            <span class="pill-glyph" aria-hidden="true">🌴</span>1 leave
          </button>
          <button type="button" class="pill" data-leaves="2" aria-pressed="false">
            <span class="pill-glyph" aria-hidden="true">✈️</span>2 leaves
          </button>

          <div
            id="customChipWrapper"
            role="group"
            aria-label="Custom number of leaves"
            class="pill pill-compound"
          >
            <button type="button" id="btnDecLeave" class="stepper-btn" aria-label="One leave fewer">
              <span aria-hidden="true">−</span>
            </button>
            <button type="button" data-leaves="custom" class="flex items-baseline gap-1 px-0.5">
              <span id="customLeavesDisplay" class="font-mono font-bold tabular">3</span>
              <span class="text-[0.6875rem] font-semibold opacity-80">leaves</span>
            </button>
            <button type="button" id="btnIncLeave" class="stepper-btn" aria-label="One leave more">
              <span aria-hidden="true">+</span>
            </button>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <span
          class="hidden shrink-0 font-mono text-[0.625rem] font-bold uppercase tracking-widest text-muted sm:block"
          aria-hidden="true">Month</span
        >
        <div class="relative min-w-0 grow">
          <span id="monthFadeL" class="rail-fade rail-fade-l" aria-hidden="true"></span>
          <span id="monthFadeR" class="rail-fade rail-fade-r" aria-hidden="true"></span>
          <div id="monthRail" role="group" aria-label="Filter by month" class="rail py-0.5">
            {/* Built on the client by mountResults() — see `monthRange` in
                scripts/results.ts. */}
          </div>
        </div>
        <div class="hidden shrink-0 items-center gap-1 sm:flex">
          <button
            type="button"
            id="monthRailPrev"
            class="btn-icon"
            hidden
            aria-label="Show earlier months"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg
            >
          </button>
          <button
            type="button"
            id="monthRailNext"
            class="btn-icon"
            aria-label="Show later months"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
            >
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       Results
       =================================================================== -->
  <main id="main" class="mx-auto w-full max-w-[1280px] grow px-4 py-8 sm:px-6 sm:py-10">
    <!-- Shown until an office list exists. Separate from the results empty
         state, which answers a different question ("no plans for this
         budget") and offers a different way out. -->
    <div id="noDatesPrompt" class="card mx-auto max-w-lg p-8 text-center">
      <span class="mb-3 inline-block text-4xl" aria-hidden="true">🏢</span>
      <h2 class="text-lg font-extrabold">No office holidays yet</h2>
      <p class="mx-auto mt-1.5 max-w-sm text-sm text-body">
        Add your list above and every long weekend your office actually gets
        will appear here, ranked by how much time off each leave day buys.
      </p>
      <p class="mt-5 text-xs text-muted">
        Only need the national list? <a
          href="/"
          class="font-bold text-brand-text underline">Use the main calendar</a
        >.
      </p>
    </div>

    <div id="gridSection" hidden>
      <div
        id="results"
        class="mb-5 flex flex-wrap items-end justify-between gap-3 scroll-mt-[12rem] sm:gap-4"
      >
        <div aria-live="polite" class="min-w-0">
          <h2 class="text-xl font-extrabold sm:text-2xl">
            <span id="resultsBadge">Counting</span>
          </h2>
          <p id="resultsSubtext" class="mt-0.5 text-sm text-body"></p>
        </div>

        <div class="relative">
          <button
            type="button"
            id="sortTrigger"
            class="btn btn-ghost btn-sm"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="sortMenu"
          >
            <svg
              class="h-3.5 w-3.5 text-muted"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 6h18M6 12h12M10 18h4"></path>
            </svg>
            <span class="text-muted">Sort</span>
            <span id="sortLabel">Soonest first</span>
            <svg
              class="seg-caret h-3 w-3 text-muted"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
            >
          </button>

          <div
            id="sortMenu"
            role="menu"
            aria-labelledby="sortTrigger"
            hidden
            class="popover popover-below absolute right-0 z-40 w-[15rem] p-2"
          >
            {
              /* Order matters: the first entry is marked checked below, so it
                 has to be DEFAULT_SORT in plan-view.ts. */
              [
                { v: "date", label: "Soonest first", hint: "Whatever is next" },
                { v: "days", label: "Longest break", hint: "Biggest total time off" },
              ].map((o, i) => (
                <button
                  type="button"
                  role="menuitemradio"
                  aria-checked={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  class="menu-item"
                  data-sort={o.v}
                  data-label={o.label}
                >
                  <span class="min-w-0 grow">
                    <span class="block text-[0.8125rem] font-bold text-ink">{o.label}</span>
                    <span class="block text-xs text-muted">{o.hint}</span>
                  </span>
                  <svg
                    data-check
                    class:list={["h-4 w-4 shrink-0 text-brand-text", { hidden: i !== 0 }]}
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m5 13 4 4L19 7" />
                  </svg>
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div
        class="mb-6 flex flex-wrap items-center gap-x-5 gap-y-2 rounded-control border border-hairline bg-surface-soft px-3.5 py-2.5"
      >
        <span class="font-mono text-[0.625rem] font-bold uppercase tracking-widest text-muted">
          Each strip reads
        </span>
        <span class="flex items-center gap-2 text-xs font-bold text-body">
          <span class="dot dot-holiday" aria-hidden="true"></span>Office holiday
        </span>
        <span class="flex items-center gap-2 text-xs font-bold text-body">
          <span class="dot dot-weekend" aria-hidden="true"></span>Weekend
        </span>
        <span class="flex items-center gap-2 text-xs font-bold text-body">
          <span class="dot dot-pto" aria-hidden="true"></span>Your leave (dashed)
        </span>
      </div>

      <div id="vacationGrid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>

      <div id="emptyState" hidden class="card mx-auto max-w-lg p-8 text-center">
        <span class="mb-3 inline-block text-4xl" aria-hidden="true">🗓️</span>
        <h3 id="emptyStateTitle" class="text-lg font-extrabold">Nothing here yet</h3>
        <p id="emptyStateSub" class="mx-auto mt-1.5 max-w-sm text-sm text-body"></p>
        <button type="button" id="emptyStateAction" class="btn btn-brand btn-sm mt-5">
          Show every month
        </button>
      </div>
    </div>
  </main>

  <!-- ===================================================================
       Calendar dialog
       =================================================================== -->
  <div id="calendarModal" class="dialog-backdrop" hidden>
    <div
      id="calendarDialog"
      class="dialog-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="calModalTitle"
      aria-describedby="calModalDates"
      tabindex="-1"
    >
      <header
        class="flex shrink-0 items-start justify-between gap-4 border-b border-hairline p-4 sm:p-5"
      >
        <div class="min-w-0">
          <h2 id="calModalTitle" class="text-base font-extrabold sm:text-lg">Calendar</h2>
          <p id="calModalDates" class="mt-0.5 font-mono text-xs font-semibold text-muted"></p>
        </div>
        <button
          type="button"
          id="btnCloseCalendarModal"
          class="btn-icon shrink-0"
          aria-label="Close calendar"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
          >
        </button>
      </header>
      <div id="calModalContent" class="overflow-y-auto p-4 sm:p-5"></div>
    </div>
  </div>

  <!-- ===================================================================
       Reference content
       =================================================================== -->
  <section
    class="border-t border-hairline bg-surface px-4 py-16 sm:px-6 sm:py-20"
    aria-labelledby="optimizer-reference"
  >
    <div class="mx-auto max-w-[52rem]">
      <span class="tag tag-brand mb-4">🏢 Office holiday planning</span>
      <h2 id="optimizer-reference" class="mb-4 text-2xl font-extrabold sm:text-3xl">
        Why your office list beats the national one
      </h2>
      <div class="prose-body flex flex-col gap-4">
        <p>
          India gazettes far more public holidays than any single employer
          observes. A typical company picks 10 to 14 of them and adds a couple of
          its own, which means a plan built on the national list will sometimes
          tell you to take a Monday off that your office was already closed for —
          or worse, that you have a free Friday when you're expected at your desk.
        </p>
        <p>
          <strong>So the uploaded list replaces the national one entirely</strong>,
          rather than merging with it. Every break below is built only from days
          you actually get, plus your weekends, plus the leave you choose to spend.
        </p>
      </div>

      <hr class="my-10 border-hairline" />

      <h2 class="mb-4 text-2xl font-extrabold sm:text-3xl">What you can upload</h2>
      <div class="prose-body flex flex-col gap-4">
        <p>
          The HR holiday circular as a PDF, a screenshot of the intranet page, a
          photo of the notice on the wall, the text of the email, or a CSV export.
          Text-based PDFs are read directly; scans, screenshots and photos go
          through optical character recognition. Both run inside your browser —
          the file is never sent anywhere, which is also why a large scan takes a
          few seconds.
        </p>
        <p>
          Recognition is imperfect, especially on coloured text and low-resolution
          screenshots, so every detected date is listed as a chip you can remove,
          and you can add anything that was missed by hand. It's worth a
          ten-second glance before you trust the plans.
        </p>
      </div>

      <hr class="my-10 border-hairline" />

      <h2 class="mb-4 text-2xl font-extrabold sm:text-3xl">
        Working a six-day week?
      </h2>
      <p class="prose-body">
        Set the workweek control to 6-day — it's in the bar at the top of this
        page — and everything recalculates with Sunday as your only weekly day
        off. Bridges get shorter and rarer, but the ones that survive are usually
        worth more per leave day spent.
      </p>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import {
    solveVacationPlans,
    buildCalendarMap,
    getTodayIso,
    getUpcomingCutoffIso,
    CALENDAR_START,
    CALENDAR_END,
  } from "../data/vacation-solver";
  import { mountResults, type ResultsHandle } from "../scripts/results";

  /* pdf.js and tesseract.js arrive as globals from the head. */
  declare const pdfjsLib: any;
  declare const Tesseract: any;

  /**
   * Point pdf.js at its worker, at the moment a PDF is actually opened.
   *
   * This ran at module scope behind a `typeof pdfjsLib !== "undefined"` guard,
   * which was safe only because the library was a blocking head script and had
   * therefore always finished by the time this module ran. Now that both vendor
   * scripts are deferred, that assumption is one ordering change away from
   * being wrong — and the failure would be silent: the guard would skip, the
   * worker would stay unset, and every PDF would fail with a message about the
   * file rather than about us.
   *
   * Called from the PDF branch instead, where the library is provably present.
   * The worker carries its own SRI-pinned version to match the main bundle;
   * pdf.js refuses to run a worker whose version does not match.
   */
  const PDF_WORKER_SRC =
    "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

  function ensurePdfWorker() {
    if (!pdfjsLib.GlobalWorkerOptions.workerSrc) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = PDF_WORKER_SRC;
    }
  }

  /* ======================================================================
     Reference data
     ====================================================================== */

  /** Named festivals, for lines that give a name but no usable date. */
  const FESTIVAL_DATE_MAP_2026: Record<string, string[]> = {
    "new year": ["2026-01-01"],
    "republic day": ["2026-01-26"],
    "maha shivratri": ["2026-02-16"],
    shivratri: ["2026-02-16"],
    holi: ["2026-03-04"],
    "eid-ul-fitr": ["2026-03-21"],
    "eid ul fitr": ["2026-03-21"],
    "eid-al-fitr": ["2026-03-21"],
    "id-ul-fitr": ["2026-03-21"],
    "mahavir jayanti": ["2026-03-31"],
    "good friday": ["2026-04-03"],
    "buddha purnima": ["2026-05-01"],
    "eid-al-adha": ["2026-05-27"],
    "eid-ul-adha": ["2026-05-27"],
    "eid ul adha": ["2026-05-27"],
    bakrid: ["2026-05-27"],
    muharram: ["2026-06-26"],
    "independence day": ["2026-08-15"],
    "raksha bandhan": ["2026-08-28"],
    rakhi: ["2026-08-28"],
    janmashtami: ["2026-09-04"],
    "gandhi jayanti": ["2026-10-02"],
    dussehra: ["2026-10-20"],
    vijayadashami: ["2026-10-20"],
    diwali: ["2026-11-08", "2026-11-09"],
    deepavali: ["2026-11-08", "2026-11-09"],
    "guru nanak": ["2026-11-24"],
    christmas: ["2026-12-25"],
    xmas: ["2026-12-25"],
  };

  /* Keyed on the first three letters, which is why the OCR misspellings all
     resolve: "augst" -> "aug", "septmber" -> "sep", and so on. */
  const MONTH_MAP: Record<string, string> = {
    jan: "01",
    feb: "02",
    mar: "03",
    apr: "04",
    may: "05",
    jun: "06",
    jul: "07",
    aug: "08",
    sep: "09",
    oct: "10",
    nov: "11",
    dec: "12",
  };

  const state = {
    workWeek: 5,
    customHolidays: [] as string[],
  };

  /* ======================================================================
     Date parsing
     ======================================================================
     The old version rewrote its own subject string in the middle of a
     `while (re.exec(...))` loop. A /g regex tracks `lastIndex` as an offset
     into the string it was handed, so editing that string mid-scan shifted
     every later match — dates were skipped, and occasionally re-counted.

     The fix is collect-then-blank: gather all matches up front with
     `matchAll`, then paint the consumed spans over with an equal-length run of
     spaces. Offsets stay valid, and later patterns still see intact word
     boundaries where earlier ones took a bite.
  */

  /** Replaces `len` characters at `start` with the same number of spaces. */
  function blank(text: string, start: number, len: number): string {
    return text.slice(0, start) + " ".repeat(len) + text.slice(start + len);
  }

  /**
   * Applies `re` to `text`. `onMatch` returns true if it actually used the
   * match, in which case that span is blanked so no later pattern reads it a
   * second time. Rejected matches stay visible on purpose — "Aug 40" fails the
   * range check here but should still be available to the single-date rules.
   */
  function consume(
    text: string,
    re: RegExp,
    onMatch: (m: RegExpMatchArray) => boolean
  ): string {
    let out = text;
    for (const m of Array.from(text.matchAll(re))) {
      if (m.index === undefined) continue;
      if (onMatch(m)) out = blank(out, m.index, m[0].length);
    }
    return out;
  }

  const inWindow = (iso: string) => iso >= CALENDAR_START && iso <= CALENDAR_END;

  /**
   * Pulls every date it can recognise out of arbitrary text — a pasted email,
   * a PDF text layer, or the output of OCR. Returns sorted ISO strings, and an
   * empty array when there is nothing to find. It never invents a date: a
   * fabricated holiday is worse than a missing one, because the user has no
   * reason to doubt it.
   */
  function parseUniversalDates(rawText: string): string[] {
    const datesSet = new Set<string>();
    if (!rawText || !rawText.trim()) return [];

    const cleanedFullText = rawText
      .replace(/[*#~|]/g, " ")
      .replace(/\r\n/g, "\n")
      .replace(/\t/g, " ");

    const lines = cleanedFullText.split(/[\r\n]+/);
    // Each line on its own, then the whole thing as one run: a table that OCR
    // flattened onto a single line still parses, and so does a date that got
    // split across two.
    const textChunks = [...lines, cleanedFullText.replace(/\n+/g, " ")];

    /* Month names, including the misspellings OCR reliably produces. */
    const mName =
      "(Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?" +
      "|Aug(?:ust|st)?|Sep(?:tember|tmber|t)?|Oct(?:ober|omber)?" +
      "|Nov(?:ember|mber)?|Dec(?:ember|mber)?)";
    const dPat = "(0?[1-9]|[12]\\d|3[01])(?:st|nd|rd|th)?";
    const yPat = "(202[6-7]|2[67])";
    /* Range separators. This used to be the character class `[-–—to]+`, which
       matches a lone "t" or "o" — so "Oct 2" parsed as a range. Spelled out as
       a non-capturing alternation, all the group numbers below are unchanged. */
    const sep = "\\s*(?:-{1,2}|–|—|to|thru|through|till|until)\\s*";
    const yTail = "(?:\\s*[,/\\s]\\s*" + yPat + ")?";

    const year = (raw: string | undefined) => {
      const y = raw || "2026";
      return y.length === 2 ? "20" + y : y;
    };
    const sameMonth = (a: string, b: string) =>
      a.slice(0, 3).toLowerCase() === b.slice(0, 3).toLowerCase();

    for (const chunk of textChunks) {
      let clean = chunk.replace(/\s+/g, " ").trim();
      if (!clean) continue;

      // Character-level OCR repairs, before anything is matched.
      clean = clean
        .replace(/\b2[oO]2[67]\b/g, "2026")
        .replace(/\b2[lI|]\b/g, "21")
        .replace(/\b2[sS]\b/g, "25");

      let foundDateInChunk = false;

      /** A span of consecutive days, e.g. the two days of Diwali. */
      const addRange = (
        startDay: number,
        endDay: number,
        monthKey: string,
        yyyy: string
      ): boolean => {
        const mm = MONTH_MAP[monthKey.slice(0, 3).toLowerCase()];
        // A "range" longer than a fortnight is far likelier to be two unrelated
        // numbers that happen to sit either side of a dash.
        if (!mm || startDay > endDay || endDay - startDay > 15) return false;
        for (let d = startDay; d <= endDay; d++) {
          datesSet.add(`${yyyy}-${mm}-${String(d).padStart(2, "0")}`);
        }
        foundDateInChunk = true;
        return true;
      };

      const addDate = (dd: string, monthKey: string, yyyy: string): boolean => {
        const mm = MONTH_MAP[monthKey.slice(0, 3).toLowerCase()];
        if (!mm) return false;
        datesSet.add(`${yyyy}-${mm}-${dd.padStart(2, "0")}`);
        foundDateInChunk = true;
        return true;
      };

      /* --- ranges first, so "8–9 Nov" is not read as two stray days ------- */

      // Month DD – Month DD YYYY
      clean = consume(
        clean,
        new RegExp(
          `\\b${mName}\\s+${dPat}${sep}${mName}\\s+${dPat}${yTail}\\b`,
          "gi"
        ),
        (m) =>
          sameMonth(m[1], m[3]) &&
          addRange(parseInt(m[2], 10), parseInt(m[4], 10), m[1], year(m[5]))
      );

      // Month DD – DD YYYY
      clean = consume(
        clean,
        new RegExp(`\\b${mName}\\s+${dPat}${sep}${dPat}${yTail}\\b`, "gi"),
        (m) => addRange(parseInt(m[2], 10), parseInt(m[3], 10), m[1], year(m[4]))
      );

      // DD Month – DD Month YYYY
      clean = consume(
        clean,
        new RegExp(
          `\\b${dPat}\\s+${mName}${sep}${dPat}\\s+${mName}${yTail}\\b`,
          "gi"
        ),
        (m) =>
          sameMonth(m[2], m[4]) &&
          addRange(parseInt(m[1], 10), parseInt(m[3], 10), m[2], year(m[5]))
      );

      // DD – DD Month YYYY
      clean = consume(
        clean,
        new RegExp(`\\b${dPat}${sep}${dPat}\\s+${mName}${yTail}\\b`, "gi"),
        (m) => addRange(parseInt(m[1], 10), parseInt(m[2], 10), m[3], year(m[4]))
      );

      /* --- then single dates --------------------------------------------- */

      // YYYY-MM-DD
      clean = consume(
        clean,
        /\b(202[6-7])[-/.](0?[1-9]|1[0-2])[-/.](0?[1-9]|[12]\d|3[01])\b/g,
        (m) => {
          datesSet.add(
            `${m[1]}-${m[2].padStart(2, "0")}-${m[3].padStart(2, "0")}`
          );
          foundDateInChunk = true;
          return true;
        }
      );

      // DD/MM/YYYY — day-first, which is how it is written in India.
      clean = consume(
        clean,
        /\b(0?[1-9]|[12]\d|3[01])[-/.](0?[1-9]|1[0-2])[-/.](202[6-7]|2[67])\b/g,
        (m) => {
          datesSet.add(
            `${year(m[3])}-${m[2].padStart(2, "0")}-${m[1].padStart(2, "0")}`
          );
          foundDateInChunk = true;
          return true;
        }
      );

      // DD Month YYYY
      clean = consume(
        clean,
        new RegExp(
          `\\b${dPat}\\s*[-/\\s,.]+\\s*${mName}\\b(?:\\s*[-/\\s,.]*\\s*${yPat})?`,
          "gi"
        ),
        (m) => addDate(m[1], m[2], year(m[3]))
      );

      // Month DD YYYY
      clean = consume(
        clean,
        new RegExp(
          `\\b${mName}\\s*[-/\\s,.]+\\s*${dPat}\\b(?:\\s*[,/\\s.]*\\s*${yPat})?`,
          "gi"
        ),
        (m) => addDate(m[2], m[1], year(m[3]))
      );

      /* --- named festivals, only where no date was found ------------------
         Guarded on `foundDateInChunk` so "Diwali — 20 Oct" trusts the date the
         employer printed rather than the almanac date for Diwali. */
      if (!foundDateInChunk) {
        const cleanLower = clean.toLowerCase();
        for (const [festName, dates] of Object.entries(FESTIVAL_DATE_MAP_2026)) {
          const re = new RegExp(`\\b${festName.replace(/-/g, "[- ]")}\\b`, "i");
          if (re.test(cleanLower)) dates.forEach((d) => datesSet.add(d));
        }
      }
    }

    // Anything outside the planning window cannot produce a plan, so it is
    // dropped rather than shown as a chip that quietly does nothing.
    return Array.from(datesSet).filter(inWindow).sort();
  }

  /* ======================================================================
     Detected-date chips
     ====================================================================== */
  const el = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;

  const DOW = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
  const MON = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
  ];

  /** Local, not UTC: `new Date(iso)` lands a day early west of Greenwich. */
  function formatChip(iso: string): string {
    const [y, m, d] = iso.split("-").map(Number);
    const dt = new Date(y, m - 1, d);
    return `${DOW[dt.getDay()]} ${d} ${MON[m - 1]}`;
  }

  function renderDetectedDates() {
    const box = el("detectedDatesBox");
    const pills = el("detectedPills");
    const count = el("detectedCount");
    const status = el("activeStatusPill");
    if (!box || !pills || !count) return;

    const dates = state.customHolidays;
    count.textContent = String(dates.length);
    box.hidden = dates.length === 0;
    if (status) {
      status.textContent =
        dates.length === 0
          ? ""
          : `Planning around ${dates.length} ${dates.length === 1 ? "day" : "days"}`;
    }
    if (dates.length === 0) {
      pills.innerHTML = "";
      return;
    }

    pills.innerHTML = dates
      .map(
        (d) => `<span class="date-chip">
          ${formatChip(d)}
          <button type="button" class="date-chip-x btn-remove-date" data-date="${d}"
            aria-label="Remove ${formatChip(d)}">
            <span aria-hidden="true">✕</span>
          </button>
        </span>`
      )
      .join("");

    pills.querySelectorAll<HTMLElement>(".btn-remove-date").forEach((btn) => {
      btn.addEventListener("click", () => {
        state.customHolidays = state.customHolidays.filter(
          (d) => d !== btn.dataset.date
        );
        commitDates();
      });
    });
  }

  /* ======================================================================
     Two-state page
     ====================================================================== */
  let results: ResultsHandle | null = null;

  /** Single funnel for every change to the office list. */
  function commitDates() {
    state.customHolidays = Array.from(new Set(state.customHolidays))
      .filter(inWindow)
      .sort();
    renderDetectedDates();
    syncSections();
    results?.refresh();
  }

  function syncSections() {
    const has = state.customHolidays.length > 0;
    const prompt = el("noDatesPrompt");
    const budget = el("budgetSection");
    const grid = el("gridSection");
    if (prompt) prompt.hidden = has;
    if (budget) budget.hidden = !has;
    if (grid) grid.hidden = !has;

    // The month rail measured itself while the section was still hidden, so
    // every width read back as zero and the overflow arrows stayed down. One
    // resize event is enough to make it measure again.
    if (has) window.dispatchEvent(new Event("resize"));
  }

  /* ======================================================================
     Input modes
     ====================================================================== */
  function initTabs() {
    const tablist = el("inputTabs");
    if (!tablist) return;
    const tabs = Array.from(
      tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')
    );

    const select = (tab: HTMLButtonElement, moveFocus: boolean) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.dataset.tab || "");
        if (panel) panel.hidden = !on;
      });
      if (moveFocus) tab.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab, false));
      tab.addEventListener("keydown", (e) => {
        const map: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        const next = map[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select(tabs[next], true);
      });
    });
  }

  /* ======================================================================
     File reading — all of it on-device
     ====================================================================== */

  /** Upscales, greys and thresholds an image so OCR has a fighting chance.
   *  Holiday circulars love low-contrast red text on cream, which Tesseract
   *  reads as noise until the red is pushed dark. */
  function preprocessImageForOcr(imageFile: File): Promise<HTMLCanvasElement> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      const url = URL.createObjectURL(imageFile);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement("canvas");
        let scale = 1;
        if (img.width < 1600) scale = 1600 / img.width;
        else if (img.width > 2600) scale = 2000 / img.width;
        canvas.width = Math.round(img.width * scale);
        canvas.height = Math.round(img.height * scale);

        const ctx = canvas.getContext("2d");
        if (!ctx) {
          resolve(canvas);
          return;
        }
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

        const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const data = imgData.data;
        for (let i = 0; i < data.length; i += 4) {
          const r = data[i];
          const g = data[i + 1];
          const b = data[i + 2];
          let gray = 0.299 * r + 0.587 * g + 0.114 * b;
          if (r > g + 40 && r > b + 40) gray = Math.max(0, gray - 50);
          const val = gray < 145 ? Math.max(0, gray * 0.5) : Math.min(255, gray * 1.3);
          data[i] = val;
          data[i + 1] = val;
          data[i + 2] = val;
        }
        ctx.putImageData(imgData, 0, 0);
        resolve(canvas);
      };
      img.onerror = reject;
      img.src = url;
    });
  }

  function setStatus(kind: "ok" | "warn", message: string) {
    const status = el("fileUploadStatus");
    const text = el("fileUploadStatusText");
    if (!status || !text) return;
    status.classList.toggle("note-ok", kind === "ok");
    status.classList.toggle("note-warn", kind === "warn");
    text.textContent = message;
    status.hidden = false;
  }

  function setBusy(busy: boolean, title = "", sub = "") {
    const spinner = el("uploadSpinner");
    const zone = el("dropZone");
    const input = el<HTMLInputElement>("fileUploadInput");
    if (spinner) spinner.hidden = !busy;
    if (zone) zone.setAttribute("aria-busy", String(busy));
    // Disabling the input while a file is being read stops a second drop from
    // interleaving with the first and mixing two lists together.
    if (input) input.disabled = busy;
    if (busy) {
      const t = el("spinnerText");
      const s = el("spinnerSub");
      if (t && title) t.textContent = title;
      if (s && sub) s.textContent = sub;
    }
  }

  /**
   * Updates the spinner's headline and, optionally, the line under it.
   *
   * The second argument is new. This used to write the headline only, so the
   * sub-line kept whatever setBusy() put there at the start — "Everything
   * happens on your device" — for the entire read, including the OCR pass.
   * That is the one step slow enough to need explaining: a scanned page takes
   * several seconds while the rest of the file goes by in milliseconds, and a
   * spinner that sits still with a privacy note under it reads as a hang.
   * Every call site now says what is happening AND why the wait is expected.
   */
  function progress(message: string, sub?: string) {
    const t = el("spinnerText");
    if (t) t.textContent = message;
    const s = el("spinnerSub");
    if (s && sub) s.textContent = sub;
  }

  async function handleCleanFileParsing(file: File) {
    setBusy(true, `Opening “${file.name}”…`, "Everything happens on your device");
    let text = "";

    try {
      const isPdf =
        file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf");

      if (isPdf) {
        // A blocked or failed CDN leaves the global undefined. Saying so beats
        // a TypeError surfacing as "could not read your file", which points the
        // reader at their own document.
        if (typeof pdfjsLib === "undefined") {
          throw new Error("pdf.js did not load");
        }
        ensurePdfWorker();
        progress("Reading your PDF…", "Everything happens on your device");
        const buffer = await file.arrayBuffer();
        const pdf = await pdfjsLib.getDocument({ data: new Uint8Array(buffer) })
          .promise;

        for (let n = 1; n <= pdf.numPages; n++) {
          progress(
            `Reading page ${n} of ${pdf.numPages}…`,
            "Everything happens on your device"
          );
          const page = await pdf.getPage(n);
          const content = await page.getTextContent();
          const pageText = content.items.map((i: any) => i.str).join(" ");
          text += "\n" + pageText;

          // A near-empty text layer means the page is a scan, not typed text.
          if (pageText.trim().length < 40 && typeof Tesseract !== "undefined") {
            progress(
              `Scanning page ${n} of ${pdf.numPages}…`,
              "This page is an image, so it takes a few seconds"
            );
            const viewport = page.getViewport({ scale: 1.8 });
            const canvas = document.createElement("canvas");
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            await page.render({
              canvasContext: canvas.getContext("2d"),
              viewport,
            }).promise;
            const ocr = await Tesseract.recognize(canvas, "eng");
            text += "\n" + ocr.data.text;
          }
        }
      } else if (file.type.startsWith("image/")) {
        // Same reasoning as the pdf.js guard above: an image is nothing but
        // pixels without OCR, so say the recogniser is missing rather than
        // implying the photo was unreadable.
        if (typeof Tesseract === "undefined") {
          throw new Error("tesseract.js did not load");
        }
        progress(
          "Scanning your image…",
          "Reading text from a picture takes a few seconds"
        );
        const canvas = await preprocessImageForOcr(file);
        const ocr = await Tesseract.recognize(canvas, "eng");
        text = ocr.data.text;
      } else {
        text = await file.text();
      }

      const dates = parseUniversalDates(text);
      state.customHolidays = dates;
      commitDates();

      if (dates.length > 0) {
        setStatus(
          "ok",
          `Found ${dates.length} ${dates.length === 1 ? "date" : "dates"} in “${file.name}”. Check them below — recognition is not perfect.`
        );
        el("detectedDatesBox")?.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
        });
      } else {
        setStatus(
          "warn",
          `Read “${file.name}” but found no dates. Paste the list as text, or add the dates by hand below.`
        );
      }
    } catch (err) {
      console.error("Could not read the uploaded file:", err);
      setStatus(
        "warn",
        `Could not read “${file.name}”. Try the paste tab, or add dates by hand below.`
      );
      commitDates();
    } finally {
      setBusy(false);
    }
  }

  function initUpload() {
    const zone = el("dropZone");
    const input = el<HTMLInputElement>("fileUploadInput");
    if (!zone || !input) return;

    input.addEventListener("change", () => {
      const file = input.files?.[0];
      if (file) handleCleanFileParsing(file);
      // Cleared so re-picking the same file still fires `change`.
      input.value = "";
    });

    // dragenter as well as dragover: the highlight should appear the moment the
    // pointer crosses the edge, not on the next mouse move.
    ["dragenter", "dragover"].forEach((evt) =>
      zone.addEventListener(evt, (e) => {
        e.preventDefault();
        zone.classList.add("is-dragging");
      })
    );
    ["dragleave", "dragend"].forEach((evt) =>
      zone.addEventListener(evt, () => zone.classList.remove("is-dragging"))
    );
    zone.addEventListener("drop", (e) => {
      e.preventDefault();
      zone.classList.remove("is-dragging");
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) handleCleanFileParsing(file);
    });
  }

  function initPaste() {
    const area = el<HTMLTextAreaElement>("companyTextPaste");
    if (!area) return;

    // Debounced: parsing runs over every line plus the whole blob, which is
    // wasteful on each keystroke of a long paste.
    let timer = 0;
    area.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        state.customHolidays = parseUniversalDates(area.value);
        commitDates();
      }, 250);
    });
  }

  function initManualDate() {
    const input = el<HTMLInputElement>("manualDateInput");
    const btn = el<HTMLButtonElement>("btnAddManualDate");
    if (!input || !btn) return;

    const add = () => {
      const value = input.value;
      if (!value) return;
      if (!inWindow(value)) {
        setStatus("warn", "That date is outside the 2026 planning window.");
        return;
      }
      if (state.customHolidays.includes(value)) {
        setStatus("ok", `${formatChip(value)} is already on your list.`);
        return;
      }
      state.customHolidays.push(value);
      commitDates();
      setStatus("ok", `Added ${formatChip(value)}.`);
    };

    btn.addEventListener("click", add);
    // Enter in a date field would otherwise do nothing at all here.
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        add();
      }
    });
  }

  function initClear() {
    el("btnClearDates")?.addEventListener("click", () => {
      state.customHolidays = [];
      const area = el<HTMLTextAreaElement>("companyTextPaste");
      if (area) area.value = "";
      const status = el("fileUploadStatus");
      if (status) status.hidden = true;
      commitDates();
      el("tabUploadBtn")?.focus();
    });
  }

  /* ======================================================================
     Mount
     ====================================================================== */
  function init() {
    // `today` marks the current day in the calendar grid; `cutoff` is what a
    // plan must start after to be offered. See getUpcomingCutoffIso().
    const today = getTodayIso();
    const cutoff = getUpcomingCutoffIso();

    initTabs();
    initUpload();
    initPaste();
    initManualDate();
    initClear();

    results = mountResults({
      // An empty list has to short-circuit: the solver treats a zero-length
      // customHolidays array as "no custom list given" and falls back to the
      // national one, which would fill this page with holidays the office may
      // not observe.
      solve: (leaves) =>
        state.customHolidays.length === 0
          ? []
          : solveVacationPlans({
              leaves,
              workWeek: state.workWeek,
              month: "ALL",
              fromDate: cutoff,
              customHolidays: state.customHolidays,
            }),
      calendar: () =>
        state.customHolidays.length === 0
          ? null
          : buildCalendarMap("ALL", state.workWeek, state.customHolidays),
      todayIso: today,
      monthRange: { from: cutoff.slice(0, 7), to: CALENDAR_END.slice(0, 7) },
    });

    document.addEventListener("lw:workweek", (e) => {
      state.workWeek = (e as CustomEvent<{ workWeek: number }>).detail.workWeek;
      results?.refresh();
    });

    renderDetectedDates();
    syncSections();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
