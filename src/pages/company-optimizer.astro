          }
        });
      }

      function preprocessImageForOcr(imageFile: File): Promise<HTMLCanvasElement> {
      return new Promise((resolve, reject) => {
        const img = new Image();
        const url = URL.createObjectURL(imageFile);
        img.onload = () => {
          URL.revokeObjectURL(url);
          const canvas = document.createElement("canvas");
          let scale = 1;
          if (img.width < 1600) {
            scale = 1600 / img.width;
          } else if (img.width > 2600) {
            scale = 2000 / img.width;
          }
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);

          const ctx = canvas.getContext("2d");
          if (!ctx) {
            resolve(canvas);
            return;
          }

          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

          // Enhance text contrast (especially for colored/red card text like Christmas, Eid)
          const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          const data = imgData.data;
          for (let i = 0; i < data.length; i += 4) {
            const r = data[i];
            const g = data[i + 1];
            const b = data[i + 2];
            
            // Standard luminance
            let gray = 0.299 * r + 0.587 * g + 0.114 * b;
            
            // Red-text enhancement: If pixel is predominantly red text on light background
            if (r > g + 40 && r > b + 40) {
              gray = Math.max(0, gray - 50); // darken red text
            }

            // High-contrast thresholding
            const val = gray < 145 ? Math.max(0, gray * 0.5) : Math.min(255, gray * 1.3);
            data[i] = val;
            data[i + 1] = val;
            data[i + 2] = val;
          }
          ctx.putImageData(imgData, 0, 0);
          resolve(canvas);
        };
        img.onerror = reject;
        img.src = url;
      });
    }

    async function handleCleanFileParsing(file: File) {
        if (!spinner || !spinnerText || !fileStatus || !fileStatusText) return;
        spinner.classList.remove("hidden");
        spinnerText.textContent = `Opening "${file.name}"...`;

        let fullExtractedText = "";

        try {
          if (file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf")) {
            spinnerText.textContent = "Reading your PDF document...";
            const arrayBuffer = await file.arrayBuffer();
            const pdf = await pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) }).promise;

            for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
              spinnerText.textContent = `Scanning page ${pageNum} of ${pdf.numPages}...`;
              const page = await pdf.getPage(pageNum);
              const textContent = await page.getTextContent();
              const pageStrings = textContent.items.map((item: any) => item.str).join(" ");
              fullExtractedText += "\n" + pageStrings;

              if (pageStrings.trim().length < 40 && typeof Tesseract !== "undefined") {
                spinnerText.textContent = `Reading holiday dates from page ${pageNum}...`;
                const viewport = page.getViewport({ scale: 1.8 });
                const canvas = document.createElement("canvas");
                canvas.width = viewport.width;
                canvas.height = viewport.height;
                const ctx = canvas.getContext("2d");
                await page.render({ canvasContext: ctx, viewport: viewport }).promise;
                
                const ocrResult = await Tesseract.recognize(canvas, "eng");
                fullExtractedText += "\n" + ocrResult.data.text;
              }
            }
          } else if (file.type.startsWith("image/")) {
            spinnerText.textContent = "Scanning your holiday image...";
            const preprocessedCanvas = await preprocessImageForOcr(file);
            const ocrResult = await Tesseract.recognize(preprocessedCanvas, "eng");
            fullExtractedText = ocrResult.data.text;
          } else {
            fullExtractedText = await file.text();
          }

          const dates = parseUniversalDates(fullExtractedText);
          state.customHolidays = dates;

          fileStatus.classList.remove("hidden");
          if (dates.length > 0) {
            fileStatusText.textContent = `Added ${dates.length} office holidays from "${file.name}"`;
          } else {
            fileStatusText.textContent = `Uploaded "${file.name}". No dates detected. Use "+ Add Date" below to add manually.`;
          }

          renderDetectedDates(dates);
          render();
          if (dates.length > 0) {
            setTimeout(() => {
              const box = document.getElementById("detectedDatesBox");
              if (box) {
                // Scroll specifically to the box so it aligns nicely with the header
                box.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }, 300); // Small delay to let Astro finish rendering the DOM
          }
        } catch (err: any) {
          console.error("Deep parsing error:", err);
          fileStatus.classList.remove("hidden");
          fileStatusText.textContent = `Could not read "${file.name}". You can paste your text or add dates manually.`;
          renderDetectedDates(state.customHolidays);
          render();
        } finally {
          spinner.classList.add("hidden");
        }
      }

      if (btnClear) {
        btnClear.addEventListener("click", () => {
          state.customHolidays = [];
          if (textArea) textArea.value = "";
          if (fileStatus) fileStatus.classList.add("hidden");
          renderDetectedDates([]);
          render();
        });
      }

      document.querySelectorAll(".chip-btn").forEach(chip => {
        if (chip.id === "customChipWrapper") return;
        chip.addEventListener("click", () => {
          document.querySelectorAll(".chip-btn").forEach(c => c.classList.remove("active"));
          chip.classList.add("active");
          state.selectedLeaves = parseInt((chip as HTMLElement).dataset.leaves || "0", 10);
          render();
        });
      });

      const customWrapper = document.getElementById("customChipWrapper");
      const customInput = document.getElementById("customLeavesInput") as HTMLInputElement;
      const customDisplay = document.getElementById("customLeavesDisplay");
      const btnInc = document.getElementById("btnIncLeave");
      const btnDec = document.getElementById("btnDecLeave");

      if (customWrapper && customInput && customDisplay) {
        customWrapper.addEventListener("click", () => {
          document.querySelectorAll(".chip-btn").forEach(c => c.classList.remove("active"));
          customWrapper.classList.add("active");
          state.selectedLeaves = Math.max(parseInt(customInput.value || "4", 10), 4);
          render();
        });
        if (btnInc) {
          btnInc.addEventListener("click", (e) => {
            e.stopPropagation();
            document.querySelectorAll(".chip-btn").forEach(c => c.classList.remove("active"));
            customWrapper.classList.add("active");
            let val = parseInt(customInput.value || "4", 10);
            if (val < 15) val += 1;
            customInput.value = String(val);
            customDisplay.textContent = String(val);
            state.selectedLeaves = val;
            render();
          });
        }
        if (btnDec) {
          btnDec.addEventListener("click", (e) => {
            e.stopPropagation();
            document.querySelectorAll(".chip-btn").forEach(c => c.classList.remove("active"));
            customWrapper.classList.add("active");
            let val = parseInt(customInput.value || "4", 10);
            if (val > 4) val -= 1;
            customInput.value = String(val);
            customDisplay.textContent = String(val);
            state.selectedLeaves = val;
            render();
          });
        }
      }

      document.querySelectorAll(".month-tab-btn").forEach(tab => {
        tab.addEventListener("click", () => {
          document.querySelectorAll(".month-tab-btn").forEach(t => t.classList.remove("active"));
          tab.classList.add("active");
          state.selectedMonth = (tab as HTMLElement).dataset.month || "ALL";
          render();
        });
      });

      // Calendar Modal bindings
      const calModal = document.getElementById("calendarModal");
      const btnCloseCal = document.getElementById("btnCloseCalendarModal");
      if (calModal && btnCloseCal) {
        btnCloseCal.addEventListener("click", () => calModal.classList.add("hidden"));
        calModal.addEventListener("click", (e) => {
          if (e.target === calModal) calModal.classList.add("hidden");
        });
      }

      // Escape key to dismiss modals
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          if (calModal) calModal.classList.add("hidden");
        }
      });
    }

    function formatDateRange(startStr: string, endStr: string) {
      const s = new Date(startStr + "T00:00:00");
      const e = new Date(endStr + "T00:00:00");
      return s.toLocaleDateString("en-IN", { day: "numeric", month: "short" }) + " – " + e.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
    }

    function renderMonthGrid(year: number, monthIndex: number, daysMap: Map<string, any>) {
      const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
      const firstDay = new Date(year, monthIndex, 1).getDay();
      const daysInMonth = new Date(year, monthIndex + 1, 0).getDate();
      const monOffset = (firstDay + 6) % 7;
      const monthTitle = `${monthNames[monthIndex]} ${year}`;

      let cellsHtml = "";
      for (let i = 0; i < monOffset; i++) {
        cellsHtml += `<div class="h-9"></div>`;
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const mm = String(monthIndex + 1).padStart(2, "0");
        const dd = String(d).padStart(2, "0");
        const iso = `${year}-${mm}-${dd}`;
        const dayOfWeek = new Date(year, monthIndex, d).getDay();
        const isNormalWeekend = dayOfWeek === 0 || dayOfWeek === 6;

        let cellStyle = "text-[#B0B0B0] bg-transparent";
        let dotHtml = "";
        let tooltipText = "";

        if (daysMap.has(iso)) {
          const item = daysMap.get(iso);
          if (item.type === "holiday") {
            cellStyle = "bg-[#008A05] text-white font-bold border-none";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-white/60 inline-block mt-0.5"></span>';
            tooltipText = item.label || "Company Holiday";
          } else if (item.type === "leave") {
            cellStyle = "bg-[#FF385C] text-white font-bold border-none";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-white/60 inline-block mt-0.5"></span>';
            tooltipText = "Apply PTO Leave";
          } else if (item.type === "weekend") {
            cellStyle = "bg-[#00A699] text-white font-bold border-none";
            dotHtml = '<span class="w-1.5 h-1.5 rounded-full bg-white/60 inline-block mt-0.5"></span>';
            tooltipText = "Weekend Off";
          }
        } else if (isNormalWeekend) {
          cellStyle = "text-[#717171] bg-[#F7F7F7] font-medium";
        }

        cellsHtml += `
          <div class="h-9 rounded-xl flex flex-col items-center justify-center text-xs transition-all relative group/calcell select-none ${cellStyle}">
            <span>${d}</span>
            ${dotHtml}
            ${tooltipText ? `
              <div class="hidden group-hover/calcell:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-[#222222] text-white text-[10px] font-semibold rounded-lg shadow-lg whitespace-nowrap z-30 pointer-events-none">
                ${tooltipText}
              </div>
            ` : ""}
          </div>
        `;
      }

      return `
        <div class="bg-white border border-[#EBEBEB] rounded-2xl p-4">
          <div class="text-[12px] font-bold text-[#222222] text-center mb-3 pb-2 border-b border-[#EBEBEB]">
            ${monthTitle}
          </div>
          <div class="grid grid-cols-7 gap-1.5 text-center mb-2 text-[10px] font-bold text-[#B0B0B0] uppercase tracking-wider">
            <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
          </div>
          <div class="grid grid-cols-7 gap-1.5">
            ${cellsHtml}
          </div>
        </div>
      `;
    }

    function openCalendarModal(plan: any) {
      const modal = document.getElementById("calendarModal");
      const mTitle = document.getElementById("calModalTitle");
      const mDates = document.getElementById("calModalDates");
      const mContent = document.getElementById("calModalContent");

      if (!modal || !mTitle || !mDates || !mContent) return;

      mTitle.textContent = plan.title;
      mDates.textContent = `🗓️ ${formatDateRange(plan.startDate, plan.endDate)} · ${plan.totalDaysOff} Consecutive Days Off`;

      const daysMap = new Map();
      plan.days.forEach((d: any) => daysMap.set(d.date, d));

      const startD = new Date(plan.startDate + "T00:00:00");
      const endD = new Date(plan.endDate + "T00:00:00");

      const startY = startD.getFullYear();
      const startM = startD.getMonth();
      const endY = endD.getFullYear();
      const endM = endD.getMonth();

      let calendarsHtml = "";
      if (startY === endY && startM === endM) {
        mContent.className = "grid grid-cols-1 max-w-sm mx-auto w-full gap-4 mb-6 px-6 sm:px-8";
        calendarsHtml = renderMonthGrid(startY, startM, daysMap);
      } else {
        mContent.className = "grid grid-cols-1 md:grid-cols-2 gap-4 px-6 sm:px-8 mb-6";
        calendarsHtml = renderMonthGrid(startY, startM, daysMap) + renderMonthGrid(endY, endM, daysMap);
      }

      mContent.innerHTML = calendarsHtml;
      modal.classList.remove("hidden");
    }

    function render() {
      const budgetSection = document.getElementById("budgetSection");
      const gridSection = document.getElementById("gridSection");
      
      if (!state.customHolidays || state.customHolidays.length === 0) {
        if (budgetSection) budgetSection.classList.add("hidden");
        if (gridSection) gridSection.classList.add("hidden");
      } else {
        if (budgetSection) budgetSection.classList.remove("hidden");
        if (gridSection) gridSection.classList.remove("hidden");
      }

      const grid = document.getElementById("vacationGrid");
      const empty = document.getElementById("emptyState");
      const badge = document.getElementById("resultsBadge");
      const subtext = document.getElementById("resultsSubtext");

      if (!state.customHolidays || state.customHolidays.length === 0) {
        if (grid) grid.innerHTML = "";
        if (empty) {
          empty.classList.remove("hidden");
          const emptyTitle = document.getElementById("emptyStateTitle");
          const emptySub = document.getElementById("emptyStateSub");
          if (emptyTitle) emptyTitle.textContent = "No Office Holidays Added Yet";
          if (emptySub) emptySub.textContent = "Simply upload or paste your office holiday schedule in the box above to see all your potential long weekends!";
        }
        if (badge) badge.textContent = "0 Plans";
        if (subtext) subtext.textContent = "Add your office holidays above to see your personalized long weekends";
        return;
      }

      const plans = solveVacationPlans({
        leaves: state.selectedLeaves,
        workWeek: state.workWeek,
        region: state.selectedRegion as any,
        month: state.selectedMonth,
        fromDate: CURRENT_DATE_REF,
        customHolidays: state.customHolidays
      });

      
      if (state.sortBy === "efficiency") {
        plans.sort((a, b) => {
          if (b.totalDaysOff !== a.totalDaysOff) return b.totalDaysOff - a.totalDaysOff;
          return a.startDate.localeCompare(b.startDate);
        });
      } else {
        plans.sort((a, b) => a.startDate.localeCompare(b.startDate));
      }
      state.currentPlans = plans;

      if (badge) badge.textContent = plans.length + (plans.length === 1 ? " Plan" : " Plans");
      if (subtext) subtext.textContent = "Showing options with " + state.selectedLeaves + (state.selectedLeaves === 1 ? " leave" : " leaves") + " using " + state.customHolidays.length + " office holidays";

      if (!grid || !empty) return;

      if (plans.length === 0) {
        grid.innerHTML = "";
        const empty = document.getElementById("emptyState");
        if(empty) empty.classList.remove("hidden");
        const emptyTitle = document.getElementById("emptyStateTitle");
        const emptySub = document.getElementById("emptyStateSub");
        if (emptyTitle) emptyTitle.textContent = "No Long Weekend Found for this Leave Budget";
        if (emptySub) emptySub.textContent = "Try selecting a different leave count (e.g. 1, 2, or 3 leaves) or check another month.";
        return;
      }

      empty.classList.add("hidden");

      grid.innerHTML = plans.map((plan, planIdx) => {
        const pillsHtml = plan.days.map((d) => {
          if (d.type === "holiday") {
            return `
              <div class="flex-1 min-w-[50px] rounded-xl py-1.5 px-2 flex flex-col items-center justify-center text-center transition-colors bg-[#008A05]/5 hover:bg-[#008A05]/10 text-[#008A05] border border-[#008A05]/20 hover:border-[#008A05]/30 group/day relative cursor-default select-none">
                <span class="text-[9px] font-bold uppercase tracking-wider text-[#008A05]">${d.dayName}</span>
                <span class="text-xs font-bold font-mono mt-0">${d.dayNum}</span>
                <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-[#008A05]/10 text-[#008A05] mt-1 truncate max-w-full">Holiday</span>
                <div class="hidden group-hover/day:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-[#222222] text-white text-[10px] font-medium rounded-lg shadow-lg whitespace-nowrap z-30 pointer-events-none">
                  ${d.label || "Company Holiday"}
                </div>
              </div>
            `;
          } else if (d.type === "weekend") {
            return `
              <div class="flex-1 min-w-[50px] rounded-xl py-1.5 px-2 flex flex-col items-center justify-center text-center transition-colors bg-[#00A699]/5 hover:bg-[#00A699]/10 text-[#00A699] border border-[#00A699]/20 hover:border-[#00A699]/30 group/day relative cursor-default select-none">
                <span class="text-[9px] font-bold uppercase tracking-wider text-[#00A699]">${d.dayName}</span>
                <span class="text-xs font-bold font-mono mt-0">${d.dayNum}</span>
                <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-[#00A699]/10 text-[#00A699] mt-1">Weekend</span>
                <div class="hidden group-hover/day:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-[#222222] text-white text-[10px] font-medium rounded-lg shadow-lg whitespace-nowrap z-30 pointer-events-none">
                  Weekly Weekend Off
                </div>
              </div>
            `;
          } else {
            return `
              <div class="flex-1 min-w-[50px] rounded-xl py-1.5 px-2 flex flex-col items-center justify-center text-center transition-colors bg-[#FF385C]/5 hover:bg-[#FF385C]/10 text-[#E31C5F] border border-[#FF385C]/20 hover:border-[#FF385C]/30 group/day relative cursor-default select-none">
                <span class="text-[9px] font-bold uppercase tracking-wider text-[#E31C5F]">${d.dayName}</span>
                <span class="text-xs font-bold font-mono mt-0">${d.dayNum}</span>
                <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded bg-[#FF385C]/10 text-[#E31C5F] mt-1 font-bold">Take PTO</span>
                <div class="hidden group-hover/day:block absolute bottom-full mb-1.5 left-1/2 -translate-x-1/2 px-2.5 py-1 bg-[#222222] text-white text-[10px] font-medium rounded-lg shadow-lg whitespace-nowrap z-30 pointer-events-none">
                  Apply 1 Day Leave (PTO)
                </div>
              </div>
            `;
          }
        }).join("");

        const topBadge = plan.leavesRequired === 0
          ? `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-[#008A05]/5 text-[#008A05] border border-[#008A05]/20">⚡ 0 Leaves Needed</span>`
          : `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-[#FF385C]/5 text-[#E31C5F] border border-[#FF385C]/20">🎯 ${plan.leavesRequired} ${plan.leavesRequired === 1 ? "Leave" : "Leaves"} Needed (${plan.efficiencyMultiplier})</span>`;

        let bottomBarHtml = "";
        if (plan.leavesRequired === 0) {
          bottomBarHtml = `
            <div class="bg-[#008A05]/5 border border-[#008A05]/20 rounded-xl p-2.5 flex items-center gap-2 mt-0.5">
              <span class="w-5 h-5 rounded-full bg-[#008A05] text-white flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
              <div class="text-xs font-medium text-[#008A05]">
                <span class="font-bold">Direct Weekend Bridge</span> · No PTO required
              </div>
            </div>
          `;
        } else {
          const leaveDays = plan.days.filter(d => d.type === "leave").map(d => `${d.dayName} ${d.dayNum}`).join(", ");
          bottomBarHtml = `
            <div class="bg-[#FF385C]/5 border border-[#FF385C]/20 rounded-xl p-2.5 flex items-center gap-2 mt-0.5">
              <span class="w-5 h-5 rounded-full bg-[#FF385C] text-white flex items-center justify-center text-[10px] font-bold shrink-0">🎯</span>
              <div class="text-xs font-medium text-[#E31C5F]">
                <span class="font-bold">Apply PTO:</span> <span class="underline decoration-[#FF385C]">${leaveDays}</span>
              </div>
            </div>
          `;
        }

        return `
          <div class="listing-card bg-white border border-[#EBEBEB] hover:border-[#DDDDDD] rounded-2xl p-4 shadow-sm hover:shadow-md transition-all flex flex-col justify-between gap-3 group relative">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                ${topBadge}
                
                <div class="flex items-center gap-1.5">
                  <span class="days-off-badge inline-flex items-center gap-1 text-[11px] font-bold text-[#E31C5F] bg-[#FF385C]/5 border border-[#FF385C]/20 px-2.5 py-0.5 rounded-full shadow-2xs">
                    🔥 ${plan.totalDaysOff} Days Off
                  </span>
                  <button 
                    type="button" 
                    class="btn-open-cal p-1.5 px-2 rounded-full text-xs font-semibold text-[#717171] bg-[#F7F7F7] hover:bg-[#EBEBEB] border border-[#EBEBEB] hover:border-[#DDDDDD] transition-all flex items-center justify-center cursor-pointer hover:scale-105 active:scale-95 shadow-2xs" 
                    title="View Month Calendar Grid"
                    data-idx="${planIdx}"
                  >
                    <span class="text-xs">🗓️</span>
                  </button>
                </div>
              </div>

              <h3 class="font-bold text-base text-[#222222] tracking-tight mb-1 group-hover:text-[#E31C5F] transition-colors">
                ${plan.title}
              </h3>
              <div class="text-xs font-semibold text-[#717171] flex items-center gap-1.5 mb-2.5">
                <span>🗓️</span>
                <span class="font-bold text-[#222222]">${formatDateRange(plan.startDate, plan.endDate)}</span>
                
              </div>

              <div class="flex w-full gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden py-1">
                ${pillsHtml}
              </div>
            </div>

            <div>
              ${bottomBarHtml}
            </div>
          </div>
        `;
      }).join("");

      document.querySelectorAll(".btn-open-cal").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const idx = parseInt((btn as HTMLElement).dataset.idx || "0", 10);
          const selectedPlan = state.currentPlans[idx];
          if (selectedPlan) {
            openCalendarModal(selectedPlan);
          }
        });
      });
    }

    document.addEventListener("DOMContentLoaded", init);
  </script>
</body>
</html>