---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Company Holiday Leave Optimizer — The Long Weekends (2026)</title>
  <meta name="description" content="Upload your company's holiday PDF, image or text to generate a 100% personalized 0, 1, 2, 3+ leave budget dashboard." />
  
  <!-- SEO & Open Graph Tags -->
  <link rel="canonical" href="https://thelongweekends.com/company-optimizer" />
  <meta property="og:title" content="Custom Office Holiday Optimizer | The Long Weekends" />
  <meta property="og:description" content="Upload your company's holiday PDF, image or text to generate a 100% personalized 0, 1, 2, 3+ leave budget dashboard." />
  <meta property="og:url" content="https://thelongweekends.com/company-optimizer" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://thelongweekends.com/og-image.jpg" />
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Custom Office Holiday Optimizer | The Long Weekends" />
  <meta name="twitter:description" content="Upload your company's holiday PDF, image or text to generate a 100% personalized 0, 1, 2, 3+ leave budget dashboard." />
  <meta name="twitter:image" content="https://thelongweekends.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>

</head>
<body class="bg-[#F7F7F7] text-[#222222] font-sans antialiased min-h-screen flex flex-col">

  <!-- Header with Navigation Back to National Calendar -->
  <header class="sticky top-0 z-50 bg-white border-b border-[#EBEBEB]">
    <div class="max-w-[1760px] mx-auto px-4 sm:px-6 lg:px-10">
      <div class="flex items-center justify-between h-[80px]">
        <a href="/" class="flex items-center gap-2 group no-underline shrink-0">
          <div class="w-10 h-10 bg-gradient-to-br from-[#FF385C] to-[#E31C5F] rounded-xl flex items-center justify-center shadow-sm group-hover:shadow-md transition-shadow">
            <span class="text-white font-extrabold text-sm">LW</span>
          </div>
          <div class="hidden sm:flex flex-col">
            <span class="font-extrabold text-[17px] tracking-tight text-[#222222] whitespace-nowrap">
              The Long Weekends
            </span>
          </div>
        </a>

        <div class="flex items-center gap-3">
          <a 
            href="/" 
            class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full border border-[#DDDDDD] hover:border-[#222222] text-[#222222] text-[12px] font-semibold transition-all no-underline bg-white hover:bg-[#F7F7F7]"
          >
            <span class="hidden sm:inline">Back to National Calendar</span><span class="sm:hidden">← Calendar</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Hero Section & Multi-Format Ingestion Uploader -->
  <section class="py-10 sm:py-14 px-4 sm:px-6 border-b border-[#EBEBEB] bg-white">
    <div class="max-w-[960px] mx-auto flex flex-col items-center text-center">

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#F7F7F7] border border-[#EBEBEB] text-[11px] font-bold text-[#717171] mb-5">
        <span class="w-2 h-2 rounded-full bg-[#008A05] animate-pulse"></span>
        <span>Custom Vacation Planner for Your Office</span>
      </div>

      <h1 class="text-[28px] leading-tight sm:text-5xl font-extrabold text-[#222222] tracking-tight leading-[1.15] max-w-[850px] mb-3">
        Add Your Office Holidays
      </h1>
      <p class="text-base sm:text-lg text-[#717171] max-w-[720px] mb-8 leading-relaxed font-medium">
        Upload your office holiday list, screenshot, or PDF below. We will automatically find the best long weekends and guilt-free mini vacations tailored just for your team!
      </p>

      <div class="bg-white border border-[#EBEBEB] rounded-2xl p-6 shadow-sm w-full max-w-[950px] text-left">
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-2 p-1.5 bg-[#F7F7F7] border border-[#EBEBEB] rounded-full mb-6 w-full sm:w-fit mx-auto">
          <button type="button" class="tab-btn active w-full sm:w-auto text-center" data-tab="tab-upload">📄 Upload Document / Screenshot</button>
          <button type="button" class="tab-btn w-full sm:w-auto text-center" data-tab="tab-text">📝 Paste Holiday List / Email</button>
        </div>

        <div id="tab-upload" class="tab-content active">
          <div id="dropZone" class="border-2 border-dashed border-[#DDDDDD] hover:border-[#222222] rounded-2xl p-6 sm:p-8 text-center cursor-pointer transition-all bg-[#F7F7F7] hover:bg-white relative">
            <input type="file" id="fileUploadInput" accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.csv" class="hidden" />
            <div class="text-4xl mb-3" id="dropZoneIcon">📁</div>
            <div class="text-sm font-bold text-[#222222] mb-1" id="dropZoneTitle">Click to Upload PDF or Drop a Screenshot</div>
            <div class="text-xs text-[#717171]" id="dropZoneSub">Supports PDF documents, screenshots, or photos of your holiday list</div>
            
            <div id="uploadSpinner" class="hidden absolute inset-0 bg-white/95 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center p-6 z-10">
              <div class="w-8 h-8 border-3 border-[#222222] border-t-transparent rounded-full animate-spin mb-3"></div>
              <div class="text-xs font-bold text-[#222222]" id="spinnerText">Reading your holiday list...</div>
              <div class="text-[10px] text-[#717171] mt-1" id="spinnerSub">Finding your vacation dates...</div>
            </div>
          </div>

          <div id="fileUploadStatus" class="hidden mt-3 p-3 bg-[#F0FFF4] border border-[#008A05]/20 rounded-xl text-xs text-[#008A05] font-semibold flex items-center gap-2">
            <span class="w-4 h-4 rounded-full bg-[#008A05] text-white flex items-center justify-center text-[9px] font-bold shrink-0">✓</span>
            <span id="fileUploadStatusText">Added holidays successfully!</span>
          </div>
        </div>

        <div id="tab-text" class="tab-content hidden">
          <textarea 
            id="companyTextPaste" 
            rows="5" 
            placeholder="Paste your company holiday list, email or table here...&#10;e.g.&#10;01st Jan - New Year&#10;26 Jan 2026 - Republic Day&#10;4 March 2026 - Holi&#10;8th-9th Nov - Diwali&#10;25 Dec 2026 - Christmas" 
            class="w-full bg-white border border-[#EBEBEB] rounded-xl p-4 text-xs text-[#222222] font-mono outline-none focus:border-[#222222] shadow-inner"
          ></textarea>
        </div>

        <div id="detectedDatesBox" class="mt-5 pt-4 border-t border-[#EBEBEB] hidden">
          <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-[#222222]">Active Office Holidays (<span id="detectedCount">0</span>):</span>
              <span class="text-[10px] text-[#008A05] bg-[#008A05]/10 font-bold px-2 py-0.5 rounded-full" id="activeStatusPill">Active</span>
            </div>
            <button type="button" id="btnClearDates" class="text-xs text-[#E31C5F] hover:underline font-semibold cursor-pointer">Clear All Dates</button>
          </div>
          
          <div id="detectedPills" class="flex flex-wrap gap-1.5 max-h-36 overflow-y-auto p-2.5 bg-white rounded-xl border border-[#EBEBEB] mb-3"></div>

          <div class="flex items-center gap-2 pt-2 border-t border-[#EBEBEB]">
            <span class="text-[11px] font-semibold text-[#717171] shrink-0">+ Add Date:</span>
            <input type="date" id="manualDateInput" min="2026-01-01" max="2027-01-10" value="2026-01-01" class="bg-white border border-[#DDDDDD] text-[#222222] text-xs font-mono px-2.5 py-1 rounded-md outline-none" />
            <button type="button" id="btnAddManualDate" class="px-3 py-1 bg-[#222222] hover:bg-[#171717] text-white text-xs font-bold rounded-md cursor-pointer transition-all">+ Add Date</button>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Interactive Leave Budget Selector (Favorite Layout) -->
  <section class="py-5 px-4 sm:px-6 bg-white border-b border-[#EBEBEB] hidden" id="budgetSection">
    <div class="max-w-[1760px] mx-auto">
      
      <!-- Filter Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-2">
        <div class="flex items-center gap-2">
          <span class="text-base">🎯</span>
          <span class="font-bold text-sm text-[#222222]">Select Your Leave Budget</span>
        </div>
        
        <!-- Month Tabs (Moved to Header Row) -->
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar" id="monthTabsContainer">
          <button type="button" class="month-tab-btn active" data-month="ALL">All</button>
          <button type="button" class="month-tab-btn" data-month="08">Aug</button>
          <button type="button" class="month-tab-btn" data-month="09">Sep</button>
          <button type="button" class="month-tab-btn" data-month="10">Oct</button>
          <button type="button" class="month-tab-btn" data-month="11">Nov</button>
          <button type="button" class="month-tab-btn" data-month="12">Dec</button>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-6" id="budgetChipsContainer">
        <button type="button" class="chip-btn active" data-leaves="0">
          <span class="chip-title">0 Leaves</span>
          <span class="chip-desc">Free 3-Day Breaks</span>
        </button>
        <button type="button" class="chip-btn" data-leaves="1">
          <span class="chip-title">1 Leave</span>
          <span class="chip-desc">Smart 4-Day Bridge</span>
        </button>
        <button type="button" class="chip-btn" data-leaves="2">
          <span class="chip-title">2 Leaves</span>
          <span class="chip-desc">5-6 Day Vacations</span>
        </button>
        <button type="button" class="chip-btn" data-leaves="3">
          <span class="chip-title">3 Leaves</span>
          <span class="chip-desc">6+ Day Festival</span>
        </button>
        
        <div class="chip-btn custom-chip" id="customChipWrapper">
          <div class="flex items-center justify-between w-full">
            <span class="chip-title">Custom</span>
            <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#FF385C]/10 text-[#E31C5F] border border-[#FF385C]/20">4+ PTO</span>
          </div>
          <div class="stepper-box flex items-center justify-between w-full mt-1 bg-[#F7F7F7] border border-[#EBEBEB] rounded-lg px-2 py-0.5 transition-colors">
            <button type="button" id="btnDecLeave" class="stepper-btn font-bold text-xs hover:text-[#222222] cursor-pointer select-none text-[#717171]">−</button>
            <span class="stepper-val text-xs font-mono font-bold text-[#222222] select-none"><span id="customLeavesDisplay">4</span> Leaves</span>
            <input type="hidden" id="customLeavesInput" value="4" />
            <button type="button" id="btnIncLeave" class="stepper-btn font-bold text-xs hover:text-[#222222] cursor-pointer select-none text-[#717171]">+</button>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Vacation Grid / Empty Prompt Section -->
  <main class="flex-1 py-8 sm:py-10 px-4 sm:px-6 max-w-[1760px] mx-auto w-full hidden" id="gridSection">
    
    <div class="flex items-center justify-between gap-4 mb-6 flex-wrap">
      <div class="flex items-center gap-3">
        <span class="font-mono text-xs font-bold px-3 py-1 bg-[#222222] text-white rounded-full" id="resultsBadge">0 Plans</span>
        <span class="text-xs text-[#717171] font-medium" id="resultsSubtext">Showing options with 0 leaves</span>
        
        <!-- Custom Premium Dropdown -->
        <div class="relative w-full sm:w-[240px]" id="customSortDropdown">
          <button type="button" id="sortDropdownBtn" class="flex items-center justify-between w-full bg-white hover:bg-[#F7F7F7] border border-[#DDDDDD] text-[#717171] hover:text-[#222222] text-[11px] sm:text-xs font-bold rounded-full px-4 py-2 outline-none focus:border-[#222222] focus:ring-4 focus:ring-[#F7F7F7] transition-all shadow-sm">
            <span id="sortDropdownLabel">Sort: Highest Efficiency</span>
            <svg class="w-3.5 h-3.5 text-[#B0B0B0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <!-- Menu (Hidden by default) -->
          <div id="sortDropdownMenu" class="absolute right-0 mt-2 w-full bg-white border border-[#EBEBEB] rounded-xl shadow-xl overflow-hidden z-50 transition-all duration-200 opacity-0 scale-95 origin-top-right pointer-events-none hidden">
            <div class="py-1 flex flex-col">
              <button type="button" class="sort-option w-full text-left px-4 py-3 text-xs font-bold text-[#717171] hover:bg-[#F7F7F7] hover:text-[#222222] transition-colors flex items-center justify-between" data-value="efficiency">
                Highest Efficiency
                <svg class="w-4 h-4 text-[#008A05] check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              </button>
              <button type="button" class="sort-option w-full text-left px-4 py-3 text-xs font-bold text-[#717171] hover:bg-[#F7F7F7] hover:text-[#222222] transition-colors flex items-center justify-between" data-value="date">
                Chronological (Dates)
                <svg class="w-4 h-4 text-[#008A05] hidden check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-4 text-xs text-[#717171] font-semibold">
        <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#008A05]"></span><span>Holiday</span></div>
        <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#FF385C]"></span><span>PTO</span></div>
        <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#00A699]"></span><span>Weekend</span></div>
      </div>
    </div>

    <!-- Live Grid (Shown ONLY when company dates exist) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="vacationGrid"></div>

    <!-- Empty State -->
    <div class="text-center py-20 px-4 sm:px-6 bg-white border border-[#EBEBEB] rounded-2xl shadow-sm" id="emptyState">
      <div class="w-16 h-16 rounded-full bg-[#F7F7F7] border border-[#EBEBEB] flex items-center justify-center mx-auto mb-4">
        <span class="text-3xl">🏢</span>
      </div>
      <h3 class="font-semibold text-[17px] text-[#222222] mb-1" id="emptyStateTitle">No Office Holidays Added Yet</h3>
      <p class="text-[14px] text-[#717171] max-w-md mx-auto leading-relaxed" id="emptyStateSub">
        Simply upload or paste your office holiday schedule in the box above to see all your potential long weekends!
      </p>
    </div>

  </main>

  <!-- Interactive Calendar View Modal / Popover -->
  <div id="calendarModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="modal-content bg-white rounded-3xl max-w-[680px] w-full shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <button type="button" id="btnCloseCalendarModal" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-[#F7F7F7] hover:bg-[#EBEBEB] flex items-center justify-center transition-colors z-10 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#222222]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      
      <div class="px-6 sm:px-8 pt-6 sm:pt-8 pb-4">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#F7F7F7] border border-[#EBEBEB] text-[11px] font-bold text-[#717171] mb-3">
          <span>🗓️</span><span>Calendar View</span>
        </div>
        <h3 class="text-[20px] sm:text-[22px] font-bold text-[#222222] mb-1" id="calModalTitle">Vacation Calendar</h3>
        <p class="text-[13px] text-[#717171]" id="calModalDates">Dates</p>
      </div>

      <div id="calModalContent" class="grid grid-cols-1 md:grid-cols-2 gap-4 px-6 sm:px-8 mb-4"></div>

      <div class="mx-6 sm:mx-8 mb-6 sm:mb-8 py-3 px-4 bg-[#F7F7F7] rounded-2xl flex items-center justify-center gap-4 sm:gap-6 flex-wrap">
        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#008A05]"></span><span class="text-[12px] font-semibold text-[#222222]">Holiday</span></div>
        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#FF385C]"></span><span class="text-[12px] font-semibold text-[#222222]">PTO</span></div>
        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#00A699]"></span><span class="text-[12px] font-semibold text-[#222222]">Weekend</span></div>
      </div>
    </div>
  </div>

  <Footer />

  <style>
    .chip-btn {
      background: #ffffff;
      border: 1px solid #DDDDDD;
      border-radius: 12px;
      padding: 8px 14px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      cursor: pointer;
      transition: all 0.15s ease;
      text-align: left;
      min-height: 76px;
      justify-content: space-between;
    }
    .chip-btn:hover {
      border-color: #222222;
      background: #ffffff;
    }
    .chip-btn.active {
      background: #222222;
      border-color: #222222;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    }
    .chip-btn.active .chip-title { color: #ffffff; }
    .chip-btn.active .chip-desc { color: #B0B0B0; }
    .chip-btn.active .stepper-box {
      background: #171717;
      border-color: #404040;
    }
    .chip-btn.active .stepper-btn {
      color: #ffffff;
    }
    .chip-btn.active .stepper-val {
      color: #ffffff;
    }
    .chip-title { font-size: 0.95rem; font-weight: 700; color: #222222; }
    .chip-desc { font-size: 0.72rem; color: #717171; margin-top: 2px; }
    
    .month-tab-btn {
      padding: 6px 16px;
      font-size: 13px;
      font-weight: 600;
      border-radius: 9999px;
      background: #ffffff;
      color: #717171;
      border: 1px solid #DDDDDD;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      white-space: nowrap;
    }
    .month-tab-btn:hover:not(.active) {
      background: #F7F7F7;
      border-color: #222222;
      color: #222222;
    }
    .month-tab-btn.active {
      background: #222222;
      border-color: #222222;
      color: #ffffff;
      box-shadow: 0 2px 4px rgba(34, 34, 34, 0.15);
    }
    
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  
    .tab-btn {
      padding: 10px 20px;
      font-size: 14px;
      font-weight: 700;
      border-radius: 9999px;
      background: transparent;
      color: #717171;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .tab-btn:hover:not(.active) {
      color: #222222;
      background: rgba(255, 255, 255, 0.6);
    }
    .tab-btn.active {
      background: #ffffff;
      color: #222222;
      box-shadow: 0 2px 5px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
    }
    
    #dropZone {
      background: #F7F7F7;
      border: 2px dashed #DDDDDD;
      transition: all 0.2s ease;
    }
    #dropZone:hover {
      border-color: #222222;
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }

  </style>

  <script>
    import { solveVacationPlans, CURRENT_DATE_REF } from "../data/vacation-solver";

    declare const pdfjsLib: any;
    declare const Tesseract: any;

    if (typeof pdfjsLib !== "undefined") {
      pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
    }

    const FESTIVAL_DATE_MAP_2026: Record<string, string[]> = {
      "new year": ["2026-01-01"],
      "republic day": ["2026-01-26"],
      "maha shivratri": ["2026-02-16"],
      "shivratri": ["2026-02-16"],
      "holi": ["2026-03-04"],
      "eid-ul-fitr": ["2026-03-21"],
      "eid ul fitr": ["2026-03-21"],
      "eid-al-fitr": ["2026-03-21"],
      "id-ul-fitr": ["2026-03-21"],
      "mahavir jayanti": ["2026-03-31"],
      "good friday": ["2026-04-03"],
      "buddha purnima": ["2026-05-01"],
      "eid-al-adha": ["2026-05-27"],
      "eid-ul-adha": ["2026-05-27"],
      "eid ul adha": ["2026-05-27"],
      "bakrid": ["2026-05-27"],
      "muharram": ["2026-06-26"],
      "independence day": ["2026-08-15"],
      "raksha bandhan": ["2026-08-28"],
      "rakhi": ["2026-08-28"],
      "janmashtami": ["2026-09-04"],
      "gandhi jayanti": ["2026-10-02"],
      "dussehra": ["2026-10-20"],
      "vijayadashami": ["2026-10-20"],
      "diwali": ["2026-11-08", "2026-11-09"],
      "deepavali": ["2026-11-08", "2026-11-09"],
      "guru nanak": ["2026-11-24"],
      "christmas": ["2026-12-25"],
      "xmas": ["2026-12-25"]
    };

    const MONTH_MAP: Record<string, string> = {
      jan: "01", january: "01",
      feb: "02", february: "02",
      mar: "03", march: "03",
      apr: "04", april: "04",
      may: "05",
      jun: "06", june: "06",
      jul: "07", july: "07",
      aug: "08", august: "08", augst: "08",
      sep: "09", sept: "09", september: "09", septmber: "09",
      oct: "10", october: "10", octomber: "10",
      nov: "11", november: "11", novmber: "11",
      dec: "12", december: "12", decmber: "12"
    };

    let state = {
      selectedRegion: "ALL",
      workWeek: 5,
      selectedLeaves: 0,
      selectedMonth: "ALL",
      customHolidays: [] as string[],
      currentPlans: [] as any[],
      sortBy: "efficiency"
    };

    
    function setupThemeToggle() {
      const toggleBtns = document.querySelectorAll('.theme-toggle-btn');
      toggleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          updateThemeIcons();
        });
      });

      function updateThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        document.querySelectorAll('.theme-icon-moon').forEach(el => {
          if (isDark) el.classList.add('hidden'); else el.classList.remove('hidden');
        });
        document.querySelectorAll('.theme-icon-sun').forEach(el => {
          if (isDark) el.classList.remove('hidden'); else el.classList.add('hidden');
        });
      }

      updateThemeIcons();
    }

    function init() {
      setupThemeToggle();
      state.customHolidays = [];
      bindEvents();
      renderDetectedDates(state.customHolidays);
      render();
    }

    function parseUniversalDates(rawText: string): string[] {
      const datesSet = new Set<string>();
      if (!rawText) return ["2026-01-01"];

      // Always include 1st Jan 2026 by default
      datesSet.add("2026-01-01");

      const cleanedFullText = rawText
        .replace(/[*#~|]/g, " ")
        .replace(/\r\n/g, "\n")
        .replace(/\t/g, " ");

      const lines = cleanedFullText.split(/[\r\n]+/);
      const textChunks = [...lines, cleanedFullText.replace(/\n+/g, " ")];

      for (let chunk of textChunks) {
        let clean = chunk.replace(/\s+/g, " ").trim();
        if (!clean) continue;

        // Fix OCR character repairs
        clean = clean.replace(/\b2[oO]2[67]\b/g, "2026");
        clean = clean.replace(/\b2[lI|]\b/g, "21");
        clean = clean.replace(/\b2[sS]\b/g, "25");

        let foundDateInChunk = false;

        function addRange(startDay: number, endDay: number, monthKey: string, yyyy: string, matchStr: string) {
          const mm = MONTH_MAP[monthKey.toLowerCase().substring(0,3)];
          if (mm && startDay <= endDay && (endDay - startDay <= 15)) {
            for (let d = startDay; d <= endDay; d++) {
              datesSet.add(yyyy + "-" + mm + "-" + String(d).padStart(2, "0"));
            }
            foundDateInChunk = true;
            clean = clean.replace(matchStr, " [EXTRACTED] ");
          }
        }

        function addDate(dd: string, monthKey: string, yyyy: string, matchStr: string) {
          const mm = MONTH_MAP[monthKey.toLowerCase().substring(0,3)];
          if (mm) {
            datesSet.add(yyyy + "-" + mm + "-" + dd.padStart(2, "0"));
            foundDateInChunk = true;
            clean = clean.replace(matchStr, " [EXTRACTED] ");
          }
        }

        const mName = "(Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust|st)?|Sep(?:tember|t)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)";
        const dPat = "(0?[1-9]|[12]\\d|3[01])(?:st|nd|rd|th)?";
        const yPat = "(202[6-7]|2[67])";
        const sep = "\\s*[-–—to]+\\s*"; 

        let match;

        // R1: Month DD - Month DD YYYY
        const r1 = new RegExp("\\b" + mName + "\\s+" + dPat + sep + mName + "\\s+" + dPat + "(?:\\s*[,/\\s]\\s*" + yPat + ")?\\b", "gi");
        while ((match = r1.exec(clean)) !== null) {
          const mm1 = match[1]; const d1 = parseInt(match[2]); const mm2 = match[3]; const d2 = parseInt(match[4]);
          let yyyy = match[5] || "2026"; if(yyyy.length === 2) yyyy = "20"+yyyy;
          if (mm1.toLowerCase().substring(0,3) === mm2.toLowerCase().substring(0,3)) {
            addRange(d1, d2, mm1, yyyy, match[0]);
          }
        }

        // R2: Month DD - DD YYYY
        const r2 = new RegExp("\\b" + mName + "\\s+" + dPat + sep + dPat + "(?:\\s*[,/\\s]\\s*" + yPat + ")?\\b", "gi");
        while ((match = r2.exec(clean)) !== null) {
          const mm = match[1]; const d1 = parseInt(match[2]); const d2 = parseInt(match[3]);
          let yyyy = match[4] || "2026"; if(yyyy.length === 2) yyyy = "20"+yyyy;
          addRange(d1, d2, mm, yyyy, match[0]);
        }

        // R3: DD Month - DD Month YYYY
        const r3 = new RegExp("\\b" + dPat + "\\s+" + mName + sep + dPat + "\\s+" + mName + "(?:\\s*[,/\\s]\\s*" + yPat + ")?\\b", "gi");
        while ((match = r3.exec(clean)) !== null) {
          const d1 = parseInt(match[1]); const mm1 = match[2]; const d2 = parseInt(match[3]); const mm2 = match[4];
          let yyyy = match[5] || "2026"; if(yyyy.length === 2) yyyy = "20"+yyyy;
          if (mm1.toLowerCase().substring(0,3) === mm2.toLowerCase().substring(0,3)) {
            addRange(d1, d2, mm1, yyyy, match[0]);
          }
        }

        // R4: DD - DD Month YYYY
        const r4 = new RegExp("\\b" + dPat + sep + dPat + "\\s+" + mName + "(?:\\s*[,/\\s]\\s*" + yPat + ")?\\b", "gi");
        while ((match = r4.exec(clean)) !== null) {
          const d1 = parseInt(match[1]); const d2 = parseInt(match[2]); const mm = match[3];
          let yyyy = match[4] || "2026"; if(yyyy.length === 2) yyyy = "20"+yyyy;
          addRange(d1, d2, mm, yyyy, match[0]);
        }
        
        // Now single dates
        
        // ISO: YYYY-MM-DD
        const isoRegex = /\b(202[6-7])[-/.](0?[1-9]|1[0-2])[-/.](0?[1-9]|[12]\d|3[01])\b/g;
        while ((match = isoRegex.exec(clean)) !== null) {
          datesSet.add(match[1] + "-" + match[2].padStart(2, '0') + "-" + match[3].padStart(2, '0'));
          foundDateInChunk = true;
          clean = clean.replace(match[0], " [EXTRACTED] ");
        }

        // Numerical: DD/MM/YYYY
        const numDateRegex = /\b(0?[1-9]|[12]\d|3[01])[-/.](0?[1-9]|1[0-2])[-/.](202[6-7]|2[67])\b/g;
        while ((match = numDateRegex.exec(clean)) !== null) {
          let yyyy = match[3]; if (yyyy.length === 2) yyyy = "20" + yyyy;
          datesSet.add(yyyy + "-" + match[2].padStart(2, '0') + "-" + match[1].padStart(2, '0'));
          foundDateInChunk = true;
          clean = clean.replace(match[0], " [EXTRACTED] ");
        }

        // Named Month: DD Month YYYY
        const namedMonthRegex = new RegExp("\\b" + dPat + "\\s*[-/\\s,.]+\\s*" + mName + "\\b(?:\\s*[-/\\s,.]*\\s*" + yPat + ")?", "gi");
        while ((match = namedMonthRegex.exec(clean)) !== null) {
          const dd = match[1]; const mm = match[2]; 
          let yyyy = match[3] || "2026"; if (yyyy.length === 2) yyyy = "20" + yyyy;
          addDate(dd, mm, yyyy, match[0]);
        }

        // Reversed Named Month: Month DD YYYY
        const revNamedMonthRegex = new RegExp("\\b" + mName + "\\s*[-/\\s,.]+\\s*" + dPat + "\\b(?:\\s*[,/\\s.]*\\s*" + yPat + ")?", "gi");
        while ((match = revNamedMonthRegex.exec(clean)) !== null) {
          const mm = match[1]; const dd = match[2];
          let yyyy = match[3] || "2026"; if (yyyy.length === 2) yyyy = "20" + yyyy;
          addDate(dd, mm, yyyy, match[0]);
        }

        // Fallback: Check Festival Entity Map ONLY if NO explicit date was found in this line
        if (!foundDateInChunk) {
          const cleanLower = clean.toLowerCase();
          for (const [festName, dates] of Object.entries(FESTIVAL_DATE_MAP_2026)) {
            const regex = new RegExp(`\\b${festName.replace(/-/g, "[- ]")}\\b`, "i");
            if (regex.test(cleanLower)) {
              dates.forEach(d => datesSet.add(d));
            }
          }
        }
      }

      return Array.from(datesSet).sort();
    }

    function renderDetectedDates(dates: string[]) {
      const box = document.getElementById("detectedDatesBox");
      const pills = document.getElementById("detectedPills");
      const count = document.getElementById("detectedCount");

      if (!box || !pills || !count) return;
      count.textContent = String(dates.length);

      if (dates.length === 0) {
        box.classList.add("hidden");
        return;
      }

      box.classList.remove("hidden");

      pills.innerHTML = dates.map(d => {
        const dateObj = new Date(d + "T00:00:00");
        const formatted = dateObj.toLocaleDateString("en-IN", { day: "numeric", month: "short", weekday: "short" });
        return `
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-bold bg-[#F7F7F7] border border-[#EBEBEB] text-[#222222] rounded-lg shadow-xs hover:border-[#222222] transition-all">
            <span>${formatted} (${d})</span>
            <button type="button" class="btn-remove-date text-[#E31C5F] hover:text-[#D70466] font-bold ml-1 cursor-pointer" data-date="${d}" title="Remove this date">✕</button>
          </span>
        `;
      }).join("");

      document.querySelectorAll(".btn-remove-date").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const targetDate = (btn as HTMLElement).dataset.date;
          state.customHolidays = state.customHolidays.filter(dt => dt !== targetDate);
          renderDetectedDates(state.customHolidays);
          render();
        });
      });
    }

