---
---
<header class="sticky top-0 z-50 bg-white border-b border-[#EBEBEB]">
  <div class="max-w-[1760px] mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex items-center justify-between h-[80px]">

      <!-- Logo (Left) -->
      <a href="/" class="flex items-center gap-2 group no-underline shrink-0">
        <div class="w-10 h-10 bg-gradient-to-br from-[#FF385C] to-[#E31C5F] rounded-xl flex items-center justify-center shadow-sm group-hover:shadow-md transition-shadow">
          <span class="text-white font-extrabold text-sm">LW</span>
        </div>
        <div class="hidden sm:flex flex-col">
          <span class="font-extrabold text-[17px] tracking-tight text-[#222222] whitespace-nowrap">
            The Long Weekends
          </span>
        </div>
      </a>

      <!-- Center: Search Bar Style (Region + Workweek) -->
      <div class="hidden md:flex items-center border border-[#DDDDDD] rounded-full shadow-sm hover:shadow-md transition-shadow px-2 h-[48px] min-w-[400px]">
        <!-- Region -->
        <button type="button" class="flex items-center gap-2 px-4 h-full text-left border-r border-[#EBEBEB] hover:bg-gray-50 rounded-l-full transition-colors flex-1">
          <span class="text-[11px] font-bold text-[#222222] uppercase tracking-wide">Region</span>
          <select id="navRegionSelector" class="bg-transparent text-[13px] font-semibold text-[#222222] outline-none cursor-pointer border-none p-0 m-0" style="-webkit-appearance:none; -moz-appearance:none; appearance:none;">
            <option value="ALL" selected>Pan-India IT</option>
            <option value="SOUTH">South (Bangalore / Chennai / Hyd)</option>
            <option value="WEST">West (Mumbai / Pune)</option>
            <option value="NORTH">North (Delhi / NCR)</option>
            <option value="EAST">East (Kolkata)</option>
          </select>
        </button>

        <!-- Workweek -->
        <button type="button" class="flex items-center gap-2 px-4 h-full text-left border-r border-[#EBEBEB] hover:bg-gray-50 transition-colors">
          <span class="text-[11px] font-bold text-[#222222] uppercase tracking-wide">Workweek</span>
          <div class="flex items-center gap-1">
            <button type="button" id="btnWorkweek5" class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-[#222222] text-white transition-all">5-Day</button>
            <button type="button" id="btnWorkweek6" class="px-2 py-0.5 text-[11px] font-bold rounded-full text-[#717171] hover:text-[#222222] transition-all">6-Day</button>
          </div>
        </button>

        <!-- Search Icon -->
        <button type="button" class="flex items-center justify-center w-[42px] h-[42px] bg-gradient-to-r from-[#FF385C] to-[#E31C5F] rounded-full hover:from-[#E31C5F] hover:to-[#D70466] transition-all shadow-sm hover:shadow-md ml-1 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </div>

      <!-- Mobile: Compact Controls -->
      <div class="flex md:hidden items-center gap-2">
        <select id="navRegionSelectorMobile" class="text-xs font-semibold text-[#222222] bg-white border border-[#DDDDDD] rounded-full px-3 py-2 outline-none border-none" style="-webkit-appearance:none; -moz-appearance:none; appearance:none;">
          <option value="ALL" selected>Pan-India</option>
          <option value="SOUTH">South</option>
          <option value="WEST">West</option>
          <option value="NORTH">North</option>
          <option value="EAST">East</option>
        </select>
        <button type="button" id="btnWorkweek5Mobile" class="px-2.5 py-1.5 text-[10px] font-bold rounded-full bg-[#222222] text-white">5</button>
        <button type="button" id="btnWorkweek6Mobile" class="px-2.5 py-1.5 text-[10px] font-bold rounded-full bg-[#F7F7F7] text-[#717171] border border-[#DDDDDD]">6</button>
      </div>

      <!-- Right: Theme Toggle -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="themeToggleBtn"
          class="theme-toggle-btn w-10 h-10 rounded-full border border-[#DDDDDD] bg-white flex items-center justify-center hover:shadow-sm transition-all cursor-pointer"
          title="Toggle Theme"
          aria-label="Toggle Theme"
        >
          <span class="theme-icon-moon text-base">🌙</span>
          <span class="theme-icon-sun hidden text-base">☀️</span>
        </button>
      </div>

    </div>
  </div>
</header>

<script>
  // Theme Toggle
  const themeToggleBtn = document.getElementById('themeToggleBtn');
  const moonIcons = document.querySelectorAll('.theme-icon-moon');
  const sunIcons = document.querySelectorAll('.theme-icon-sun');

  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    moonIcons.forEach(el => el.classList.toggle('hidden', isDark));
    sunIcons.forEach(el => el.classList.toggle('hidden', !isDark));
  }

  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeIcons();
  });

  updateThemeIcons();

  // Sync mobile region selector with desktop
  const regionDesktop = document.getElementById('navRegionSelector') as HTMLSelectElement;
  const regionMobile = document.getElementById('navRegionSelectorMobile') as HTMLSelectElement;

  if (regionDesktop && regionMobile) {
    regionMobile.addEventListener('change', () => {
      regionDesktop.value = regionMobile.value;
      regionDesktop.dispatchEvent(new Event('change'));
    });
    regionDesktop.addEventListener('change', () => {
      regionMobile.value = regionDesktop.value;
    });
  }

  // Sync mobile workweek buttons
  const btn5Desktop = document.getElementById('btnWorkweek5');
  const btn6Desktop = document.getElementById('btnWorkweek6');
  const btn5Mobile = document.getElementById('btnWorkweek5Mobile');
  const btn6Mobile = document.getElementById('btnWorkweek6Mobile');

  function syncWorkweek(is5Day: boolean) {
    [btn5Desktop, btn5Mobile].forEach(btn => {
      if (!btn) return;
      if (is5Day) {
        btn.classList.add('bg-[#222222]', 'text-white');
        btn.classList.remove('bg-[#F7F7F7]', 'text-[#717171]', 'border', 'border-[#DDDDDD]');
      } else {
        btn.classList.remove('bg-[#222222]', 'text-white');
        btn.classList.add('bg-[#F7F7F7]', 'text-[#717171]', 'border', 'border-[#DDDDDD]');
      }
    });
    [btn6Desktop, btn6Mobile].forEach(btn => {
      if (!btn) return;
      if (!is5Day) {
        btn.classList.add('bg-[#222222]', 'text-white');
        btn.classList.remove('bg-[#F7F7F7]', 'text-[#717171]', 'border', 'border-[#DDDDDD]');
      } else {
        btn.classList.remove('bg-[#222222]', 'text-white');
        btn.classList.add('bg-[#F7F7F7]', 'text-[#717171]', 'border', 'border-[#DDDDDD]');
      }
    });
  }

  btn5Desktop?.addEventListener('click', () => { syncWorkweek(true); });
  btn6Desktop?.addEventListener('click', () => { syncWorkweek(false); });
  btn5Mobile?.addEventListener('click', () => { syncWorkweek(true); btn5Desktop?.click(); });
  btn6Mobile?.addEventListener('click', () => { syncWorkweek(false); btn6Desktop?.click(); });
</script>
