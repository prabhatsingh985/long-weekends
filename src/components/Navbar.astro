---
---
<header class="sticky top-0 z-50 bg-[#0c0c0e]/95 backdrop-blur-md border-b border-zinc-800/80 transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 min-h-[4.25rem] py-3 sm:py-0 flex flex-wrap items-center justify-between gap-3">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group text-decoration-none">
      <div class="w-9 h-9 rounded-lg bg-[#ff2b63] text-white flex items-center justify-center font-mono font-extrabold text-sm shadow-md group-hover:scale-105 transition-transform">
        LW
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-base sm:text-lg tracking-tight text-white flex items-center gap-1.5 whitespace-nowrap">
          The Long Weekends <span id="brandFlag" class="text-xs">🇮🇳</span>
        </span>
      </div>
    </a>

    <!-- Center Capsule Controls (Region + Workweek) -->
    <div class="hidden md:flex items-center gap-3 rounded-full border border-zinc-800 bg-zinc-900/80 px-4 py-1.5 shadow-inner">
      <!-- Region Selector -->
      <div class="flex items-center gap-2 text-xs">
        <span class="font-mono font-bold text-[10px] uppercase tracking-widest text-zinc-500">Region</span>
        <select id="navRegionSelector" class="bg-transparent border-none text-white text-xs font-bold outline-none cursor-pointer pr-1 hover:text-[#ff2b63] transition-colors">
          <option value="ALL" class="bg-zinc-900 text-white" selected>Pan-India IT</option>
          <option value="USA" class="bg-zinc-900 text-white">United States (US Federal)</option>
        </select>
      </div>

      <span class="border-r border-zinc-800 h-4"></span>

      <!-- Workweek Toggle -->
      <div class="flex items-center gap-2 text-xs">
        <span class="font-mono font-bold text-[10px] uppercase tracking-widest text-zinc-500">Workweek</span>
        <div class="flex items-center gap-1 bg-zinc-950 p-0.5 rounded-full border border-zinc-800">
          <button type="button" id="btnWorkweek5" class="px-2.5 py-0.5 text-[11px] font-bold rounded-full transition-all bg-white text-zinc-950 shadow-xs cursor-pointer">5-Day</button>
          <button type="button" id="btnWorkweek6" class="px-2.5 py-0.5 text-[11px] font-medium rounded-full transition-all text-zinc-400 hover:text-white cursor-pointer">6-Day</button>
        </div>
      </div>
    </div>

    <!-- Right Controls (Search Icon + Mobile Region + Theme) -->
    <div class="flex items-center gap-2.5">
      <!-- Mobile Region Selector -->
      <div class="flex md:hidden items-center">
        <select id="navRegionSelectorMobile" class="bg-zinc-900 border border-zinc-800 text-white text-xs font-bold rounded-full px-3 py-1 outline-none cursor-pointer">
          <option value="ALL" selected>🇮🇳 India</option>
          <option value="USA">🇺🇸 USA</option>
        </select>
      </div>

      <!-- Quick Search Scroll Button -->
      <button
        type="button"
        id="quickSearchBtn"
        class="w-9 h-9 rounded-full bg-[#ff2b63] hover:bg-[#e11d48] text-white flex items-center justify-center shadow-lg transition-transform active:scale-95 cursor-pointer"
        title="Search Vacations"
      >
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </button>

      <!-- Theme Toggle Button -->
      <button
        type="button"
        id="themeToggleBtn"
        class="theme-toggle-btn w-9 h-9 rounded-full border border-zinc-800 bg-zinc-900/80 text-zinc-300 hover:text-white hover:border-zinc-700 transition-all flex items-center justify-center cursor-pointer"
        title="Toggle Theme"
        aria-label="Toggle Theme"
      >
        <span class="theme-icon-moon text-xs">🌙</span>
        <span class="theme-icon-sun hidden text-xs">☀️</span>
      </button>
    </div>

  </div>
</header>

