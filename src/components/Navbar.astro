---
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-[#ebebeb]">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 min-h-[4rem] py-3 sm:py-0 flex flex-wrap items-center justify-between gap-3 sm:gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 sm:gap-3 group text-decoration-none">
      <div class="w-9 h-9 rounded-md bg-[#171717] text-white flex items-center justify-center font-mono font-bold text-sm shadow-sm">
        LW
      </div>
      <div class="flex flex-col">
        <span class="font-semibold text-[15px] sm:text-lg tracking-tight text-[#171717] flex items-center gap-1.5 whitespace-nowrap">
          Long Weekendai <span class="text-xs">🇮🇳</span>
        </span>
        <span class="caption-mono text-[9px] sm:text-[10px] text-[#888888] tracking-widest whitespace-nowrap">longweekendai.com</span>
      </div>
    </a>

    <!-- Nav Controls -->
    <div class="flex items-center gap-2 sm:gap-3 justify-between sm:justify-end flex-nowrap w-full sm:w-auto mt-2 sm:mt-0">

      <!-- Region Selector -->
      <div class="flex items-center gap-1.5 flex-1 min-w-0">
        <select id="navRegionSelector" class="w-full text-ellipsis overflow-hidden bg-[#fafafa] border border-[#ebebeb] text-[#171717] text-xs font-semibold rounded-md px-2 sm:px-3 py-1 sm:py-1.5 outline-none focus:border-[#171717] cursor-pointer">
          <option value="ALL" selected>🇮🇳 Pan-India IT</option>
          <option value="SOUTH">🟢 South (Bangalore / Chennai / Hyd)</option>
          <option value="WEST">🟠 West (Mumbai / Pune)</option>
          <option value="NORTH">🔵 North (Delhi / NCR)</option>
          <option value="EAST">🟡 East (Kolkata)</option>
        </select>
      </div>

      <!-- Workweek Toggle -->
      <div class="flex items-center gap-1 bg-[#f5f5f5] p-1 rounded-md border border-[#ebebeb] shrink-0">
        <button type="button" id="btnWorkweek5" class="px-2.5 py-1 text-xs font-medium rounded-sm transition-all bg-[#171717] text-white">5-Day</button>
        <button type="button" id="btnWorkweek6" class="px-2.5 py-1 text-xs font-medium rounded-sm transition-all text-[#666666] hover:text-[#171717]">6-Day</button>
      </div>

      <!-- Theme Toggle Button -->
      <button
        type="button"
        id="themeToggleBtn"
        class="theme-toggle-btn p-1.5 sm:p-2 rounded-md border border-[#ebebeb] bg-[#f5f5f5] text-[#171717] hover:bg-slate-200 transition-all flex items-center justify-center cursor-pointer shrink-0"
        title="Toggle Theme"
        aria-label="Toggle Theme"
      >
        <span class="theme-icon-moon text-xs sm:text-sm">🌙</span>
        <span class="theme-icon-sun hidden text-xs sm:text-sm">☀️</span>
      </button>

    </div>
  </div>
</header>
