---
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-[#ebebeb]">
  <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group text-decoration-none">
      <div class="w-9 h-9 rounded-md bg-[#171717] text-white flex items-center justify-center font-mono font-bold text-sm shadow-sm">
        LW
      </div>
      <div class="flex flex-col">
        <span class="font-semibold text-lg tracking-tight text-[#171717] flex items-center gap-1.5">
          Long Weekendai <span class="text-xs">🇮🇳</span>
        </span>
        <span class="caption-mono text-[10px] text-[#888888] tracking-widest">longweekendai.com</span>
      </div>
    </a>

    <!-- Nav Controls -->
    <div class="flex items-center gap-3 flex-wrap">
      
      <!-- v2 Feature: Dedicated Company Optimizer CTA -->
      <a 
        href="/company-optimizer" 
        class="group inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 active:scale-98 transition-all border border-slate-700/80 no-underline cursor-pointer"
        title="Upload your company holiday calendar (PDF, screenshot, or text)"
      >
        <span class="text-sm">🏢</span>
        <span>Upload Office Holiday List</span>
        <span class="text-slate-400 group-hover:text-white group-hover:translate-x-0.5 transition-transform text-xs font-bold">→</span>
      </a>

      <!-- Region Selector -->
      <div class="hidden sm:flex items-center gap-1.5">
        <select id="navRegionSelector" class="bg-[#fafafa] border border-[#ebebeb] text-[#171717] text-xs font-semibold rounded-md px-3 py-1.5 outline-none focus:border-[#171717] cursor-pointer">
          <option value="ALL" selected>🇮🇳 Pan-India IT</option>
          <option value="SOUTH">🟢 South (Bangalore / Chennai / Hyd)</option>
          <option value="WEST">🟠 West (Mumbai / Pune)</option>
          <option value="NORTH">🔵 North (Delhi / NCR)</option>
          <option value="EAST">🟡 East (Kolkata)</option>
        </select>
      </div>

      <!-- Workweek Toggle -->
      <div class="flex items-center gap-1 bg-[#f5f5f5] p-1 rounded-md border border-[#ebebeb]">
        <button type="button" id="btnWorkweek5" class="px-2.5 py-1 text-xs font-medium rounded-sm transition-all bg-[#171717] text-white">5-Day</button>
        <button type="button" id="btnWorkweek6" class="px-2.5 py-1 text-xs font-medium rounded-sm transition-all text-[#666666] hover:text-[#171717]">6-Day</button>
      </div>

    </div>
  </div>
</header>
