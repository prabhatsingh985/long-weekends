---
---
<section class="relative pt-16 pb-14 px-4 sm:px-6 border-b border-slate-200 bg-gradient-to-b from-amber-50/40 via-orange-50/20 to-[#fafafa] overflow-hidden">
  <!-- Subtle warm glowing backdrop -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-amber-200/30 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-10 right-0 w-80 h-80 bg-rose-100/30 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-[1200px] mx-auto relative z-10 flex flex-col items-center text-center">
    
    <!-- 1. Alert Badge (Dynamically calculated based on real today date) -->
    <div class="inline-flex items-center sm:items-center text-center gap-2 px-4 py-2 rounded-2xl sm:rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] sm:text-xs font-bold mb-5 shadow-xs hover:bg-emerald-100/80 transition-all leading-tight">
      <span class="text-sm" aria-hidden="true">🌴</span>
      <span id="heroCountdownBadge">Next: Raksha Bandhan (3 Days Off · 0 Leaves Needed)</span>
    </div>

    <!-- 2. Main Headline & Tagline -->
    <h1 class="text-[28px] leading-tight sm:text-5xl lg:text-[52px] font-extrabold text-slate-900 tracking-tight leading-[1.15] max-w-[850px] mb-2.5">
      Find Your Next Long Weekend in 2026
    </h1>
    <p class="text-lg sm:text-xl font-bold text-amber-600 mb-4 tracking-tight">
      Take more vacations. Burn fewer leaves.
    </p>

    <!-- 3. Empathetic Description (Subtext) -->
    <p class="text-base sm:text-lg text-slate-600 max-w-[720px] mb-8 leading-relaxed font-medium">
      Every long weekend is a chance to recharge — without burning through your leave balance. We scan India's public holidays, match them to your weekends, and show you exactly how many PTO days you need to turn a regular break into a real vacation.
    </p>

    <!-- Company Optimizer CTA Button -->
    <a href="/company-optimizer" class="hero-cta-btn group inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-2xl bg-[#0f172a] hover:bg-[#1e293b] text-white font-extrabold text-[15px] shadow-[0_8px_20px_-6px_rgba(15,23,42,0.5)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_24px_-6px_rgba(15,23,42,0.6)] border border-slate-700/50 active:scale-95 no-underline">
      <span class="text-xl" aria-hidden="true">🏢</span>
      Upload Office Holiday List
      <span class="text-slate-400 group-hover:text-white group-hover:translate-x-1 transition-all duration-300 ml-1">→</span>
    </a>
  

    

  </div>
</section>

<script>
  import { solveVacationPlans, getTodayIso } from "../data/vacation-solver";

  function initDynamicHeroBadge() {
    const badge = document.getElementById("heroCountdownBadge");
    if (!badge) return;

    const today = getTodayIso();

    // Check starting with 0 leaves, then 1 leave, 2 leaves, up to 4 leaves
    for (let l = 0; l <= 4; l++) {
      const plans = solveVacationPlans({
        leaves: l,
        workWeek: 5,
        region: "ALL",
        month: "ALL",
        fromDate: today
      });

      // User requirement: check upcoming where startDate > today (or startDate >= today)
      let upcoming = plans.filter(p => p.startDate > today);
      if (upcoming.length === 0) {
        upcoming = plans.filter(p => p.startDate >= today);
      }

      if (upcoming.length > 0) {
        upcoming.sort((a, b) => a.startDate.localeCompare(b.startDate));
        const nextPlan = upcoming[0];
        
        let label = nextPlan.title.split(":")[0].replace(/\(.*?\)/g, "").trim();
        if (!label && nextPlan.days && nextPlan.days.length > 0) {
          const hol = nextPlan.days.find(d => d.type === "holiday");
          if (hol) label = hol.label;
        }
        
        const daysOff = nextPlan.totalDaysOff || 3;
        const leaves = typeof nextPlan.leavesRequired === "number" ? nextPlan.leavesRequired : l;
        const leavesText = leaves === 0 ? "0 Leaves Needed" : `${leaves} ${leaves === 1 ? 'Leave' : 'Leaves'} Needed`;

        badge.textContent = `Next: ${label} (${daysOff} Days Off · ${leavesText})`;
        return;
      }
    }

    // Fallback for year end
    badge.textContent = "Year-End Getaways · 2027 Plans Available Soon";
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDynamicHeroBadge);
  } else {
    initDynamicHeroBadge();
  }
</script>
