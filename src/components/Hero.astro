---
---
<section class="relative pt-16 pb-14 px-6 border-b border-slate-200 bg-gradient-to-b from-amber-50/40 via-orange-50/20 to-[#fafafa] overflow-hidden">
  <!-- Subtle warm glowing backdrop -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-amber-200/30 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-10 right-0 w-80 h-80 bg-rose-100/30 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-[1200px] mx-auto relative z-10">
    
    <!-- 1. Alert Badge (Dynamically calculated based on real today date) -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold mb-5 shadow-xs hover:bg-emerald-100/80 transition-all">
      <span class="text-sm">🌴</span>
      <span id="heroCountdownBadge">Next: Raksha Bandhan (3 Days Off · 0 Leaves Needed)</span>
    </div>

    <!-- 2. Main Headline & Tagline -->
    <h1 class="text-3xl sm:text-5xl lg:text-[52px] font-extrabold text-slate-900 tracking-tight leading-[1.15] max-w-[850px] mb-2.5">
      You deserve a break. We found the time for you.
    </h1>
    <p class="text-lg sm:text-xl font-bold text-amber-600 mb-4 tracking-tight">
      Take more vacations. Burn fewer leaves.
    </p>

    <!-- 3. Empathetic Description (Subtext) -->
    <p class="text-base sm:text-lg text-slate-600 max-w-[720px] mb-8 leading-relaxed font-normal">
      Escape the daily grind without emptying your leave balance. We automatically turn regular weekends and public holidays into guilt-free mini vacations.
    </p>

    <!-- 4. Metric Cards (3 Clean Highlight Cards) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-[850px]">
      
      <!-- Card 1 -->
      <div class="bg-white/90 backdrop-blur-xs p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between">
        <span class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-1">10 Days Off</span>
        <span class="text-xs text-slate-500 font-medium leading-relaxed">Year-End Break using just 4 leaves</span>
      </div>

      <!-- Card 2 -->
      <div class="bg-white/90 backdrop-blur-xs p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between">
        <span class="text-xl sm:text-2xl font-extrabold text-blue-600 mb-1">5x Multiplier</span>
        <span class="text-xs text-slate-500 font-medium leading-relaxed">Turn 1 casual leave into a 5-day escape</span>
      </div>

      <!-- Card 3 -->
      <div class="bg-white/90 backdrop-blur-xs p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between">
        <span class="text-xl sm:text-2xl font-extrabold text-emerald-600 mb-1">100% Verified</span>
        <span class="text-xs text-slate-500 font-medium leading-relaxed">Matched with official 2026 Indian holidays</span>
      </div>

    </div>

  </div>
</section>

<script>
  import { solveVacationPlans, getTodayIso } from "../data/vacation-solver";

  function initDynamicHeroBadge() {
    const badge = document.getElementById("heroCountdownBadge");
    if (!badge) return;

    const today = getTodayIso();

    // Check starting with 0 leaves, then 1 leave, 2 leaves, up to 4 leaves
    for (let l = 0; l <= 4; l++) {
      const plans = solveVacationPlans({
        leaves: l,
        workWeek: 5,
        region: "ALL",
        month: "ALL",
        fromDate: today
      });

      // User requirement: check upcoming where startDate > today (or startDate >= today)
      let upcoming = plans.filter(p => p.startDate > today);
      if (upcoming.length === 0) {
        upcoming = plans.filter(p => p.startDate >= today);
      }

      if (upcoming.length > 0) {
        upcoming.sort((a, b) => a.startDate.localeCompare(b.startDate));
        const nextPlan = upcoming[0];
        
        let label = nextPlan.title.split(":")[0].replace(/\(.*?\)/g, "").trim();
        if (!label && nextPlan.days && nextPlan.days.length > 0) {
          const hol = nextPlan.days.find(d => d.type === "holiday");
          if (hol) label = hol.label;
        }
        
        const daysOff = nextPlan.totalDaysOff || 3;
        const leaves = typeof nextPlan.leavesRequired === "number" ? nextPlan.leavesRequired : l;
        const leavesText = leaves === 0 ? "0 Leaves Needed" : `${leaves} ${leaves === 1 ? 'Leave' : 'Leaves'} Needed`;

        badge.textContent = `Next: ${label} (${daysOff} Days Off · ${leavesText})`;
        return;
      }
    }

    // Fallback for year end
    badge.textContent = "Year-End Getaways · 2027 Plans Available Soon";
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDynamicHeroBadge);
  } else {
    initDynamicHeroBadge();
  }
</script>
