---
/**
 * Hero: headline + the Airbnb-style search capsule.
 *
 * Rebuilt for keyboard use. The two selectors used to be <div>s with click
 * handlers, so they could not be reached by Tab, had no aria-expanded, and
 * marked their chosen option with `bg-zinc-800/80` — invisible on a light
 * popover. They are now real buttons driving a `menuitemradio` menu.
 *
 * Emits `lw:search` with { region, leaves } when the user presses Search.
 *
 * The country control is RegionMenu.astro rather than markup of its own. It
 * used to be a second copy: the hero declared its own two-entry REGIONS array
 * and its own popover, and the navbar declared another. Two countries made that
 * survivable. Forty-seven would mean the country list, its continent headings
 * and its filter box existing twice in this repo and drifting apart the first
 * time one of them gained a country — so both now render the same component,
 * and Navbar.astro's initRegion() binds every instance of it, including this
 * one. The budget menu beside it is still local, because its three presets and
 * its stepper appear nowhere else.
 */
import RegionMenu from "./RegionMenu.astro";
import { COUNTRIES } from "../data/countries";
import { MAX_LEAVES } from "../data/vacation-solver";

/* Three presets, not three options: every number from 0 to MAX_LEAVES is
   reachable, and the stepper under them picks up exactly where they stop.
   These are the three worth naming, because each buys a different KIND of
   break — which is what the hints say. Three leaves used to be named too, and
   it is the one that did not earn the row: it buys the same thing four and
   five do, a week around a festival, so it belongs to the stepper with them.

   Glyphs are picked for what Windows can actually draw. 🆓 was the obvious
   choice for the free tier and the wrong one: Segoe UI Emoji renders it as a
   system-blue "FREE" chip that reads as a browser badge sitting inside our own
   menu, not as an icon in it. 🎁 carries the same "costs you nothing" meaning
   and matches the weight of the two beside it. */
const BUDGETS = [
  {
    value: "0",
    glyph: "🎁",
    label: "No leaves",
    hint: "Breaks that cost you nothing",
  },
  { value: "1", glyph: "🌴", label: "1 leave", hint: "One day buys a 4-day trip" },
  { value: "2", glyph: "✈️", label: "2 leaves", hint: "Enough for 5–6 days away" },
];

/* Where the stepper starts: the first number the presets do not name. Derived
   rather than written, so moving a number between the list and the stepper is
   a one-line edit to BUDGETS and nothing else. */
const CUSTOM_MIN = Number(BUDGETS[BUDGETS.length - 1].value) + 1;
---

<!-- No `overflow-hidden` on the section itself, deliberately.
     It used to live here to stop the decorative blurs below from widening the
     page, but an ancestor's overflow clips *every* descendant — so the search
     capsule's dropdowns were cut off at the section's bottom edge and the
     budget menu appeared to only have two options. The blurs are clipped by
     their own wrapper instead, which leaves the menus free to overhang. -->
<section class="relative px-4 sm:px-6 pt-12 pb-14 sm:pt-16 sm:pb-16">
  <!-- Ambient warmth. Decorative only, so kept out of the a11y tree and
       deliberately faint enough not to shift text contrast. -->
  <div
    class="absolute inset-0 overflow-hidden pointer-events-none"
    aria-hidden="true"
  >
    <div
      class="absolute -top-40 -left-32 w-[26rem] h-[26rem] rounded-full bg-brand/8 blur-3xl"
    >
    </div>
    <div
      class="absolute -top-24 -right-24 w-[22rem] h-[22rem] rounded-full bg-brand-400/8 blur-3xl"
    >
    </div>
  </div>

  <div
    class="relative max-w-[1280px] mx-auto flex flex-col items-center text-center"
  >
    {/* "Next up: Raksha Bandhan — 3 days off for no leaves" is ~45 characters,
        so on a 320px screen it has to wrap. `rounded-full` on a two-line pill
        bulges into a stadium, hence the softer corner below `sm`. The dot and
        arrow are shrink-0 so the text is the only thing that gives way. */}
    <a
      href="#results"
      class="group inline-flex max-w-full items-center gap-2 mb-7 pl-3 pr-2.5 py-1.5 rounded-2xl sm:rounded-full bg-surface border border-hairline shadow-soft text-[0.8125rem] font-semibold text-body hover:border-hairline-strong hover:text-ink transition-colors no-underline"
    >
      <span class="dot dot-holiday shrink-0" aria-hidden="true"></span>
      {/* Replaced on load by renderCountdownBadge() with the visitor's own
          country and clock. This is the crawler-visible wording, so it makes no
          claim about a country it cannot yet know. */}
      <span id="heroCountdownBadge" class="text-left"
        >Every long weekend left in 2026 and 2027</span
      >
      <span
        class="shrink-0 text-muted group-hover:translate-x-0.5 transition-transform"
        aria-hidden="true">→</span
      >
    </a>

    <h1
      class="text-[2rem] sm:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.08] max-w-[54rem] mb-4"
    >
      Find your next <span class="text-brand-text">long weekend</span>
    </h1>

    <p class="text-base sm:text-lg text-body max-w-[38rem] mb-9 leading-relaxed">
      Your leave balance is finite. Public holidays are not. Pick where you work
      — {COUNTRIES.length} countries, each on its own calendar — tell us how
      many days you can spare, and we'll show you the longest break each one
      buys.
    </p>

    <!-- Search capsule ------------------------------------------------------ -->
    {/* Stacks to a column below `sm`. In a row at 360px each `.seg` gets
        `flex:1 1 0` of ~110px, which truncated the country name and wrapped the
        "Days you can spare" label onto two lines. Stacking gives each control
        the full width instead of shrinking the type — and it matters more now
        than it did, because the names run to "United Arab Emirates" rather than
        stopping at "India". */}
    <div class="w-full max-w-[42rem]">
      <div
        class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-1 p-2 rounded-3xl sm:rounded-full bg-surface border border-hairline shadow-lift"
      >
        {/* Each seg owns a `relative` wrapper so its menu anchors to the seg,
            not to the capsule. Without it `top:100%` measures the whole capsule,
            so once stacked both menus dropped below the entire stack. */}
        <!-- Country. Placement (below by default, flipped only when the
             viewport demands it) is set by createMenu on every open. -->
        <div class="relative flex-1 min-w-0">
          <RegionMenu id="heroRegionTrigger" variant="hero" align="left" />
        </div>

        <!-- Divider: only meaningful when the two segments sit side by side. -->
        <span
          class="hidden sm:block w-px h-9 bg-hairline shrink-0"
          aria-hidden="true"></span>

        <!-- Leave budget -->
        <div class="relative flex-1 min-w-0">
          <button
            type="button"
            id="heroBudgetTrigger"
            class="seg w-full"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="heroBudgetMenu"
          >
            <span class="seg-label">Days you can spare</span>
            <span class="flex items-center justify-between gap-1">
              <span class="seg-value" id="heroBudgetDisplay">No leaves</span>
              <svg
                class="seg-caret w-3 h-3 text-muted shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </span>
          </button>

          {/* Anchored to the seg's LEFT edge, and full width while stacked.
              It used to be `right-0` at a fixed 23rem. Both halves of that were
              wrong once the capsule had two widths. In a row the menu is wider
              than the seg it belongs to, so pinning its right edge hung 118px
              of panel out over the COUNTRY control at 1280px — the open menu
              sat under the wrong half of the capsule. Stacked, the seg is the
              wider of the two, so the same rule left the panel hugging the
              right edge with up to 82px of empty control showing beside it.

              `left-0` puts the panel's corner under the label that opened it,
              which is where the eye already is, and `w-full` below `sm` makes
              it exactly as wide as its control instead of narrower or (at
              375px) 17px wider on both sides. From `sm` it takes its natural
              23rem and grows rightward; createMenu's placeHorizontally() is
              what keeps that inside the viewport, so the width no longer has
              to guess with `min(...)`. */}
          <div
            id="heroBudgetMenu"
            role="menu"
            aria-labelledby="heroBudgetTrigger"
            hidden
            class="popover popover-below absolute left-0 z-50 w-full p-2 text-left sm:w-[23rem] sm:max-w-[calc(100vw-2rem)]"
          >
            {
              BUDGETS.map((b, i) => (
                <button
                  type="button"
                  role="menuitemradio"
                  aria-checked={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  class="menu-item"
                  data-leaves={b.value}
                  data-label={b.label}
                >
                  <span class="text-xl shrink-0" aria-hidden="true">
                    {b.glyph}
                  </span>
                  <span class="min-w-0">
                    <span class="block text-[0.8125rem] font-bold text-ink">
                      {b.label}
                    </span>
                    <span class="block text-xs text-muted">{b.hint}</span>
                  </span>
                </button>
              ))
            }

            {/* The rest of the range.
                ---------------------------------------------------------------
                The presets above were the whole control, so a visitor with a
                week of leave to spend could ask this capsule for at most three
                days of it. The rail over the results has run to ten since it
                was written — the capsule was the only place the answer was
                capped, and it is the place most visitors start.

                A stepper rather than seven more rows: the presets earn their
                space by naming a kind of break, and "7 leaves" names nothing.
                It is also the same control, in the same words, as the compound
                pill in the results rail, so the two read as one idea.

                The label is a menuitemradio in its own right — the same shape
                the rail's compound pill uses, and the reason the ± buttons sit
                OUTSIDE it rather than within: a button inside a button is
                invalid HTML, which is what split the rail's pill in two as
                well. The label carries the choice (the tick, the capsule's
                text, close-on-select); the stepper beside it only changes the
                number that choice holds. Without it the one budget you could
                not ask for would be the lowest the stepper offers, because
                landing on it takes no press.

                `data-menu-stop` puts the field in the arrow-key ring — Tab
                closes a menu, so without it the keyboard could not reach the
                number at all. `data-menu-freeform` hands Up, Down, Home and
                End back to the field, where they step the number and move the
                caret; it wraps the stepper ONLY, or those keys would stop
                working on the label button beside it. Both are createMenu's,
                and documented there. */}
            <div
              class="mx-1 my-1.5 h-px bg-hairline"
              role="separator"
              aria-orientation="horizontal"
            >
            </div>

            <div id="heroBudgetCustom" class="menu-custom">
              <button
                type="button"
                role="menuitemradio"
                aria-checked="false"
                tabindex="-1"
                id="heroBudgetCustomPick"
                class="menu-item menu-custom-pick"
                data-leaves="custom"
                data-label={`${CUSTOM_MIN} leaves`}
              >
                <span class="text-xl shrink-0" aria-hidden="true">📅</span>
                <span class="min-w-0 grow">
                  <span class="block text-[0.8125rem] font-bold text-ink"
                    >More leaves</span
                  >
                  <span class="block text-xs text-muted"
                    >From {CUSTOM_MIN} to {MAX_LEAVES}</span
                  >
                </span>
              </button>

              <span class="menu-custom-stepper" data-menu-freeform>
                <button
                  type="button"
                  id="heroBudgetDec"
                  class="stepper-btn"
                  aria-label="One leave fewer"><span aria-hidden="true">−</span></button
                >
                {/* Typed or stepped, and applied either way as it changes. The
                    label beside it is the only thing in this row that waits
                    for a press. */}
                <input
                  type="number"
                  id="heroBudgetInput"
                  class="budget-input"
                  data-menu-stop
                  inputmode="numeric"
                  min={CUSTOM_MIN}
                  max={MAX_LEAVES}
                  step="1"
                  value={CUSTOM_MIN}
                  tabindex="-1"
                  aria-label="Number of leaves"
                />
                <button
                  type="button"
                  id="heroBudgetInc"
                  class="stepper-btn"
                  aria-label="One leave more"><span aria-hidden="true">+</span></button
                >
              </span>
            </div>

            {/* Phones only, and not a duplicate button for the sake of one.
                ---------------------------------------------------------------
                Below `sm` the capsule is a COLUMN — country, budget, Show
                plans — and this menu hangs from the middle of it, directly over
                the button at the bottom. Every other way out of the menu closes
                it on the way out: a preset is one tap, and so is the label
                above. The stepper is the one control meant to be pressed
                repeatedly, so it deliberately leaves the menu open — and that
                is precisely the state in which the button you now want is
                underneath the panel you are still looking at. Tapping outside
                dismisses it, but nothing on screen says so.

                So the action comes to the panel rather than the panel moving
                out of its way. On a desktop row nothing is ever covered, and
                this button is not rendered at all.

                `data-menu-below-only` is the other half of that sentence, and
                the reason there is a rule about it in global.css rather than a
                class here: the menu is not always below. Near the bottom of a
                short viewport createMenu flips it above the trigger, where it
                covers the COUNTRY control and leaves the capsule's own button
                fully visible underneath — and then this twin is not a rescue,
                it is the same button offered twice, one panel edge apart. On a
                343px screen that is exactly how it read. The attribute hides
                this row whenever the panel is not the thing standing in the
                way. */}
            <button
              type="button"
              id="heroBudgetGo"
              data-menu-below-only
              class="btn btn-brand mt-1.5 w-full sm:hidden"
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              <span>Show plans</span>
            </button>
          </div>
        </div>

        {/* Full width with a visible label when stacked — an icon-only button
            below the two controls read as a mystery circle. Auto width and
            icon+label on the row layout. */}
        <button
          type="button"
          id="heroSearchActionBtn"
          class="btn btn-brand w-full sm:w-auto shrink-0"
        >
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span>Show plans</span>
        </button>
      </div>
    </div>

    {/* Same wrap-safety as the countdown badge above: this label is ~35
        characters, which does not fit one line at 320px. */}
    {/* The second tool, presented as one.
         ---------------------------------------------------------------
         This was a pink-tinted pill — brand-50 fill, brand-200 border, an
         emoji and a question — floating under the search capsule. At that
         size and colour it read as a promotional badge rather than a way in,
         which is the one thing it must not look like: the office optimizer is
         the only part of this site a visitor cannot get to any other way, and
         it is the feature that makes the calculator useful to someone whose
         employer ignores half the gazetted list.

         So it is a card now, sized and bordered like the result cards further
         down the page, with the three things an entry point needs: a name, a
         sentence saying what it does, and a visible action. The tinted fill is
         gone — on this page the only filled surface is the primary button, and
         a second one competed with it. */}
    <a
      href="/company-optimizer"
      class="group mt-8 block w-full max-w-[42rem] rounded-card border border-hairline bg-surface p-4 text-left no-underline shadow-soft transition-colors hover:border-hairline-strong sm:p-5"
    >
      <div class="flex items-center gap-3.5 sm:gap-4">
        {/* A bordered tile rather than a bare emoji: it gives the glyph a
             defined size so the row keeps its rhythm at every width, and it
             reads as an icon rather than as punctuation inside the sentence. */}
        <span
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-control border border-hairline bg-surface-soft text-lg sm:h-11 sm:w-11 sm:text-xl"
          aria-hidden="true">🏢</span
        >

        <span class="min-w-0 grow">
          <span class="block text-[0.9375rem] font-extrabold leading-snug text-ink">
            Company Holiday Optimizer
          </span>
          {/* Two lines at 320px, one from `sm`. Left to wrap on its own rather
               than truncated — the sentence is the whole pitch. */}
          <span class="mt-0.5 block text-[0.8125rem] leading-relaxed text-body">
            Your office list differs? Upload it and plan around the days you
            actually get.
          </span>
        </span>

        {/* Hidden below `sm`: at 320px the arrow was taking width the sentence
             needed, and the whole card is the link either way. */}
        <span
          class="hidden shrink-0 text-muted transition-transform group-hover:translate-x-0.5 sm:block"
          aria-hidden="true">→</span
        >
      </div>
    </a>
  </div>
</section>

<script>
  import {
    solveVacationPlans,
    getUpcomingCutoffIso,
    isCalendarExhausted,
    MAX_LEAVES,
    type RegionCode,
  } from "../data/vacation-solver";
  import { createMenu, type MenuHandle } from "../scripts/menu";
  import { nextBreaks, pluralLeaves } from "../scripts/plan-view";

  /* The live region and work week. The badge used to hardcode region "ALL", so
     a visitor who picked another country was still told the next break was
     Raksha Bandhan — an Indian festival not in their holiday list at all. */
  let region: RegionCode = "IN";
  let workWeek = 5;
  let leaves = 0;

  /**
   * The capsule owns the budget menu only.
   *
   * The country picker beside it is a RegionMenu, and Navbar.astro's
   * initRegion() binds every RegionMenu on the page — including this one — so
   * building a second createMenu over the same trigger here would install a
   * duplicate set of document and window listeners that nothing ever removes.
   * The hero learns about country changes the same way the rest of the page
   * does: by listening for `lw:region`.
   */
  function setupCapsule() {
    const el = (id: string) => document.getElementById(id);
    const budgetTrigger = el("heroBudgetTrigger");
    const budgetMenu = el("heroBudgetMenu");
    const budgetDisplay = el("heroBudgetDisplay");
    const customPick = el("heroBudgetCustomPick");
    const customInput = el("heroBudgetInput") as HTMLInputElement | null;
    const btnDec = el("heroBudgetDec") as HTMLButtonElement | null;
    const btnInc = el("heroBudgetInc") as HTMLButtonElement | null;
    const searchBtn = el("heroSearchActionBtn");
    const menuGoBtn = el("heroBudgetGo");

    let budgetHandle: MenuHandle | null = null;

    /**
     * Where the stepper's range starts, read back off the field the markup
     * rendered it into rather than repeated here. CUSTOM_MIN is derived from
     * BUDGETS at build time, so moving a number between the named list and the
     * stepper stays a one-line edit up there.
     */
    const CUSTOM_MIN = Number(customInput?.min) || 0;

    /**
     * The number the stepper is showing, which is NOT always the budget.
     *
     * Choosing "1 leave" does not drag the stepper down to 1 — it cannot, 1 is
     * below its floor — so the two have to be tracked apart, the same way the
     * results rail keeps its compound pill's figure while a plain pill is
     * pressed. `leaves` is what the page is asked for; this is what the row
     * beneath the presets is offering.
     */
    let customValue = CUSTOM_MIN;

    /** The preset that names a number, for the few that have one. */
    const presetFor = (n: number) =>
      budgetMenu?.querySelector(`[role="menuitemradio"][data-leaves="${n}"]`) ??
      null;

    /**
     * The single way in for every path that changes the budget.
     *
     * The presets, the label, both steppers and the number field all land here,
     * so the value in the capsule, the tick in the menu and the figure in the
     * field cannot end up telling three different stories — which is exactly
     * what a second `leaves = ...` assignment anywhere else would produce.
     */
    function setBudget(n: number) {
      const wanted = Number.isFinite(n) ? Math.round(n) : 0;
      leaves = Math.min(MAX_LEAVES, Math.max(0, wanted));

      // Only a budget past the presets belongs to the stepper.
      const named = presetFor(leaves);
      if (!named) customValue = leaves;

      /* Written BEFORE setValue, which is what reads a label into the capsule.
         The presets carry a fixed one; this row's changes with its figure, so
         the capsule can say "6 leaves" without this file writing it there. */
      if (customPick) customPick.dataset.label = pluralLeaves(customValue);
      budgetHandle?.setValue(named ? String(leaves) : "custom");

      /* Never while the caret is in the field: rewriting `value` moves the
         caret to the end, so the "1" on the way to "10" would be shunted about
         under the typist. Normalised on blur instead. */
      if (customInput && document.activeElement !== customInput) {
        customInput.value = String(customValue);
      }
      if (btnDec) btnDec.disabled = customValue <= CUSTOM_MIN;
      if (btnInc) btnInc.disabled = customValue >= MAX_LEAVES;
    }

    /** A step, held inside the stepper's own range rather than the budget's. */
    const stepTo = (n: number) =>
      setBudget(Math.min(MAX_LEAVES, Math.max(CUSTOM_MIN, n)));

    if (budgetTrigger && budgetMenu && budgetDisplay) {
      budgetHandle = createMenu({
        trigger: budgetTrigger,
        menu: budgetMenu,
        display: budgetDisplay,
        valueAttr: "data-leaves",
        // "custom" is the label row asking for the number it is showing; every
        // other value names itself.
        onSelect: (v) => setBudget(v === "custom" ? customValue : Number(v)),
      });
    }

    btnDec?.addEventListener("click", () => stepTo(customValue - 1));
    btnInc?.addEventListener("click", () => stepTo(customValue + 1));

    if (customInput) {
      // Aliased so the listeners below can be written against a field that is
      // known to exist. `customInput?.addEventListener(...)` narrows the
      // optional chain but not the body of the callback it is handed.
      const field = customInput;

      /* Anything below the floor is a half-typed number, not a request: the
         "1" of a "10" would otherwise apply 3 on its way past, and an emptied
         field would apply it again. Both wait for something in range. */
      field.addEventListener("input", () => {
        const typed = Number(field.value);
        if (!Number.isFinite(typed) || typed < CUSTOM_MIN) return;
        stepTo(typed);
      });

      /* Whatever was typed, the field ends up showing what was applied: "25"
         and "1e5" and a half-finished "1" all leave it stating the budget the
         row actually holds. */
      field.addEventListener("blur", () => {
        field.value = String(customValue);
      });

      /* Enter is "done". The number is already applied, so there is nothing
         left to submit — only a menu standing open over the page. */
      field.addEventListener("keydown", (e) => {
        if (e.key !== "Enter") return;
        e.preventDefault();
        field.value = String(customValue);
        budgetHandle?.close();
      });
    }

    // Paints the initial state onto controls the markup can only guess at:
    // which stepper is at its limit, and which row carries the tick.
    setBudget(leaves);

    function runSearch() {
      document.dispatchEvent(
        new CustomEvent("lw:search", { detail: { region, leaves } })
      );
    }

    searchBtn?.addEventListener("click", runSearch);

    /* The phone-only twin inside the menu. It closes without handing focus
       back to the trigger, because the page is about to scroll to the results
       and pulling focus up to the capsule would fight that. */
    menuGoBtn?.addEventListener("click", () => {
      budgetHandle?.close(false);
      runSearch();
    });
  }

  /**
   * Names the soonest break so the promise at the top of the page is concrete.
   *
   * Recomputed rather than rendered once: region and work week both change what
   * "next" means, and the cutoff is read from the visitor's clock on every call,
   * so returning to an already-open tab days later still gives a truthful
   * answer rather than whatever was true when the page loaded.
   */
  function renderCountdownBadge() {
    const badge = document.getElementById("heroCountdownBadge");
    if (!badge) return;

    if (isCalendarExhausted()) {
      badge.textContent = "The 2026 calendar has run out — new dates coming";
      return;
    }

    const cutoff = getUpcomingCutoffIso();

    // Deliberately the same call the highlight list below makes, so the badge
    // cannot name one break while the list opens with another.
    //
    // It used to walk leave budgets from cheapest and take the earliest plan
    // within the first budget that had anything. That reads as "next" but is
    // not: standing on 14 Feb 2026 the cheapest budget's first free break was
    // Good Friday on 3 April, so the badge announced it while Id-ul-Fitr sat
    // seven weeks nearer on 20 March, unmentioned. nextBreaks() orders by date
    // first and treats cost as the tie-break within one festival.
    const next = nextBreaks((l) =>
      solveVacationPlans({ leaves: l, workWeek, region, month: "ALL", fromDate: cutoff })
    )[0];

    if (!next) {
      badge.textContent = "No long weekends left on this calendar";
      return;
    }

    let name = next.title.split(":")[0].replace(/\(.*?\)/g, "").trim();
    if (!name) {
      name = next.days.find((d) => d.type === "holiday")?.label || "";
    }

    const days = next.totalDaysOff || 3;
    const cost =
      next.leavesRequired === 0
        ? "no leaves"
        : `${next.leavesRequired} ${next.leavesRequired === 1 ? "leave" : "leaves"}`;

    badge.textContent = name
      ? `Next up: ${name} — ${days} days off for ${cost}`
      : `Next up: ${days} days off for ${cost}`;
  }

  function init() {
    setupCapsule();
    renderCountdownBadge();

    // The navbar owns the region controls; the hero only tracks what they say,
    // so its badge can never contradict the grid below it.
    //
    // Both channels are listened to on purpose. `lw:region` is a user change
    // coming from a picker; `lw:setregion` is a programmatic one, which is how
    // a deep link such as /?region=DE arrives. Missing the second left the
    // badge naming an Indian festival on a page already switched to Germany.
    function syncRegion(e: Event) {
      const next = (e as CustomEvent<{ region: string }>).detail?.region;
      if (!next || next === region) return; // our own echo, or a no-op change
      region = next as RegionCode;
      renderCountdownBadge();
    }

    document.addEventListener("lw:region", syncRegion);
    document.addEventListener("lw:setregion", syncRegion);

    document.addEventListener("lw:workweek", (e) => {
      workWeek = (e as CustomEvent<{ workWeek: number }>).detail.workWeek || 5;
      renderCountdownBadge();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
