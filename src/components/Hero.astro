---
---
<section class="relative pt-14 pb-16 px-4 sm:px-6 bg-[#0c0c0e] border-b border-zinc-800/80">
  <!-- Glowing backdrop accents -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-[#ff2b63]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-10 right-0 w-80 h-80 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-[1200px] mx-auto relative z-10 flex flex-col items-center text-center">
    
    <!-- 1. Top Capsule Countdown Badge -->
    <a href="#vacationGrid" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-900/90 text-zinc-300 border border-zinc-800 text-xs font-medium mb-6 shadow-md hover:border-zinc-700 hover:text-white transition-all no-underline group">
      <span class="text-sm" aria-hidden="true">🌴</span>
      <span id="heroCountdownBadge">Next: Raksha Bandhan (3 Days Off · 0 Leaves Needed)</span>
      <span class="text-zinc-500 group-hover:text-white group-hover:translate-x-0.5 transition-all">›</span>
    </a>

    <!-- 2. Main Headline (H1) -->
    <h1 class="text-3xl sm:text-5xl lg:text-[56px] font-extrabold text-white tracking-tight leading-[1.1] max-w-[850px] mb-3">
      Find your next <span class="text-[#ff2b63]">long weekend</span>
    </h1>

    <!-- 3. Subtext Tagline -->
    <p class="text-sm sm:text-base text-zinc-400 max-w-[620px] mb-8 leading-relaxed font-medium">
      Turn holidays into vacations. We find the best long weekends so you can take fewer leaves and travel more.
    </p>

    <!-- 4. Airbnb-Style Pro Search Capsule with Z-100 Popovers -->
    <div class="w-full max-w-[680px] relative z-30 mb-7">
      <div class="bg-zinc-900/95 border border-zinc-800 rounded-full p-2 sm:p-2.5 flex items-center justify-between shadow-2xl hover:border-zinc-700 transition-all relative z-20">
        
        <!-- Region Selector Block -->
        <div class="flex-1 px-3 sm:px-4 text-left cursor-pointer group relative" id="heroRegionTrigger">
          <span class="font-mono text-[10px] font-bold text-zinc-500 uppercase tracking-widest block mb-0.5 pointer-events-none">Region</span>
          <div class="flex items-center justify-between pointer-events-none">
            <span id="heroRegionDisplay" class="font-extrabold text-white text-xs sm:text-sm group-hover:text-[#ff2b63] transition-colors">Pan-India IT</span>
            <span class="text-[10px] text-zinc-500 ml-1 transform transition-transform" id="heroRegionArrow">▼</span>
          </div>
        </div>

        <span class="border-r border-zinc-800 h-8 mx-1"></span>

        <!-- Leave Budget Block -->
        <div class="flex-1 px-3 sm:px-4 text-left cursor-pointer group relative" id="heroBudgetTrigger">
          <span class="font-mono text-[10px] font-bold text-zinc-500 uppercase tracking-widest block mb-0.5 pointer-events-none">Leave Budget</span>
          <div class="flex items-center justify-between pointer-events-none">
            <span id="heroBudgetDisplay" class="font-extrabold text-white text-xs sm:text-sm group-hover:text-[#ff2b63] transition-colors">0 Leaves (Free)</span>
            <span class="text-[10px] text-zinc-500 ml-1 transform transition-transform" id="heroBudgetArrow">▼</span>
          </div>
        </div>

        <!-- Action Search Button -->
        <button 
          type="button" 
          id="heroSearchActionBtn"
          class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#ff2b63] hover:bg-[#e11d48] text-white flex items-center justify-center shadow-lg transition-all transform active:scale-95 cursor-pointer shrink-0 ml-2"
          title="Search Vacations"
        >
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>

      </div>

      <!-- PRO FLOATING REGION POPOVER (Z-100 - OPENS UPWARD TO AVOID STICKY BAR COLLISION) -->
      <div id="heroRegionPopover" class="hidden absolute bottom-[calc(100%+12px)] left-0 w-80 bg-[#141417]/98 border border-zinc-700/80 rounded-2xl p-2.5 shadow-2xl shadow-black/90 z-[100] text-left animate-in fade-in zoom-in-95 backdrop-blur-xl">
        <div class="text-[10px] font-mono font-bold text-zinc-400 uppercase tracking-wider px-3 py-1.5 border-b border-zinc-800/80 mb-1.5 flex items-center justify-between">
          <span>Select Region</span>
          <span class="text-[9px] text-[#ff2b63]">2 Supported</span>
        </div>
        <button type="button" class="w-full text-left flex items-center gap-3 px-3.5 py-3 rounded-xl border border-transparent hover:border-zinc-700 hover:bg-zinc-800/80 transition-all group cursor-pointer hero-popover-option" data-region="ALL">
          <span class="text-2xl">🇮🇳</span>
          <div class="flex flex-col flex-1 min-w-0">
            <span class="font-bold text-xs text-white group-hover:text-[#ff2b63] transition-colors">Pan-India IT</span>
            <span class="text-[11px] text-zinc-400">Public & IT Gazetted Holidays</span>
          </div>
        </button>
        <button type="button" class="w-full text-left flex items-center gap-3 px-3.5 py-3 rounded-xl border border-transparent hover:border-zinc-700 hover:bg-zinc-800/80 transition-all group cursor-pointer hero-popover-option" data-region="USA">
          <span class="text-2xl">🇺🇸</span>
          <div class="flex flex-col flex-1 min-w-0">
            <span class="font-bold text-xs text-white group-hover:text-[#ff2b63] transition-colors">United States</span>
            <span class="text-[11px] text-zinc-400">US Federal Public Holidays</span>
          </div>
        </button>
      </div>

      <!-- PRO FLOATING BUDGET POPOVER (Z-100 - OPENS UPWARD TO AVOID STICKY BAR COLLISION) -->
      <div id="heroBudgetPopover" class="hidden absolute bottom-[calc(100%+12px)] right-0 w-84 bg-[#141417]/98 border border-zinc-700/80 rounded-2xl p-2.5 shadow-2xl shadow-black/90 z-[100] text-left animate-in fade-in zoom-in-95 backdrop-blur-xl">
        <div class="text-[10px] font-mono font-bold text-zinc-400 uppercase tracking-wider px-3 py-1.5 border-b border-zinc-800/80 mb-1.5 flex items-center justify-between">
          <span>Select PTO Leave Budget</span>
          <span class="text-[9px] text-[#ff2b63]">4 Tiers</span>
        </div>
        <button type="button" class="w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl border border-transparent hover:border-zinc-700 hover:bg-zinc-800/80 transition-all group cursor-pointer hero-budget-option" data-leaves="0">
          <span class="text-xl">🆓</span>
          <div class="flex flex-col flex-1 min-w-0">
            <span class="font-bold text-xs text-white group-hover:text-[#ff2b63] transition-colors">0 Leaves (Free)</span>
            <span class="text-[11px] text-zinc-400">Direct 3-day weekend breaks</span>
          </div>
        </button>
        <button type="button" class="w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl border border-transparent hover:border-zinc-700 hover:bg-zinc-800/80 transition-all group cursor-pointer hero-budget-option" data-leaves="1">
          <span class="text-xl">🌴</span>
          <div class="flex flex-col flex-1 min-w-0">
            <span class="font-bold text-xs text-white group-hover:text-[#ff2b63] transition-colors">1 Leave</span>
            <span class="text-[11px] text-zinc-400">Smart 4-day bridge vacations</span>
          </div>
        </button>
        <button type="button" class="w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl border border-transparent hover:border-zinc-700 hover:bg-zinc-800/80 transition-all group cursor-pointer hero-budget-option" data-leaves="2">
          <span class="text-xl">✈️</span>
          <div class="flex flex-col flex-1 min-w-0">
            <span class="font-bold text-xs text-white group-hover:text-[#ff2b63] transition-colors">2 Leaves</span>
            <span class="text-[11px] text-zinc-400">Extended 5-6 day getaways</span>
          </div>
        </button>
        <button type="button" class="w-full text-left flex items-center gap-3 px-3.5 py-2.5 rounded-xl border border-transparent hover:border-zinc-700 hover:bg-zinc-800/80 transition-all group cursor-pointer hero-budget-option" data-leaves="3">
          <span class="text-xl">🎉</span>
          <div class="flex flex-col flex-1 min-w-0">
            <span class="font-bold text-xs text-white group-hover:text-[#ff2b63] transition-colors">3+ Leaves</span>
            <span class="text-[11px] text-zinc-400">Mega week-long festival trips</span>
          </div>
        </button>
      </div>

    </div>

    <!-- 5. HIGH-END GRADIENT CTA BUTTON FOR OFFICE HOLIDAY LIST -->
    <a 
      href="/company-optimizer" 
      class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-gradient-to-r from-rose-500/10 via-zinc-900 to-rose-500/10 border border-rose-500/40 hover:border-rose-500/80 shadow-lg shadow-rose-950/30 hover:shadow-rose-500/20 text-white font-extrabold text-xs sm:text-sm transition-all duration-300 transform hover:scale-[1.02] active:scale-95 no-underline group"
    >
      <span class="w-7 h-7 rounded-full bg-rose-500/20 text-[#ff2b63] flex items-center justify-center text-sm font-bold border border-rose-500/30 group-hover:scale-110 transition-transform">🏢</span>
      <span class="tracking-tight text-zinc-200 group-hover:text-white transition-colors">Upload your office holiday list</span>
      <span class="text-[#ff2b63] font-bold text-sm group-hover:translate-x-1 transition-transform">→</span>
    </a>

  </div>
</section>

<script>
  import { solveVacationPlans, getTodayIso } from "../data/vacation-solver";

  function setupHeroPopovers() {
    const regionTrigger = document.getElementById("heroRegionTrigger");
    const regionPopover = document.getElementById("heroRegionPopover");
    const regionArrow = document.getElementById("heroRegionArrow");

    const budgetTrigger = document.getElementById("heroBudgetTrigger");
    const budgetPopover = document.getElementById("heroBudgetPopover");
    const budgetArrow = document.getElementById("heroBudgetArrow");

    if (regionTrigger && regionPopover) {
      regionTrigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const isHidden = regionPopover.classList.contains("hidden");
        budgetPopover?.classList.add("hidden");
        if (budgetArrow) budgetArrow.style.transform = "rotate(0deg)";
        
        if (isHidden) {
          regionPopover.classList.remove("hidden");
          if (regionArrow) regionArrow.style.transform = "rotate(180deg)";
        } else {
          regionPopover.classList.add("hidden");
          if (regionArrow) regionArrow.style.transform = "rotate(0deg)";
        }
      });
    }

    if (budgetTrigger && budgetPopover) {
      budgetTrigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const isHidden = budgetPopover.classList.contains("hidden");
        regionPopover?.classList.add("hidden");
        if (regionArrow) regionArrow.style.transform = "rotate(0deg)";

        if (isHidden) {
          budgetPopover.classList.remove("hidden");
          if (budgetArrow) budgetArrow.style.transform = "rotate(180deg)";
        } else {
          budgetPopover.classList.add("hidden");
          if (budgetArrow) budgetArrow.style.transform = "rotate(0deg)";
        }
      });
    }

    // Dismiss popovers on option selection
    document.querySelectorAll(".hero-popover-option").forEach((opt) => {
      opt.addEventListener("click", (e) => {
        e.stopPropagation();
        regionPopover?.classList.add("hidden");
        if (regionArrow) regionArrow.style.transform = "rotate(0deg)";
      });
    });

    document.querySelectorAll(".hero-budget-option").forEach((opt) => {
      opt.addEventListener("click", (e) => {
        e.stopPropagation();
        budgetPopover?.classList.add("hidden");
        if (budgetArrow) budgetArrow.style.transform = "rotate(0deg)";
      });
    });

    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (regionPopover && !regionPopover.contains(target) && regionTrigger && !regionTrigger.contains(target)) {
        regionPopover.classList.add("hidden");
        if (regionArrow) regionArrow.style.transform = "rotate(0deg)";
      }
      if (budgetPopover && !budgetPopover.contains(target) && budgetTrigger && !budgetTrigger.contains(target)) {
        budgetPopover.classList.add("hidden");
        if (budgetArrow) budgetArrow.style.transform = "rotate(0deg)";
      }
    });

    window.addEventListener("scroll", () => {
      regionPopover?.classList.add("hidden");
      budgetPopover?.classList.add("hidden");
      if (regionArrow) regionArrow.style.transform = "rotate(0deg)";
      if (budgetArrow) budgetArrow.style.transform = "rotate(0deg)";
    });
  }

  function initDynamicHeroBadge() {
    const badge = document.getElementById("heroCountdownBadge");
    if (!badge) return;

    const today = getTodayIso();

    for (let l = 0; l <= 4; l++) {
      const plans = solveVacationPlans({
        leaves: l,
        workWeek: 5,
        region: "ALL",
        month: "ALL",
        fromDate: today
      });

      let upcoming = plans.filter(p => p.startDate > today);
      if (upcoming.length === 0) {
        upcoming = plans.filter(p => p.startDate >= today);
      }

      if (upcoming.length > 0) {
        upcoming.sort((a, b) => a.startDate.localeCompare(b.startDate));
        const nextPlan = upcoming[0];
        
        let label = nextPlan.title.split(":")[0].replace(/\(.*?\)/g, "").trim();
        if (!label && nextPlan.days && nextPlan.days.length > 0) {
          const hol = nextPlan.days.find(d => d.type === "holiday");
          if (hol) label = hol.label;
        }
        
        const daysOff = nextPlan.totalDaysOff || 3;
        const leaves = typeof nextPlan.leavesRequired === "number" ? nextPlan.leavesRequired : l;
        const leavesText = leaves === 0 ? "0 Leaves Needed" : `${leaves} ${leaves === 1 ? 'Leave' : 'Leaves'} Needed`;

        badge.textContent = `Next: ${label} (${daysOff} Days Off · ${leavesText})`;
        return;
      }
    }

    badge.textContent = "Year-End Getaways · 2027 Plans Available Soon";
  }

  function initAll() {
    setupHeroPopovers();
    initDynamicHeroBadge();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll);
  } else {
    initAll();
  }
</script>

