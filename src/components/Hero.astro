---
<section class="relative pt-24 pb-20 px-6 border-b border-zinc-200 bg-white overflow-hidden">
  <div class="max-w-[1000px] mx-auto relative z-10 text-center flex flex-col items-center">
    
    <!-- 1. Clean Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-700 text-xs font-semibold mb-8">
      <svg class="w-3.5 h-3.5 text-zinc-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      <span id="heroCountdownBadge" class="font-display tracking-tight">Scanning for optimal long weekends...</span>
    </div>

    <!-- 2. Main Headline & Tagline -->
    <h1 class="font-display text-4xl sm:text-6xl lg:text-[64px] font-extrabold text-zinc-900 tracking-tight leading-[1.1] max-w-[850px] mb-6">
      Stop waiting for holidays. <br/><span class="text-zinc-600">Start taking them.</span>
    </h1>
    <p class="text-lg sm:text-xl text-zinc-500 max-w-[650px] leading-relaxed font-normal mb-10">
      We automatically combine your weekends with official public holidays to give you the longest possible breaks, using the absolute minimum PTO. 
    </p>

  </div>
</section>

<script>
  import { solveVacationPlans, getTodayIso } from "../data/vacation-solver";

  function initDynamicHeroBadge() {
    const badge = document.getElementById("heroCountdownBadge");
    if (!badge) return;

    const today = getTodayIso();

    for (let l = 0; l <= 4; l++) {
      const plans = solveVacationPlans({
        leaves: l,
        workWeek: 5,
        region: "ALL",
        month: "ALL",
        fromDate: today
      });

      let upcoming = plans.filter(p => p.startDate > today);
      if (upcoming.length === 0) {
        upcoming = plans.filter(p => p.startDate >= today);
      }

      if (upcoming.length > 0) {
        upcoming.sort((a, b) => a.startDate.localeCompare(b.startDate));
        const nextPlan = upcoming[0];
        
        let label = nextPlan.title.split(":")[0].replace(/\(.*?\)/g, "").trim();
        if (!label && nextPlan.days && nextPlan.days.length > 0) {
          const hol = nextPlan.days.find(d => d.type === "holiday");
          if (hol) label = hol.label;
        }
        
        const daysOff = nextPlan.totalDaysOff || 3;
        const leaves = typeof nextPlan.leavesRequired === "number" ? nextPlan.leavesRequired : l;
        const leavesText = leaves === 0 ? "0 PTO" : `${leaves} PTO`;

        badge.innerHTML = `<span class="text-zinc-500 font-medium">Next up:</span> <span class="font-bold text-zinc-900">${label}</span> <span class="text-zinc-300 mx-1.5">•</span> ${daysOff} Days Off <span class="text-zinc-300 mx-1.5">•</span> ${leavesText}`;
        return;
      }
    }

    badge.innerHTML = "Year-End Getaways · 2027 Plans Available Soon";
  }

  initDynamicHeroBadge();
  document.addEventListener("astro:page-load", initDynamicHeroBadge);
</script>
