---
/**
 * Hero: headline + the Airbnb-style search capsule.
 *
 * Rebuilt for keyboard use. The two selectors used to be <div>s with click
 * handlers, so they could not be reached by Tab, had no aria-expanded, and
 * marked their chosen option with `bg-zinc-800/80` — invisible on a light
 * popover. They are now real buttons driving a `menuitemradio` menu.
 *
 * Emits `lw:search` with { region, leaves } when the user presses Search.
 */
const REGIONS = [
  {
    value: "ALL",
    flag: "🇮🇳",
    label: "Pan-India IT",
    hint: "Gazetted public + IT sector holidays",
  },
  {
    value: "USA",
    flag: "🇺🇸",
    label: "United States",
    hint: "US federal public holidays",
  },
];

const BUDGETS = [
  {
    value: "0",
    glyph: "🆓",
    label: "No leaves",
    hint: "Breaks that cost you nothing",
  },
  { value: "1", glyph: "🌴", label: "1 leave", hint: "One day buys a 4-day trip" },
  { value: "2", glyph: "✈️", label: "2 leaves", hint: "Enough for 5–6 days away" },
  { value: "3", glyph: "🎉", label: "3 leaves", hint: "Full week over a festival" },
];
---

<section class="relative overflow-hidden px-4 sm:px-6 pt-12 pb-14 sm:pt-16 sm:pb-16">
  <!-- Ambient warmth. Decorative only, so kept out of the a11y tree and
       deliberately faint enough not to shift text contrast. -->
  <div
    class="absolute -top-40 -left-32 w-[26rem] h-[26rem] rounded-full bg-brand/8 blur-3xl pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -top-24 -right-24 w-[22rem] h-[22rem] rounded-full bg-brand-400/8 blur-3xl pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative max-w-[1280px] mx-auto flex flex-col items-center text-center"
  >
    <a
      href="#results"
      class="group inline-flex items-center gap-2 mb-7 pl-3 pr-2.5 py-1.5 rounded-full bg-surface border border-hairline shadow-soft text-[0.8125rem] font-semibold text-body hover:border-hairline-strong hover:text-ink transition-colors no-underline"
    >
      <span class="dot dot-holiday" aria-hidden="true"></span>
      <span id="heroCountdownBadge">Every long weekend left in 2026</span>
      <span
        class="text-muted group-hover:translate-x-0.5 transition-transform"
        aria-hidden="true">→</span
      >
    </a>

    <h1
      class="text-[2rem] sm:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.08] max-w-[54rem] mb-4"
    >
      Find your next <span class="text-brand-text">long weekend</span>
    </h1>

    <p class="text-base sm:text-lg text-body max-w-[38rem] mb-9 leading-relaxed">
      Your leave balance is finite. Public holidays are not. Tell us how many
      days you can spare and we'll show you the longest break each one buys.
    </p>

    <!-- Search capsule ------------------------------------------------------ -->
    <div class="w-full max-w-[42rem] relative">
      <div
        class="flex items-center gap-1 p-2 rounded-full bg-surface border border-hairline shadow-lift"
      >
        <!-- Region -->
        <button
          type="button"
          id="heroRegionTrigger"
          class="seg"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="heroRegionMenu"
        >
          <span class="seg-label">Where you work</span>
          <span class="flex items-center justify-between gap-1">
            <span class="seg-value" id="heroRegionDisplay">Pan-India IT</span>
            <svg
              class="seg-caret w-3 h-3 text-muted shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </span>
        </button>

        <span class="w-px h-9 bg-hairline shrink-0" aria-hidden="true"></span>

        <!-- Leave budget -->
        <button
          type="button"
          id="heroBudgetTrigger"
          class="seg"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="heroBudgetMenu"
        >
          <span class="seg-label">Days you can spare</span>
          <span class="flex items-center justify-between gap-1">
            <span class="seg-value" id="heroBudgetDisplay">No leaves</span>
            <svg
              class="seg-caret w-3 h-3 text-muted shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </span>
        </button>

        <button
          type="button"
          id="heroSearchActionBtn"
          class="btn btn-brand shrink-0"
          aria-label="Show plans"
        >
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="hidden sm:inline">Show plans</span>
        </button>
      </div>

      <!-- Menus open upward so they never fight the sticky filter bar. -->
      <div
        id="heroRegionMenu"
        role="menu"
        aria-labelledby="heroRegionTrigger"
        hidden
        class="popover absolute bottom-[calc(100%+0.625rem)] left-0 w-[min(22rem,calc(100vw-2rem))] p-2 z-50 text-left"
      >
        {
          REGIONS.map((r, i) => (
            <button
              type="button"
              role="menuitemradio"
              aria-checked={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="menu-item"
              data-region={r.value}
              data-label={r.label}
            >
              <span class="text-xl shrink-0" aria-hidden="true">
                {r.flag}
              </span>
              <span class="min-w-0">
                <span class="block text-[0.8125rem] font-bold text-ink">
                  {r.label}
                </span>
                <span class="block text-xs text-muted">{r.hint}</span>
              </span>
            </button>
          ))
        }
      </div>

      <div
        id="heroBudgetMenu"
        role="menu"
        aria-labelledby="heroBudgetTrigger"
        hidden
        class="popover absolute bottom-[calc(100%+0.625rem)] right-0 w-[min(23rem,calc(100vw-2rem))] p-2 z-50 text-left"
      >
        {
          BUDGETS.map((b, i) => (
            <button
              type="button"
              role="menuitemradio"
              aria-checked={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="menu-item"
              data-leaves={b.value}
              data-label={b.label}
            >
              <span class="text-xl shrink-0" aria-hidden="true">
                {b.glyph}
              </span>
              <span class="min-w-0">
                <span class="block text-[0.8125rem] font-bold text-ink">
                  {b.label}
                </span>
                <span class="block text-xs text-muted">{b.hint}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <a
      href="/company-optimizer"
      class="group inline-flex items-center gap-2.5 mt-7 px-4 py-2.5 rounded-full border border-brand-200 bg-brand-50 text-[0.8125rem] font-bold text-brand-text hover:border-brand-300 transition-colors no-underline"
    >
      <span aria-hidden="true">🏢</span>
      <span>Your office list differs? Upload it</span>
      <span
        class="group-hover:translate-x-0.5 transition-transform"
        aria-hidden="true">→</span
      >
    </a>
  </div>
</section>

<script>
  import { solveVacationPlans, getTodayIso } from "../data/vacation-solver";
  import { createMenu } from "../scripts/menu";

  function setupCapsule() {
    const el = (id: string) => document.getElementById(id);
    const regionTrigger = el("heroRegionTrigger");
    const regionMenu = el("heroRegionMenu");
    const regionDisplay = el("heroRegionDisplay");
    const budgetTrigger = el("heroBudgetTrigger");
    const budgetMenu = el("heroBudgetMenu");
    const budgetDisplay = el("heroBudgetDisplay");
    const searchBtn = el("heroSearchActionBtn");

    let region = "ALL";
    let leaves = 0;

    if (regionTrigger && regionMenu && regionDisplay) {
      createMenu({
        trigger: regionTrigger,
        menu: regionMenu,
        display: regionDisplay,
        valueAttr: "data-region",
        onSelect: (v) => {
          region = v;
        },
      });
    }

    if (budgetTrigger && budgetMenu && budgetDisplay) {
      createMenu({
        trigger: budgetTrigger,
        menu: budgetMenu,
        display: budgetDisplay,
        valueAttr: "data-leaves",
        onSelect: (v) => {
          leaves = Number(v) || 0;
        },
      });
    }

    searchBtn?.addEventListener("click", () => {
      document.dispatchEvent(
        new CustomEvent("lw:search", { detail: { region, leaves } })
      );
    });
  }

  /** Names the soonest break so the promise at the top of the page is concrete. */
  function initCountdownBadge() {
    const badge = document.getElementById("heroCountdownBadge");
    if (!badge) return;

    const today = getTodayIso();

    for (let l = 0; l <= 4; l++) {
      const plans = solveVacationPlans({
        leaves: l,
        workWeek: 5,
        region: "ALL",
        month: "ALL",
        fromDate: today,
      });

      let upcoming = plans.filter((p) => p.startDate > today);
      if (!upcoming.length) upcoming = plans.filter((p) => p.startDate >= today);
      if (!upcoming.length) continue;

      upcoming.sort((a, b) => a.startDate.localeCompare(b.startDate));
      const next = upcoming[0];

      let name = next.title.split(":")[0].replace(/\(.*?\)/g, "").trim();
      if (!name) {
        name = next.days.find((d) => d.type === "holiday")?.label || "";
      }

      const days = next.totalDaysOff || 3;
      const cost =
        next.leavesRequired === 0
          ? "no leaves"
          : `${next.leavesRequired} ${next.leavesRequired === 1 ? "leave" : "leaves"}`;

      badge.textContent = name
        ? `Next up: ${name} — ${days} days off for ${cost}`
        : `Next up: ${days} days off for ${cost}`;
      return;
    }

    badge.textContent = "Every long weekend left in 2026";
  }

  function init() {
    setupCapsule();
    initCountdownBadge();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
