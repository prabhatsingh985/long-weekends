---
---
<section class="relative pt-14 pb-12 px-6 border-b border-[#ebebeb] mesh-gradient-bg overflow-hidden">
  <div class="max-w-[1200px] mx-auto relative z-10">
    
    <!-- Live Countdown Pill: Next Long Weekend in 9 Days -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#171717] text-white text-xs font-medium mb-6 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-[#50e3c2] animate-pulse"></span>
      <span id="heroCountdownBadge">Next Long Weekend in 9 Days: Raksha Bandhan (3 Days Off Free)</span>
    </div>

    <!-- Main Headline -->
    <h1 class="display-xl text-[#171717] max-w-[850px] mb-4">
      The math behind your year off.
    </h1>

    <!-- Lead Paragraph -->
    <p class="text-lg text-[#4d4d4d] max-w-[640px] mb-8 leading-relaxed">
      Maximize your continuous days off with algorithmically calculated leave bridges, regional gazetted holiday hacks, and exact leave budget solver.
    </p>

    <!-- Stat Highlights Row: Punchy & Engaging Copy -->
    <div class="flex items-center gap-6 flex-wrap">
      
      <!-- Stat 1: The Ultimate Year-End Hack (4 Leaves -> 10 Days) -->
      <div class="flex items-center gap-3.5 bg-white px-5 py-3.5 rounded-xl border border-[#ebebeb] shadow-sm hover:border-[#a1a1a1] transition-all">
        <span class="font-mono text-2xl font-bold text-[#171717]" id="heroTopDaysOff">10 Days</span>
        <span class="text-xs text-[#666666] font-medium leading-tight">
          Turn 4 Leaves into 10 Days<br/>
          <span class="text-[#10b981] font-bold">25 Dec – 03 Jan (Year-End Break)</span>
        </span>
      </div>

      <!-- Stat 2: Max ROI Multiplier -->
      <div class="flex items-center gap-3.5 bg-white px-5 py-3.5 rounded-xl border border-[#ebebeb] shadow-sm hover:border-[#a1a1a1] transition-all">
        <span class="font-mono text-2xl font-bold text-[#0070f3]">5.0x</span>
        <span class="text-xs text-[#666666] font-medium leading-tight">
          Max Leave Multiplier<br/>
          <span class="text-[#0070f3] font-semibold">Take 1 Leave ➔ Get 5 Days Off</span>
        </span>
      </div>

      <!-- Stat 3: 100% Verified Gazettes -->
      <div class="flex items-center gap-3.5 bg-white px-5 py-3.5 rounded-xl border border-[#ebebeb] shadow-sm hover:border-[#a1a1a1] transition-all">
        <span class="font-mono text-2xl font-bold text-[#7928ca]">100%</span>
        <span class="text-xs text-[#666666] font-medium leading-tight">
          Verified Holiday Data<br/>
          <span class="text-[#7928ca] font-semibold">DoPT & RBI 2026 Gazettes</span>
        </span>
      </div>

    </div>

  </div>
</section>
