---
/**
 * A small country flag, drawn rather than typed.
 *
 * The regions used to be the flag emoji, which is a pair of Regional Indicator
 * letters that the font is expected to fuse into one glyph. Windows never has:
 * Segoe UI Emoji ships no flag glyphs, so Chrome and Edge on Windows fall back
 * to drawing the letters themselves and the region menu rendered as bare "IN"
 * and "US" tiles that looked like broken images. Roughly half the audience for
 * a work-holiday planner is on Windows, so the emoji was never a safe way to
 * say this.
 *
 * The artwork lives in src/data/flags.ts and is emitted once per page by
 * FlagSprite.astro; this component is the reference to it. It used to hold the
 * two flags inline, which was reasonable at two countries and is not at
 * forty-seven — the homepage draws the country list three times over.
 *
 * `code` is the ISO-3166 alpha-2 code, matching the keys of the country data.
 * An unknown code falls back to a neutral tile rather than an empty box, so a
 * country added to the data before its artwork still renders something with the
 * right footprint.
 */
import { FLAGS } from "../data/flags";

interface Props {
  code: string;
  /** Extra classes for sizing in context. */
  class?: string;
  /**
   * Accessible name. Omit it wherever the flag sits beside its own country
   * name, which is every current usage — naming it there would make a menu item
   * announce as "India India Gazetted public…".
   */
  label?: string;
}

const { code, class: extra = "", label } = Astro.props;
const id = FLAGS[code] ? `flag-${code}` : "flag-fallback";
---

<svg
  class:list={["flag", extra]}
  viewBox="0 0 20 14"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <use href={`#${id}`}></use>
</svg>
