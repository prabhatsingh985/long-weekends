---
/**
 * A small country flag, drawn rather than typed.
 *
 * The regions used to be the flag emoji 🇮🇳 / 🇺🇸, which is a pair of Regional
 * Indicator letters that the font is expected to fuse into one glyph. Windows
 * never has: Segoe UI Emoji ships no flag glyphs, so Chrome and Edge on Windows
 * fall back to drawing the letters themselves and the region menu rendered as
 * bare "IN" and "US" tiles that looked like broken images. Roughly half the
 * audience for a work-holiday planner is on Windows, so the emoji was never a
 * safe way to say this.
 *
 * An inline SVG renders identically everywhere and stays crisp at any zoom.
 * Deliberately simplified for the size it is drawn at — the chakra is a ring
 * rather than 24 spokes, and the US canton carries no stars, because at 20px
 * wide both would collapse into mud.
 */
interface Props {
  code: "IN" | "US";
  /** Extra classes for sizing in context. */
  class?: string;
}

const { code, class: extra = "" } = Astro.props;

/** 13 bands, odd ones red. Height 14 / 13 = 1.0769. */
const STRIPE = 14 / 13;
const redStripes = Array.from({ length: 13 }, (_, i) => i).filter((i) => i % 2 === 0);
---

{/* Decorative in every current usage: the flag always sits beside its own
    text label, so naming it here would make a menu item announce as
    "India Pan-India IT Gazetted public…". */}
{
  code === "IN" ? (
    <svg class:list={["flag", extra]} viewBox="0 0 20 14" aria-hidden="true">
      <rect width="20" height="14" fill="#ff9933" />
      <rect y="4.667" width="20" height="4.666" fill="#ffffff" />
      <rect y="9.333" width="20" height="4.667" fill="#138808" />
      <circle
        cx="10"
        cy="7"
        r="1.7"
        fill="none"
        stroke="#0a3d91"
        stroke-width="0.5"
      />
      <circle cx="10" cy="7" r="0.4" fill="#0a3d91" />
    </svg>
  ) : (
    <svg class:list={["flag", extra]} viewBox="0 0 20 14" aria-hidden="true">
      <rect width="20" height="14" fill="#ffffff" />
      {redStripes.map((i) => (
        <rect y={i * STRIPE} width="20" height={STRIPE} fill="#b22234" />
      ))}
      <rect width="8.4" height={STRIPE * 7} fill="#3c3b6e" />
    </svg>
  )
}
