---
/**
 * Site footer.
 *
 * The previous version computed a `description` variable that was never
 * rendered, and whose else-branch was the literal string "{description}".
 * Removed rather than wired up — the footer has no place for it.
 */
const year = new Date().getFullYear();

const countries = [
  { href: "/?region=ALL", flag: "🇮🇳", label: "India (public & corporate)" },
  { href: "/?region=USA", flag: "🇺🇸", label: "United States (federal)" },
];

const leaveMath = [
  { href: "/?leaves=0", label: "0 leaves — free 3-day breaks" },
  { href: "/?leaves=1", label: "1 leave — 4-day bridges" },
  { href: "/?leaves=2", label: "2 leaves — 5–6 day trips" },
  { href: "/?month=10", label: "Diwali & Durga Puja runs" },
];
---

<footer class="mt-20 border-t border-hairline bg-surface-soft">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 py-14">
    <div class="flex flex-col md:flex-row justify-between gap-12">
      <div class="md:max-w-sm">
        <div class="flex items-center gap-2.5 mb-4">
          <span
            class="w-8 h-8 rounded-[0.5rem] bg-brand text-white flex items-center justify-center font-mono font-extrabold text-xs"
            aria-hidden="true">LW</span
          >
          <span class="font-extrabold text-base tracking-tight text-ink"
            >The Long Weekends</span
          >
        </div>
        <p class="text-[0.8125rem] text-body leading-relaxed">
          Your leave balance is finite. Public holidays are not. We line the two
          up so you spend the fewest days for the longest break.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-10 sm:gap-14">
        <nav aria-labelledby="ft-countries">
          <h2
            id="ft-countries"
            class="font-mono text-[0.625rem] font-bold text-ink uppercase tracking-widest mb-4"
          >
            Calendars
          </h2>
          <ul class="space-y-2.5 list-none p-0 m-0">
            {
              countries.map((c) => (
                <li>
                  <a
                    href={c.href}
                    class="footer-filter-link text-[0.8125rem] text-body hover:text-ink transition-colors no-underline"
                  >
                    <span aria-hidden="true">{c.flag}</span> {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="ft-math">
          <h2
            id="ft-math"
            class="font-mono text-[0.625rem] font-bold text-ink uppercase tracking-widest mb-4"
          >
            Leave math
          </h2>
          <ul class="space-y-2.5 list-none p-0 m-0">
            {
              leaveMath.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="footer-filter-link text-[0.8125rem] text-body hover:text-ink transition-colors no-underline"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="ft-tools">
          <h2
            id="ft-tools"
            class="font-mono text-[0.625rem] font-bold text-ink uppercase tracking-widest mb-4"
          >
            Tools
          </h2>
          <ul class="space-y-2.5 list-none p-0 m-0">
            <li>
              <a
                href="/company-optimizer"
                class="text-[0.8125rem] text-body hover:text-ink transition-colors no-underline"
                >Office holiday optimizer</a
              >
            </li>
            <li>
              <a
                href="mailto:hello@thelongweekends.com"
                class="text-[0.8125rem] text-body hover:text-ink transition-colors no-underline"
                >hello@thelongweekends.com</a
              >
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <div
      class="mt-12 pt-6 border-t border-hairline flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
    >
      <p class="text-xs text-muted m-0">
        © {year} The Long Weekends · Holiday dates cross-checked against DoPT
        and RBI gazette notifications.
      </p>
      <p class="text-xs text-muted m-0">
        Runs entirely in your browser. Nothing is uploaded.
      </p>
    </div>
  </div>
</footer>
