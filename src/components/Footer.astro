---
const pathname = Astro.url.pathname;
const isCompanyOptimizer = pathname.includes('company-optimizer');
---
<footer class="bg-white border-t border-[#EBEBEB] mt-8">
  <div class="max-w-[1760px] mx-auto px-4 sm:px-6 lg:px-10">
    
    <!-- Main Footer Content -->
    <div class="py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-gradient-to-br from-[#FF385C] to-[#E31C5F] rounded-lg flex items-center justify-center">
            <span class="text-white font-extrabold text-xs">LW</span>
          </div>
          <span class="font-extrabold text-[15px] text-[#222222]">The Long Weekends</span>
        </div>
        <p class="text-[13px] text-[#717171] leading-relaxed max-w-[280px]">
          Find the best long weekends in 2026. Take fewer leaves, travel more.
        </p>
      </div>

      <!-- Popular Regions -->
      <div>
        <h4 class="text-[11px] font-bold text-[#222222] uppercase tracking-wider mb-4">Regions</h4>
        <ul class="space-y-2.5">
          <li><a href="/?region=ALL" class="text-[13px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">Pan-India IT</a></li>
          <li><a href="/?region=SOUTH" class="text-[13px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">South India</a></li>
          <li><a href="/?region=WEST" class="text-[13px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">West India</a></li>
          <li><a href="/?region=NORTH" class="text-[13px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">North India</a></li>
        </ul>
      </div>

      <!-- Leave Budgets -->
      <div>
        <h4 class="text-[11px] font-bold text-[#222222] uppercase tracking-wider mb-4">Leave Plans</h4>
        <ul class="space-y-2.5">
          <li><a href="/?leaves=0" class="text-[13px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">0 Leaves (Free Breaks)</a></li>
          <li><a href="/?leaves=1" class="text-[13px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">1 Leave (Smart Bridge)</a></li>
          <li><a href="/?leaves=2" class="text-[13px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">2 Leaves (Mega Vacation)</a></li>
          <li><a href="/company-optimizer" class="text-[13px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">Custom Company Planner</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-[11px] font-bold text-[#222222] uppercase tracking-wider mb-4">Support</h4>
        <ul class="space-y-2.5">
          <li><a href="mailto:hello@thelongweekends.com" class="text-[13px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">hello@thelongweekends.com</a></li>
          <li><a href="/" class="text-[13px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">thelongweekends.com</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="py-6 border-t border-[#EBEBEB] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <span class="text-[12px] text-[#717171]">&copy; 2026 The Long Weekends</span>
        <span class="text-[12px] text-[#B0B0B0]">·</span>
        <span class="text-[12px] text-[#717171]">Verified with DoPT & RBI Gazettes</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/" class="text-[12px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">Privacy</a>
        <a href="/" class="text-[12px] text-[#717171] hover:text-[#222222] hover:underline transition-colors">Terms</a>
      </div>
    </div>

  </div>
</footer>
