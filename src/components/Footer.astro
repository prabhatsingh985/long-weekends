---
const pathname = Astro.url.pathname;
const isCompanyOptimizer = pathname.includes('company-optimizer');

const description = isCompanyOptimizer
  ? "Upload your office holiday list to discover guaranteed long weekends tailored specifically for your company."
  : "{description}";
---
<footer class="bg-white border-t border-zinc-200 py-16 px-4 sm:px-6 mt-16">
  <div class="max-w-[1200px] mx-auto flex flex-col md:flex-row justify-between gap-12 mb-8">
    <div class="md:w-1/3">
      <div class="font-extrabold text-xl text-slate-900 dark:text-slate-100 tracking-tight mb-3 font-sans">The Long Weekends</div>
      <p class="text-[13px] text-slate-600 dark:text-slate-400 font-medium leading-relaxed mb-4 max-w-sm">
        Escape the daily grind without emptying your leave balance. We automatically turn regular weekends and public holidays into guilt-free mini vacations.
      </p>
      <a href="/" class="text-sm font-semibold text-zinc-900 hover:text-zinc-600 transition-colors">thelongweekends.com</a>
    </div>

    <div class="flex flex-col sm:flex-row gap-12 md:gap-24">
      <div>
        <h4 class="text-[11px] font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-4">Supported Countries</h4>
        <ul class="space-y-3">
          <li><a href="/?region=ALL" class="footer-filter-link text-[13px] text-slate-600 dark:text-slate-400 font-medium hover:text-slate-900 dark:hover:text-slate-100 transition-colors">🇮🇳 India (Public & Corporate)</a></li>
          <li><a href="/?region=USA" class="footer-filter-link text-[13px] text-slate-600 dark:text-slate-400 font-medium hover:text-slate-900 dark:hover:text-slate-100 transition-colors">🇺🇸 United States (US Federal)</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-[11px] font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-4">Leave Math</h4>
        <ul class="space-y-3">
          <li><a href="/?leaves=0" class="footer-filter-link text-[13px] text-slate-600 dark:text-slate-400 font-medium hover:text-slate-900 dark:hover:text-slate-100 transition-colors">0 Leaves (Free 3-Day Breaks)</a></li>
          <li><a href="/?leaves=1" class="footer-filter-link text-[13px] text-slate-600 dark:text-slate-400 font-medium hover:text-slate-900 dark:hover:text-slate-100 transition-colors">1 Leave (Smart 4-Day Bridge)</a></li>
          <li><a href="/?leaves=2" class="footer-filter-link text-[13px] text-slate-600 dark:text-slate-400 font-medium hover:text-slate-900 dark:hover:text-slate-100 transition-colors">2 Leaves (5-6 Day Vacations)</a></li>
          <li><a href="/?month=10" class="footer-filter-link text-[13px] text-slate-600 dark:text-slate-400 font-medium hover:text-slate-900 dark:hover:text-slate-100 transition-colors">Diwali & Durga Puja Hacks</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-[11px] font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-4">Reach Out</h4>
        <ul class="space-y-3">
          <li><a href="mailto:hello@thelongweekends.com" class="text-[13px] text-slate-600 dark:text-slate-400 font-medium hover:text-slate-900 dark:hover:text-slate-100 transition-colors">hello@thelongweekends.com</a></li>
          <li class="pt-4"><p class="text-xs text-zinc-400 leading-relaxed max-w-[200px]">© 2026 The Long Weekends.<br/>Verified with DoPT & RBI Gazettes.</p></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
