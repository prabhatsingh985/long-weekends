---
/**
 * Site footer.
 *
 * The previous version computed a `description` variable that was never
 * rendered, and whose else-branch was the literal string "{description}".
 * Removed rather than wired up — the footer has no place for it.
 */
import Flag from "./Flag.astro";

const year = new Date().getFullYear();

const countries = [
  { href: "/?region=ALL", code: "IN" as const, label: "India (public & corporate)" },
  { href: "/?region=USA", code: "US" as const, label: "United States (federal)" },
];

/**
 * Each label is a promise about what the link returns, so each one is checked
 * against the solver rather than written from memory.
 *
 * The fourth entry used to read "Diwali & Durga Puja runs" and point at
 * `/?month=10`. Diwali 2026 falls on 8 November, so the month was wrong; Durga
 * Puja is a West-Bengal-only holiday that the region selector cannot even
 * reach, so the second festival was unreachable at any budget. Landing on the
 * default zero-leave budget, that link returned a single card — Mahatma
 * Gandhi's Birthday — under a heading naming two festivals it did not contain.
 *
 * It now carries the budget as well as the month, because Diwali falls on a
 * Sunday in 2026 and costs a leave day to be worth anything at all.
 */
const leaveMath = [
  { href: "/?leaves=0", label: "0 leaves — free 3-day breaks" },
  { href: "/?leaves=1", label: "1 leave — 4-day bridges" },
  { href: "/?leaves=2", label: "2 leaves — 5–6 day trips" },
  { href: "/?month=11&leaves=1", label: "Diwali week — 1 leave" },
];

/**
 * The document pages' only inbound links, anywhere on the site.
 *
 * They were in the sitemap and reachable by URL, but nothing linked to them, so
 * every one was an orphan: a page Google is asked to index and given no reason
 * to trust. outputs/sitemap.test.ts fails the sweep if a sitemap entry has no
 * link here, which is why this list and that file have to be edited together.
 *
 * These sat in the bottom bar first, as a wrapped row of `text-xs text-muted`
 * beside the copyright. That was a real miss: at 12px in the muted tone, below a
 * divider, next to a © line, they read as legal fine-print rather than
 * navigation — and the fine-print band is the one part of a footer people's eyes
 * skip. Promoted to a fourth titled column so they sit at the same weight as
 * Calendars, Leave math and Tools, which is what they are.
 *
 * The error pages are deliberately absent. /404 and /500 are `noindex` and are
 * not in the sitemap, so linking them from every page on the site would point
 * crawlers at pages we have asked them to drop, and no visitor ever wants to go
 * to one on purpose. They are reachable at their URLs for checking the design.
 */
const siteLinks = [
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
  { href: "/privacy", label: "Privacy policy" },
  { href: "/terms", label: "Terms & conditions" },
];
---

<footer class="mt-14 sm:mt-20 border-t border-hairline bg-surface-soft">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <div class="flex flex-col md:flex-row justify-between gap-10 md:gap-12">
      <div class="md:max-w-sm">
        <div class="flex items-center gap-2.5 mb-4">
          <span
            class="w-8 h-8 rounded-[0.5rem] bg-brand text-white flex items-center justify-center font-mono font-extrabold text-xs"
            aria-hidden="true">LW</span
          >
          <span class="font-extrabold text-base tracking-tight text-ink"
            >The Long Weekends</span
          >
        </div>
        <p class="text-[0.8125rem] text-body leading-relaxed">
          Your leave balance is finite. Public holidays are not. We line the two
          up so you spend the fewest days for the longest break.
        </p>
      </div>

      {/* Four columns, but only above lg. gap-10 at 320px left ~124px per column,
          which is not enough for "India (public & corporate)" to break cleanly,
          so phones stay at two tracks with a tighter gutter — four items now fill
          exactly two rows there instead of leaving an orphan.

          The jump to four is held back to lg rather than sm because between them
          the brand block is already beside this grid at md:max-w-sm, leaving the
          nav roughly 300px: four tracks of 75px would break every label. */}
      <div
        class="grid grid-cols-2 gap-x-6 gap-y-9 sm:gap-x-10 lg:grid-cols-4 lg:gap-x-8 xl:gap-x-12"
      >
        <nav aria-labelledby="ft-countries">
          <h2
            id="ft-countries"
            class="font-mono text-[0.625rem] font-bold text-ink uppercase tracking-widest mb-4"
          >
            Calendars
          </h2>
          <ul class="space-y-2.5 list-none p-0 m-0">
            {
              countries.map((c) => (
                <li>
                  <a
                    href={c.href}
                    class="footer-filter-link inline-flex items-center gap-2 py-1 -my-1 text-[0.8125rem] text-body hover:text-ink transition-colors no-underline"
                  >
                    <Flag code={c.code} class="shrink-0" />
                    <span>{c.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="ft-math">
          <h2
            id="ft-math"
            class="font-mono text-[0.625rem] font-bold text-ink uppercase tracking-widest mb-4"
          >
            Leave math
          </h2>
          <ul class="space-y-2.5 list-none p-0 m-0">
            {
              leaveMath.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="footer-filter-link inline-block py-1 -my-1 text-[0.8125rem] text-body hover:text-ink transition-colors no-underline"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="ft-tools">
          <h2
            id="ft-tools"
            class="font-mono text-[0.625rem] font-bold text-ink uppercase tracking-widest mb-4"
          >
            Tools
          </h2>
          <ul class="space-y-2.5 list-none p-0 m-0">
            <li>
              <a
                href="/company-optimizer"
                class="inline-block py-1 -my-1 text-[0.8125rem] text-body hover:text-ink transition-colors no-underline"
                >Office holiday optimizer</a
              >
            </li>
            <li>
              {/* An email address has no spaces to break at, so in a ~124px
                  column it would run past its grid track and give the page a
                  horizontal scrollbar. break-words lets it split instead. */}
              <a
                href="mailto:hello@thelongweekends.com"
                class="block break-words py-1 -my-1 text-[0.8125rem] text-body hover:text-ink transition-colors no-underline"
                >hello@thelongweekends.com</a
              >
            </li>
          </ul>
        </nav>

        <nav aria-labelledby="ft-site">
          <h2
            id="ft-site"
            class="font-mono text-[0.625rem] font-bold text-ink uppercase tracking-widest mb-4"
          >
            Site
          </h2>
          <ul class="space-y-2.5 list-none p-0 m-0">
            {
              siteLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="inline-block py-1 -my-1 text-[0.8125rem] text-body hover:text-ink transition-colors no-underline"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    {/* Just the two attribution lines now. The site links used to be duplicated
        here as well; one canonical place for a link is enough, and repeating them
        immediately below the column that now holds them was noise. */}
    <div class="mt-12 border-t border-hairline pt-6">
      <div
        class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center"
      >
        <p class="text-xs text-muted m-0">
          © {year} The Long Weekends · Holiday dates cross-checked against DoPT
          and RBI gazette notifications.
        </p>
        <p class="text-xs text-muted m-0">
          Runs entirely in your browser. Nothing is uploaded.
        </p>
      </div>
    </div>
  </div>
</footer>
