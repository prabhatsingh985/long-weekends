---
/**
 * The single shared document shell.
 *
 * Both pages previously inlined their own <html>, font links and theme-init
 * script — byte-identical copies that had already drifted apart. Everything
 * document-level now lives here.
 */
import "../styles/global.css";
/**
 * The flag artwork, defined once per page as `<symbol>`s.
 *
 * It lives in the layout rather than in the picker because the picker is
 * rendered three times on the homepage and the artwork only needs to exist
 * once. Every `<Flag>` anywhere on the page is a `<use>` pointing here.
 */
import FlagSprite from "../components/FlagSprite.astro";

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/company-optimizer". Joined onto the canonical origin. */
  path?: string;
  /**
   * Keep this page out of search results.
   *
   * Only the error pages set it. A static build writes 404.html as a real file
   * at its own URL, so /404 answers with a 200 and is genuinely indexable.
   * robots.txt deliberately does not block it either: a crawler forbidden from
   * fetching a URL never reads the noindex on it, so the URL can still be
   * indexed — with no snippet and no way to request removal. Crawling has to be
   * allowed for a noindex to be seen.
   */
  noindex?: boolean;
  /**
   * Third-party libraries a page needs as globals.
   *
   * This used to be `string[]` and rendered a bare `<script src>`: no
   * `integrity`, no `crossorigin`, and one of the two URLs carried a floating
   * major version. That combination means the CDN — not this repository —
   * decides what code runs, on the one page that reads the visitor's uploaded
   * documents. A compromised or merely re-published bundle would have executed
   * with no signal at all.
   *
   * `integrity` is therefore not optional in the type. A hash that cannot be
   * omitted is the only version of this rule that survives the next person
   * adding a script in a hurry.
   */
  vendorScripts?: VendorScript[];
}

export interface VendorScript {
  /** Absolute URL, pinned to an exact version — never a range or a dist-tag. */
  src: string;
  /** Subresource Integrity hash, e.g. "sha384-…". Regenerate if `src` changes. */
  integrity: string;
}

const { title, description, path = "/", noindex = false, vendorScripts = [] } =
  Astro.props;

/**
 * One origin for the whole site, taken from astro.config.mjs.
 *
 * The origin used to be a `const SITE = "..."` literal right here, duplicating
 * the one in the config — and the two had already drifted to different domains,
 * so the canonical tags and the sitemap were naming different sites. Reading
 * `Astro.site` removes the second copy: the canonicals, the OG tags and the
 * sitemap endpoint now cannot disagree, and a config with no `site` throws here
 * at build time instead of quietly shipping relative canonicals.
 */
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;

/**
 * Alt text for the share card, describing what the card says rather than what
 * it depicts — a screen reader hearing a link preview needs the claim, not
 * "two flags on a dark background".
 *
 * It is a constant, not a prop: the card is one static file for the whole
 * site, so a per-page alt would describe an image that does not change.
 */
const OG_IMAGE_ALT =
  "The Long Weekends — every long weekend in 2026 and 2027 for India and the United States, with the exact leaves to book for each one.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- No maximum-scale / user-scalable=no: blocking pinch-zoom fails
         WCAG 1.4.4 and the old Layout.astro did exactly that. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Icon set, generated from the site's own LW mark by
        scripts/make-favicons.py. public/favicon.svg used to be Astro's stock
        logo, which is the file every modern browser reaches for first — so the
        tab showed the framework's mark while the navbar showed ours.

        Order matters for the two rel="icon" lines: a browser takes the first
        icon it understands and ignores the rest, so the SVG must lead. Safari
        before 17 and every Windows shell surface need the .ico, and Chrome on
        Android reaches for a mid-size PNG. Listing all three costs one request
        at most, because only the winner is fetched.

        The .ico carries 16, 32 and 48. rel="shortcut icon" is legacy —
        "shortcut" was never a real link type — but IE-era code paths and some
        feed readers still look for it, and it is the one spelling no modern
        browser misparses. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    {/* iOS ignores the manifest and the rel="icon" links entirely when a page is
        added to the home screen; this is the only icon it reads. It is
        full-bleed rather than a rounded tile because iOS composites onto an
        opaque backdrop and applies its own squircle, so transparent corners
        come back as a halo. */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Long Weekends" />

    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Long Weekends" />
    {/* The dimensions are declared so a scraper can reserve the right box
        before it has finished fetching the image — without them Facebook and
        LinkedIn draw a small thumbnail on the first share of a URL and only
        upgrade to the large card once their crawler catches up, which is the
        one impression that matters. They must match what
        scripts/make-og-image.mjs writes. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    <!-- Paints the correct theme colour in browser UI before first paint. -->
    <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0e" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Playfair Display was requested on every page and never used; dropping
         it removes a font family from the critical path. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    {/* `crossorigin` is required for `integrity` to be checked at all — without
        it the response is opaque and the browser silently skips verification,
        which is the failure mode that looks exactly like success.

        `defer` because these blocked the parser before, on the heaviest page on
        the site: ~390KB of library ahead of first paint. Deferred classic
        scripts still run in document order and still finish before
        DOMContentLoaded, so they are ready by the time the page script's init()
        needs them — and company-optimizer.astro no longer configures the pdf.js
        worker at module scope, so it does not depend on that ordering either. */}
    {
      vendorScripts.map((s) => (
        <script
          is:inline
          src={s.src}
          integrity={s.integrity}
          crossorigin="anonymous"
          defer
        />
      ))
    }

    {/* Google Analytics 4.
        --------------------------------------------------------------------
        `is:inline` on both tags is required, not stylistic. Without it Astro
        collects the script, bundles it and rewrites the src — which breaks the
        async loader gtag.js expects and detaches it from the inline snippet
        that configures it. Third-party tags always ship verbatim.

        This is the first thing on the site that sets a cookie or sends a
        request describing the visitor rather than fetching an asset. GA4 writes
        `_ga` and `_ga_BR986NK1GM`, and reports each page view to Google with
        the IP-derived location, device and referrer that any analytics product
        collects.

        That mattered enough to be worth saying twice, because
        src/pages/privacy.astro used to state the opposite in as many words —
        "no Google Analytics, no tag manager" — and its own header comment warns
        that the page is wrong the moment a script is added. It was rewritten in
        the same commit as this tag. If this ID is ever removed, or a second
        third-party script is added, that page has to move with it. */}
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-BR986NK1GM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-BR986NK1GM");
    </script>

    <!--
      Theme resolution must run before first paint, otherwise a dark-mode user
      sees a white flash. Kept inline and synchronous on purpose.
    -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var dark =
            saved === "dark" ||
            (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {
          /* private mode / storage disabled — fall through to light */
        }
      })();
    </script>

    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col">
    {/* First in the body so every `<use>` after it resolves against a symbol
        that is already parsed. */}
    <FlagSprite />
    <a class="skip-link" href="#main">Skip to results</a>
    <slot />
  </body>
</html>
